const inventorySource = ['model', 'transfers', 'display', 'panel']
  .map(name => readFileSync(resolve(root, 'inventory', name + '.js'), 'utf8')).join('\n');
function functionSource(name) {
  const start = inventorySource.indexOf('function ' + name + '('); assert.ok(start >= 0, name);
  let parens = 0, paramsEnd = inventorySource.indexOf('(', start);
  do { if (inventorySource[paramsEnd] === '(') parens++; if (inventorySource[paramsEnd] === ')') parens--; paramsEnd++; } while (parens);
  let depth = 0, opened = false, end = inventorySource.indexOf('{', paramsEnd);
  for (; end < inventorySource.length; end++) {
    if (inventorySource[end] === '{') { depth++; opened = true; }
    if (inventorySource[end] === '}' && --depth === 0 && opened) break;
  }
  return inventorySource.slice(start, end + 1).replace(/inventoryRuntime\./g, '');
}
