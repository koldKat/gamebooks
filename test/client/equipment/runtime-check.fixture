      if (enabled) this.classes.add(c); else this.classes.delete(c); return enabled;
    } };
  }
  set id(value) { this._id = value; ids.set(value, this); } get id() { return this._id || ''; }
  set className(value) { this.classes = new Set(value.split(/\s+/).filter(Boolean)); } get className() { return [...this.classes].join(' '); }
  set textContent(value) { this.text = String(value); } get textContent() { return this.text + this.children.map(c => c.textContent).join(''); }
  appendChild(el) { this.children.push(el); el.parentNode = this; return el; }
  remove() {
    this.parentNode.children = this.parentNode.children.filter(c => c !== this);
    for (const el of [this, ...this.all()]) if (el.id && ids.get(el.id) === el) ids.delete(el.id);
  }
  set innerHTML(html) {
    for (const el of this.all()) if (el.id && ids.get(el.id) === el) ids.delete(el.id);
    this.html = html; this.children = []; this.text = '';
    const stack = [this];
    for (const match of html.matchAll(/<\/?([a-z][\w-]*)\b([^>]*)>|([^<]+)/gi)) {
      if (match[3]) { stack.at(-1).text += match[3]; continue; }
      if (match[0].startsWith('</')) { if (stack.length > 1) stack.pop(); continue; }
      const node = new Element(match[1]);
      for (const attr of match[2].matchAll(/([\w-]+)="([^"]*)"/g)) {
        if (attr[1] === 'id') node.id = attr[2];
        else if (attr[1] === 'class') node.className = attr[2];
        else if (attr[1].startsWith('data-')) node.dataset[attr[1].slice(5).replace(/-([a-z])/g, (_, c) => c.toUpperCase())] = attr[2];
      }
      stack.at(-1).appendChild(node);
      if (!/\/$/.test(match[2]) && !['input', 'br', 'hr', 'img'].includes(match[1])) stack.push(node);
    }
  }
  get innerHTML() { return this.html || ''; }
  all() { return this.children.flatMap(c => [c, ...c.all()]); }
  matches(selector) {
    if (selector.startsWith('.')) return this.classes.has(selector.slice(1));
    if (selector.startsWith('#')) return this.id === selector.slice(1);
    const data = selector.match(/^\[data-([\w-]+)(?:="([^"]*)")?\]$/);
    if (data) { const key = data[1].replace(/-([a-z])/g, (_, c) => c.toUpperCase()); return key in this.dataset && (data[2] === undefined || this.dataset[key] === data[2]); }
    return false;
  }
  closest(selector) { return this.matches(selector) ? this : this.parentNode?.closest(selector) || null; }
  contains(target) { return target === this || this.all().includes(target); }
  querySelectorAll(selector) { return this.all().filter(el => el.matches(selector)); }
  querySelector(selector) { return this.querySelectorAll(selector)[0] || null; }
  addEventListener(type, fn) { const list = this.listeners.get(type) || []; list.push(fn); this.listeners.set(type, list); }
  dispatch(type, extra = {}) { for (const fn of [...(this.listeners.get(type) || [])]) fn({ target: this, stopPropagation() {}, preventDefault() {}, ...extra }); }
  click() { this.dispatch('click'); }
  focus() {} select() {}
  getBoundingClientRect() { return { width: 196, height: 120, right: 196, bottom: 120 }; }
}
