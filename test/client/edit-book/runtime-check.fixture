if (existsSync(resolve(root, 'edit-book'))) for (const name of readdirSync(resolve(root, 'edit-book')).filter(n => n.endsWith('.js'))) sources.set(resolve(root, 'edit-book', name), readFileSync(resolve(root, 'edit-book', name), 'utf8'));
const external = new Map();
for (const [path, source] of sources) for (const match of source.matchAll(/import \{([^}]+)\} from '([^']+)';/g)) {
  const target = resolve(dirname(path), match[2]); if (sources.has(target)) continue;
  const names = external.get(target) || new Set();
