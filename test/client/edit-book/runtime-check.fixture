const context = createContext({ document: { getElementById: el, createElement: () => new Element() }, window: { dispatchEvent: event => calls.push(['event', event.type]) }, Event: class { constructor(type) { this.type = type; } }, XMLHttpRequest: XHR, setTimeout: fn => timers.push(fn), console });
sources.set(resolve(root, 'edit-book.js'), readFileSync(resolve(root, 'edit-book.js'), 'utf8'));
