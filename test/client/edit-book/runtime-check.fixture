  el(`${prefix}-pdf-file`).files = [pdf]; await el(`${prefix}-pdf-file`).emit('change');
  const pendingSave = el(`${prefix}-save`).emit('click'); await Promise.resolve();
  const oldUpload = uploads.at(-1);
