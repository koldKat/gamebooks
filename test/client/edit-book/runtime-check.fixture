  oldUpload.finish(200, { pdfUrl: '/books/original.pdf' }); await pendingSave;
  assert.equal(raceSaves.length, 0, 'old upload must not save replacement dialog metadata');
  assert.ok(el(overlay).classList.contains('active'), 'old upload must not close replacement dialog');
  assert.equal(el(`${prefix}-save`).disabled, false);
