const fs = require('node:fs');
const path = require('node:path');
const assert = require('node:assert/strict');
const vm = require('node:vm');
const browser = require('./battlesim/browser-harness.cjs');
const Database = require('better-sqlite3');
const { getRatingStats } = require('../../server/db/rating-stats');

(async () => {
  const root = process.env.STATS_SCRATCH;
  assert.ok(root && root.startsWith('/media/koldKat/MediaDrive/.tmp/'));
  const countSource = fs.readFileSync('public/js/core/format-stat-count.js', 'utf8').replace(/^export /gm, '');
  const source = countSource + '\n' + fs.readFileSync('public/js/stats.js', 'utf8')
    .replace(/^import .*;$/gm, '').replace(/^export /gm, '');
  const messages = vm.runInNewContext(fs.readFileSync('public/js/i18n/en/stats.js', 'utf8')
    .replace('export default', '(').replace(/;\s*$/, ')'));
  const response = await fetch('http://127.0.0.1:3000/api/site-stats');
  assert.equal(response.status, 200);
  const stats = await response.json();
  const imagePolicy = response.headers.get('content-security-policy')?.split(';').find(rule=>rule.trim().startsWith('img-src')) || '';
  assert.ok(imagePolicy.includes('https://flagcdn.com'), 'live image policy permits the flag host');
  const db = new Database('database.sqlite', { readonly: true });
  Object.assign(stats, getRatingStats(db));
  db.close();
  const css = ['base/app', 'components/feedback', 'layouts/responsive', 'components/feed', 'components/tooltip'].map(name =>
    fs.readFileSync(`public/css/${name}.css`, 'utf8')).join('\n');
  const html = `<!doctype html><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="${imagePolicy}"><style>${css}</style>
    <div id="stats-modal-overlay"><div id="stats-modal"><div id="stats-modal-header">
    <span id="stats-modal-title">Stats for Nerds</span><button id="stats-modal-close">X</button>
    </div><div id="stats-modal-body"></div></div></div>
    <script type="module">
    import {bindCountryTooltip} from 'file://${path.resolve('public/js/ui-helpers/country-tooltip.js')}';
    import {initTooltip,dismissTooltip} from 'file://${path.resolve('public/js/ui-helpers/tooltip.js')}';
    const messages = ${JSON.stringify(messages)}, stats = ${JSON.stringify(stats)};
    const t = key => messages[key] || key;
    const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g,
      char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[char]);
    const fetchPublic = async () => ({ok:true,json:async()=>stats});
    const check = (value,message) => { if (!value) throw Error(message); };
    ${source}
    try {
      initTooltip();
      await openStatsModal();
      await document.fonts.ready;
      await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
      const body = document.getElementById('stats-modal-body');
      check(body.querySelectorAll('.stats-section').length === 13, 'all sections rendered');
      const registered = body.querySelector('.stats-section--players #stats-registered-users');
      check(registered && registered.textContent === String(stats.users), 'registered total has the country tooltip');
      check(getComputedStyle(registered).borderBottomStyle === 'dotted', 'registered total has dotted underline');
      registered.dispatchEvent(new MouseEvent('mouseover', {bubbles:true}));
      const countryRows = [...document.querySelectorAll('#app-tooltip .tooltip-country-row')];
      const countryNames = countryRows.map(row=>row.children[1].textContent);
      check(countryNames.length > 0 && countryNames.join('|') === [...countryNames].sort((a,b)=>a.localeCompare(b,'en')).join('|'), 'countries alphabetical');
      check(countryRows.reduce((sum,row)=>sum+Number(row.children[2].textContent.replaceAll(',','')),0) === stats.users, 'country totals add up');
      check([...document.querySelectorAll('#app-tooltip img')].every(img=>img.src.startsWith('https://flagcdn.com/w20/') && img.src.endsWith('.png')), 'admin flag images');
      await Promise.all([...document.querySelectorAll('#app-tooltip img')].map(img=>new Promise((resolve,reject)=>{
        const timeout=setTimeout(()=>reject(Error('Flag load timed out: '+img.src)),10000);
        const done=()=>{clearTimeout(timeout);img.naturalWidth>0?resolve():reject(Error('Flag missing: '+img.src));};
        if(img.complete)done();else{img.onload=done;img.onerror=done;}
      })));
      registered.click();
      const countryTip = document.getElementById('app-tooltip');
      check(countryTip.style.display === 'block' && registered.getAttribute('aria-expanded') === 'true', 'tap opens country details');
      const bounds = countryTip.getBoundingClientRect();
      check(bounds.left >= 0 && bounds.right <= innerWidth && bounds.top >= 0 && bounds.bottom <= innerHeight, 'tapped country details stay in viewport');
      check(countryTip.scrollWidth <= countryTip.clientWidth + 1, 'country details widen without horizontal scrolling');
      check(getComputedStyle(countryTip).overflow === 'visible', 'country details have no scrollbars');
      for (const row of countryTip.querySelectorAll('.tooltip-country-row')) {
        const name = row.children[1];
        const range = document.createRange();
        range.selectNodeContents(name);
        check(range.getClientRects().length === 1, 'country names stay on one line');
        check(row.children[2].getBoundingClientRect().left >= name.getBoundingClientRect().right, 'country counts do not overlap names');
      }
      countryTip.firstElementChild.click();
      check(countryTip.style.display === 'block', 'interacting with country details keeps them open');
      registered.click();
      check(countryTip.style.display === 'none' && registered.getAttribute('aria-expanded') === 'false', 'second tap closes country details');
      registered.dispatchEvent(new KeyboardEvent('keydown', {key:'Enter',bubbles:true}));
      check(countryTip.style.display === 'block', 'keyboard opens country details');
      registered.dispatchEvent(new KeyboardEvent('keydown', {key:'Escape',bubbles:true}));
      check(countryTip.style.display === 'none', 'Escape dismisses country details');
      check(body.querySelectorAll('.stats-rating-table tbody tr').length === 12, 'all rating rows rendered');
      const cpu = body.querySelector('.stats-cpu-model');
      const cpuRange = document.createRange();
      cpuRange.selectNodeContents(cpu);
      check(cpuRange.getClientRects().length === 1, 'CPU model stays on one line');
      const normalRowHeight = body.querySelector('.stats-section--players .stats-table tr:last-child').getBoundingClientRect().height;
      for (const row of body.querySelectorAll('.stats-rating-table tbody tr:not(.stats-rating-average)')) {
        check(row.getBoundingClientRect().height <= normalRowHeight + 2, 'rating rows match compact stats spacing');
      }
      const labelStyle = getComputedStyle(body.querySelector('.stats-key'));
      const valueStyle = getComputedStyle(body.querySelector('.stats-val'));
      for (const cell of body.querySelectorAll('.stats-rating-table th')) {
        const style = getComputedStyle(cell);
        check(style.fontSize === labelStyle.fontSize && style.fontFamily === labelStyle.fontFamily, 'rating label typography');
      }
      for (const cell of body.querySelectorAll('.stats-rating-table td')) {
        const style = getComputedStyle(cell);
        check(style.fontSize === valueStyle.fontSize && style.fontFamily === valueStyle.fontFamily
          && style.fontWeight === valueStyle.fontWeight, 'rating value typography');
      }
      const ratingColors = [...body.querySelectorAll('.stats-rating-table td[style]')].slice(0, 3)
        .map(cell => getComputedStyle(cell).getPropertyValue('--rating-color').trim());
      check(ratingColors.length === 3 && ratingColors.every(Boolean) && new Set(ratingColors).size === 3, 'distinct category bar colors');
      check(body.scrollWidth <= body.clientWidth + 1, 'no horizontal overflow');
      for (const section of body.querySelectorAll('.stats-section')) {
        check(section.scrollWidth <= section.clientWidth + 1, 'card overflow: '+section.className);
      }
      let maxGap = 0;
      if (innerWidth > 980) {
        check(getComputedStyle(body.querySelector('.stats-layout')).display === 'grid', 'desktop columns');
        for (const column of body.querySelectorAll('.stats-column')) {
          const cards = [...column.children];
          for (let index=1;index<cards.length;index++) {
            maxGap = Math.max(maxGap,cards[index].getBoundingClientRect().top-cards[index-1].getBoundingClientRect().bottom);
          }
        }
        check(maxGap <= 17, 'columns have no stretched row gaps');
        check(body.querySelectorAll('.stats-column')[2].firstElementChild.classList.contains('stats-section--books'), 'books stay on right');
      }
      document.getElementById('stats-modal').style.maxHeight = '360px';
      body.scrollTop = body.scrollHeight;
      check(body.scrollHeight > body.clientHeight && body.scrollTop > 0, 'short screens scroll');
      registered.click();
      closeStatsModal();
      check(countryTip.style.display === 'none', 'closing stats dismisses country details');
      await openStatsModal();
      document.body.dataset.test = JSON.stringify({width:innerWidth,sections:12,ratingRows:12,matchingTypography:true,noOverflow:true,shortScreenScroll:true,maxGap});
    } catch (error) { document.body.dataset.failure = error.stack; }
    </script>`;
  fs.mkdirSync(root, { recursive: true });
  const file = path.join(root, 'stats.html');
  try {
    fs.writeFileSync(file, html);
    for (const width of [1100, 800, 390, 320]) {
      const interact = width > 390 ? undefined : async send => {
        await send('Emulation.setTouchEmulationEnabled', {enabled:true,maxTouchPoints:1});
        let ready = false;
        for (let attempt=0;attempt<200;attempt++) {
          const response = await send('Runtime.evaluate', {expression:'({ready:!!document.body?.dataset.test,failure:document.body?.dataset.failure})',returnByValue:true});
          if (response.result.value?.failure) throw Error(response.result.value.failure);
          if (response.result.value?.ready) { ready=true;break; }
          await new Promise(resolve=>setTimeout(resolve,50));
        }
        assert.ok(ready, 'stats ready for actual mobile touch');
        const position = await send('Runtime.evaluate', {expression:'(()=>{const el=document.getElementById("stats-registered-users");el.scrollIntoView({block:"center"});const r=el.getBoundingClientRect();return {x:r.left+r.width/2,y:r.top+r.height/2};})()',returnByValue:true});
        await new Promise(resolve=>setTimeout(resolve,50));
        const point = position.result.value;
        await send('Input.dispatchTouchEvent', {type:'touchStart',touchPoints:[point]});
        await send('Input.dispatchTouchEvent', {type:'touchEnd',touchPoints:[]});
        await new Promise(resolve=>setTimeout(resolve,100));
        const result = await send('Runtime.evaluate', {expression:'({visible:document.getElementById("app-tooltip").style.display,expanded:document.getElementById("stats-registered-users").getAttribute("aria-expanded")})',returnByValue:true});
        assert.equal(result.result.value.visible, 'block', 'actual touch keeps country list open');
        assert.equal(result.result.value.expanded, 'true');
        await send('Input.dispatchTouchEvent', {type:'touchStart',touchPoints:[{x:8,y:8}]});
        await send('Input.dispatchTouchEvent', {type:'touchEnd',touchPoints:[]});
        await new Promise(resolve=>setTimeout(resolve,100));
        const dismissed = await send('Runtime.evaluate', {expression:'document.getElementById("app-tooltip").style.display',returnByValue:true});
        assert.equal(dismissed.result.value, 'none', 'outside touch dismisses country list');
      };
      console.log(JSON.stringify(await browser({file,root,width,profile:path.join(root,'profile'),chromium:process.env.CHROMIUM,interact})));
    }
  } finally {
    fs.rmSync(root, { recursive: true, force: true });
  }
})().catch(error => { console.error(error); process.exitCode = 1; });
