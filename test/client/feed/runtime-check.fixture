import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { resolve, dirname } from 'node:path';
import { SourceTextModule, SyntheticModule, createContext } from 'node:vm';
import { createHash } from 'node:crypto';

const root = process.argv[1], baseline = process.argv[2];
const modules = new Map(), calls = [], docListeners = new Map(), windowListeners = new Map();
const frames = new Map(), timers = new Map(), observers = [], images = [];
let token = 'account', payload = { entries: [], pinned: null }, fetchImpl = null, timerId = 0;
class Element {
  constructor(dataset = {}) {
    this.dataset = dataset; this.style = {}; this.innerHTML = ''; this.textContent = '';
    this.queries = new Map(); this.listeners = new Map(); this.attrs = new Map();
    this.offsetWidth = 100; this.offsetHeight = 300;
    const classes = new Set();
    this.classList = { contains: k => classes.has(k), add: k => classes.add(k), remove: k => classes.delete(k), toggle: (k, enabled) => enabled ? classes.add(k) : classes.delete(k) };
  }
  querySelectorAll(q) { return this.queries.get(q) || []; }
  get firstChild() { return this.innerHTML ? {} : null; }
  replaceChildren() { this.innerHTML = ''; }
  querySelector(q) {
    if (q === '.feed-entry, #feed-header') return /feed-entry|feed-header/.test(this.innerHTML) ? this : null;
    if (q === '.feed-loading') return this.innerHTML.includes('feed-loading') ? this : null;
    return this.queries.get(q) || null;
  }
  addEventListener(type, fn) { const list = this.listeners.get(type) || []; list.push(fn); this.listeners.set(type, list); }
  removeEventListener(type, fn) { this.listeners.set(type, (this.listeners.get(type) || []).filter(item => item !== fn)); }
  setAttribute(k, v) { this.attrs.set(k, v); }
  getAttribute(k) { return this.attrs.get(k); }
  async emit(type, event = {}) { for (const fn of this.listeners.get(type) || []) await fn({ target: this, currentTarget: this, ...event }); }
}
const feed = new Element(), elements = new Map([['feed-content', feed]]), body = new Element();
for (const id of ['feed-img-preview', 'feed-img-preview-img', 'feed-img-preview-footer', 'feed-img-preview-level', 'feed-img-bar']) elements.set(id, new Element());
const addListener = map => (type, fn) => { const list = map.get(type) || []; list.push(fn); map.set(type, list); };
class FixedDate extends Date { constructor(...args) { super(...(args.length ? args : ['2026-10-02T12:00:00Z'])); } }
class FakeImage {
  constructor() { images.push(this); }
  set src(url) { this.url = url; }
  finish(width = 100, height = 150) { this.naturalWidth = width; this.naturalHeight = height; this.onload(); }
}
const context = createContext({
  console, Date: FixedDate, URL, location: { origin: 'https://example.test' }, Image: FakeImage,
  document: { body, getElementById: id => elements.get(id) || null, querySelector: () => null, addEventListener: addListener(docListeners) },
  window: { innerWidth: 1200, innerHeight: 900, addEventListener: addListener(windowListeners) },
  ResizeObserver: class { constructor(callback) { this.callback = callback; this.cards = new Set(); this.disconnects = 0; observers.push(this); } observe(card) { this.cards.add(card); } disconnect() { this.cards.clear(); this.disconnects++; } },
  setTimeout: fn => { const id = ++timerId; timers.set(id, fn); return id; }, clearTimeout: id => timers.delete(id),
  requestAnimationFrame: fn => { const id = ++timerId; frames.set(id, fn); return id; }, cancelAnimationFrame: id => frames.delete(id),
});
const escapeHtml = value => String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
const t = (key, params = {}) => key + Object.entries(params).map(([k, v]) => `|${k}=${v}`).join('');
const external = {
  'core/state.js': { getToken: () => token, apiFetch: async url => { calls.push(['private', url]); return fetchImpl ? fetchImpl() : { ok: true, json: async () => payload }; } },
  'core/util.js': { escapeHtml }, 'i18n.js': { t },
  // Rendering/wiring fixture; real DOM reconciliation is tested separately in update.test.mjs.
  'feed/update.js': { updateFeedContents: (el, blocks) => {
    el.innerHTML = blocks.map(block => block.html).join('');
    if (!blocks.some(block => block.key.startsWith('day:'))) el.queries.delete('.feed-day-card[data-day-index]');
    return { changed: true, changedRoots: [el], restoreScroll() {} };
  } },
  'account/public-profile.js': Object.fromEntries(['openPublicProfile', 'openPublicRun', 'openPublicSeriesRun'].map(k => [k, (...args) => calls.push([k, ...args])])),
  'covers.js': Object.fromEntries(['openCoverActivity', 'openSeriesActivity'].map(k => [k, (...args) => calls.push([k, ...args])])),
};
for (const [name, values] of Object.entries(external)) modules.set(resolve(root, name), new SyntheticModule(Object.keys(values), function () { for (const [k, v] of Object.entries(values)) this.setExport(k, v); }, { context }));
function moduleAt(path) {
  if (modules.has(path)) return modules.get(path);
  const source = readFileSync(path === resolve(root, 'feed.js') && baseline ? baseline : path, 'utf8');
  const mod = new SourceTextModule(source, { context, identifier: path }); modules.set(path, mod); return mod;
}
const entry = moduleAt(resolve(root, 'feed.js'));
await entry.link((specifier, parent) => moduleAt(resolve(dirname(parent.identifier), specifier)));
await entry.evaluate();
const api = entry.namespace;
assert.deepEqual(Object.keys(api).sort(), ['applyFeedFilterPrefs', 'loadFeed', 'refreshDayCoverFlows', 'refreshFeedFilters', 'setFeedHooks']);
const hooks = {
  publicFetch: async url => { calls.push(['public', url]); return fetchImpl ? fetchImpl() : { ok: true, json: async () => payload }; },
  displayFor: name => `Display ${name}`, adminBadge: () => '[admin]', authorBadge: () => '[author]', contributorBadge: () => '[contributor]', starsHtml: rating => `[stars:${rating}]`,
  registerAuthor: (...args) => calls.push(['author', ...args]), registerContributor: (...args) => calls.push(['contributor', ...args]), scheduleRewardProfileRefresh: delay => calls.push(['reward', delay]),
};
api.setFeedHooks(hooks);
const snapshots = [];
async function snapshot(entries, pinned = null) { payload = { entries, pinned }; await api.loadFeed(); snapshots.push(feed.innerHTML); }
const base = { username: 'A <player>', userId: 7, userPublicProfile: true, userLevel: 5, userTitle: 'Ranger', avatarUrl: '/avatar.jpg', bookId: 1, bookName: 'Book <title>', bookIsPublic: true, coverUrl: '/cover.jpg', parentBookId: 2, parentBookName: 'Anthology', parentBookIsPublic: true, seriesId: 3, seriesName: 'Series', seriesIsPublic: true, seriesNumber: '2', runIndex: 0, runIsPublic: true, completedAt: '2026-10-02T10:00:00Z', pathLength: 10, lastSection: 20, rating: 4, title: 'News', body: '**Bold** [Book](/book/1)', level: 5, levelTitle: 'Ranger' };
const types = ['run_completed', 'book_created', 'book_added', 'series_created', 'series_added', 'series_run_started', 'series_run_completed', 'run_started', 'user_joined', 'level_up', 'all_visited', 'all_discovered', 'first_win', 'first_loss', 'first_battle_death', 'won_all_series', 'won_all_anthology', 'visit_all_series', 'discover_all_series', 'visit_all_anthology', 'discover_all_anthology', 'party_formed', 'book_rated', 'series_rated', 'announcement'];
for (const type of types) await snapshot([{ ...base, type }]);
for (const result of ['success', 'battle', 'death']) await snapshot([{ ...base, type: 'run_completed', result, runIndex: -2 }]);
await snapshot([{ ...base, type: 'book_created', isContainer: true }]);
await snapshot([{ ...base, type: 'book_created', bookIsPublic: false, parentBookIsPublic: false, seriesIsPublic: false }]);
assert.ok(!feed.innerHTML.includes('data-cover='), 'private book does not expose cover');
await snapshot([{ ...base, type: 'run_completed', usernames: [{ username: 'Z', userPublicProfile: true }, { username: 'A', avatarUrl: '/a.jpg', userLevel: 2 }] }]);
await snapshot(Array.from({ length: 6 }, () => ({ ...base, type: 'run_started' })).concat({ ...base, type: 'all_visited' }, { ...base, type: 'book_rated' }));
assert.ok(feed.innerHTML.includes('feed.actions_today|n=6'));
assert.ok(feed.innerHTML.includes('feed.tmpl.all_visited'));
assert.ok(feed.innerHTML.includes('feed.tmpl.rated'));
await snapshot(Array.from({ length: 5 }, (_, i) => ({ ...base, type: 'user_joined', username: `Player${i}` })));
assert.ok(feed.innerHTML.includes('feed.joined_today|n=5'));
await snapshot([{ ...base, type: 'series_created' }, ...Array.from({ length: 3 }, (_, i) => ({ ...base, type: 'book_created', bookId: 10 + i }))]);
assert.ok(feed.innerHTML.includes('feed.books_in_batch|n=3'));
await snapshot(Array.from({ length: 3 }, (_, i) => ({ ...base, type: 'book_created', bookId: 10 + i })));
assert.ok(feed.innerHTML.includes('feed.books_in_batch|n=3'));
await snapshot([{ ...base, type: 'book_created', completedAt: '2026-10-01T10:00:00Z' }, { ...base, type: 'run_started', completedAt: '2026-09-20T10:00:00Z' }], { title: '<Pinned>', body: '*italic* __underline__ ~~strike~~ {color:orange}Warm{/color} [Series](/series/3) [External](https://example.org/)' });
await snapshot([]);
await snapshot([], { title: 'Pinned only', body: 'Text' });
const digest = createHash('sha256').update(JSON.stringify(snapshots)).digest('hex');

if (!baseline) {
  const jobEntry = { ...base, type: 'job_level_up', levelTitle: 'Sifter' };
  const jobHtml = modules.get(resolve(root, 'feed/render.js')).namespace.renderFeedContents([jobEntry], null, '').html;
  assert.ok(jobHtml.includes('feed-entry--joblevel') && jobHtml.includes('Sifter'));
  const filter = modules.get(resolve(root, 'feed/filters.js')).namespace.filterFeedEntries;
  assert.equal(filter([jobEntry, { ...base, type:'level_up' }], new Set(['achievements'])).length, 0);
  assert.equal(filter([jobEntry], new Set(['players','runs'])).length, 1);
  const jobDay = modules.get(resolve(root, 'feed/groups.js')).namespace.createDayRenderer()(
    [...Array.from({length:6}, () => ({...base,type:'run_started'})), jobEntry], 'job-test');
  assert.ok(jobDay.includes('feed-entry--joblevel'), 'Job promotions remain outside collapsed run groups');
  const render = modules.get(resolve(root, 'feed/render.js')).namespace.renderFeedContents;
  const renderDay = modules.get(resolve(root, 'feed/groups.js')).namespace.createDayRenderer();
  const creations = (kind, count, overrides = {}) => Array.from({ length: count }, (_, i) => ({
    ...base, username: 'Creator', parentBookId: null, parentBookName: null,
    seriesId: kind === 'series' ? 3000 + i : null, seriesName: kind === 'series' ? `Series ${i}` : null,
    bookId: (kind === 'anthologies' ? 2000 : 1000) + i, bookName: `${kind} ${i}`,
    type: kind === 'series' ? 'series_created' : 'book_created', isContainer: kind === 'anthologies', ...overrides,
  }));
  const creationGroupCount = html => (html.match(/feed-user-group--created/g) || []).length;
  const oncePerBook = (html, entries) => {
    for (const e of entries.filter(e => e.type === 'book_created')) {
      assert.equal((html.match(new RegExp(`data-book-id="${e.bookId}"`, 'g')) || []).length, 1, `book ${e.bookId} appears once`);
    }
  };
  for (const kind of ['books', 'anthologies', 'series']) {
    assert.equal(creationGroupCount(renderDay(creations(kind, 5), 'today')), 0, `${kind}: five creations stay outside daily groups`);
    const six = renderDay(creations(kind, 6), 'today');
    assert.equal(creationGroupCount(six), 1, `${kind}: six creations collapse`);
    assert.ok(six.includes(`feed.${kind}_created_today|n=6`));
    assert.ok(/aria-expanded="false"/.test(six) && /class="feed-group-body"[^>]* hidden/.test(six));
    assert.equal(creationGroupCount(renderDay([...creations(kind, 3), ...creations(kind, 3, { username: 'Other' })], 'today')), 0, 'counts never combine users');
    const splitDays = [...creations(kind, 3), ...creations(kind, 3, { completedAt: '2026-10-01T10:00:00Z' })];
    assert.equal(creationGroupCount(render(splitDays, null, '').html), 0, 'counts never combine dates');
  }
  const separateTypes = ['books', 'anthologies', 'series'].flatMap(kind => creations(kind, 6));
  const separateOriginal = JSON.stringify(separateTypes);
  const separated = renderDay(separateTypes, 'today');
  assert.equal(creationGroupCount(separated), 3, 'each type gets its own daily container');
  oncePerBook(separated, separateTypes);
  assert.equal(JSON.stringify(separateTypes), separateOriginal, 'grouping never mutates feed payloads');
  assert.equal(creationGroupCount(renderDay(['books', 'anthologies', 'series'].flatMap(kind => creations(kind, 3)), 'today')), 0, 'different types do not contribute to each other’s threshold');
  const sixSeries = creations('series', 6);
  const seriesBooks = creations('books', 6).map((e, i) => ({ ...e, seriesId: sixSeries[i].seriesId, seriesName: sixSeries[i].seriesName }));
  const separatedSeries = renderDay([...sixSeries, ...seriesBooks], 'today');
  assert.equal(creationGroupCount(separatedSeries), 1, 'only series creations get a daily group; their books stay inside each series');
  oncePerBook(separatedSeries, seriesBooks);
  assert.equal((separatedSeries.match(/feed.book_in_batch\|n=1/g) || []).length, 6, 'each series retains its member book');
  assert.ok(!separatedSeries.includes('feed.books_created_today'), 'series members never become standalone daily book creations');
  const sixAnthologies = creations('anthologies', 6);
  const anthologyBooks = creations('books', 5).map((e, i) => ({ ...e, parentBookId: sixAnthologies[i].bookId, parentBookName: sixAnthologies[i].bookName }));
  const nestedAnthologies = renderDay([...sixAnthologies, ...anthologyBooks], 'today');
  assert.equal(creationGroupCount(nestedAnthologies), 1, 'five books do not create a daily book group');
  assert.equal((nestedAnthologies.match(/feed.book_in_batch\|n=1/g) || []).length, 5, 'smaller child batches remain expandable inside grouped anthologies');
  oncePerBook(nestedAnthologies, [...sixAnthologies, ...anthologyBooks]);
  const enoughAnthologyBooks = [...anthologyBooks, { ...creations('books', 6)[5], parentBookId: sixAnthologies[5].bookId, parentBookName: sixAnthologies[5].bookName }];
  const bothAnthologyGroups = renderDay([...sixAnthologies, ...enoughAnthologyBooks], 'today');
  assert.equal(creationGroupCount(bothAnthologyGroups), 1, 'anthology members remain beneath their anthology even at six books');
  assert.equal((bothAnthologyGroups.match(/feed.book_in_batch\|n=1/g) || []).length, 6);
  oncePerBook(bothAnthologyGroups, [...sixAnthologies, ...enoughAnthologyBooks]);
  const oneSeriesManyBooks = creations('books', 8, { seriesId: 44, seriesName: 'Existing series' }).map((e, i) => ({ ...e, bookId: 4000 + i }));
  const keptSeries = renderDay(oneSeriesManyBooks, 'today');
  assert.equal(creationGroupCount(keptSeries), 0, 'books in an existing series keep that series heading');
  assert.ok(keptSeries.includes('feed.tmpl.created_in_series') && keptSeries.includes('feed.books_in_batch|n=8'));
  oncePerBook(keptSeries, oneSeriesManyBooks);
  const oneAnthologyManyBooks = creations('books', 8, { parentBookId: 45, parentBookName: 'Existing anthology' }).map((e, i) => ({ ...e, bookId: 5000 + i }));
  const keptAnthology = renderDay(oneAnthologyManyBooks, 'today');
  assert.equal(creationGroupCount(keptAnthology), 0, 'books in an existing anthology keep that anthology heading');
  assert.ok(keptAnthology.includes('feed.tmpl.created_in_anthology') && keptAnthology.includes('feed.books_in_batch|n=8'));
  oncePerBook(keptAnthology, oneAnthologyManyBooks);
  const fiveStandaloneAndMembers = renderDay([...creations('books', 5), ...oneSeriesManyBooks, ...oneAnthologyManyBooks], 'today');
  assert.equal(creationGroupCount(fiveStandaloneAndMembers), 0, 'member books never push five standalone books over the threshold');
  const sixStandaloneAndMembers = renderDay([...creations('books', 6), ...oneSeriesManyBooks, ...oneAnthologyManyBooks], 'today');
  assert.equal(creationGroupCount(sixStandaloneAndMembers), 1, 'only the six standalone books fold together');
  assert.ok(sixStandaloneAndMembers.includes('feed.books_created_today|n=6'));
  assert.ok(sixStandaloneAndMembers.includes('feed.tmpl.created_in_series') && sixStandaloneAndMembers.includes('feed.tmpl.created_in_anthology'));
  oncePerBook(sixStandaloneAndMembers, [...creations('books', 6), ...oneSeriesManyBooks, ...oneAnthologyManyBooks]);
  const creationAttrs = html => html.match(/data-target="[^"]+" data-group-key="[^"]+"/g);
  assert.deepEqual(creationAttrs(renderDay(creations('books', 7), 'same-day')), creationAttrs(renderDay(creations('books', 6), 'same-day')), 'new creations retain expansion keys');
  const olderCreations = creations('books', 6, { completedAt: '2026-10-01T10:00:00Z' });
  assert.deepEqual(creationAttrs(render([{ ...base, type: 'user_joined' }, ...olderCreations], null, '').html), creationAttrs(render(olderCreations, null, '').html), 'new day does not shift creation container IDs');
  const older = Array.from({ length: 6 }, () => ({ ...base, type: 'run_started', completedAt: '2026-10-01T10:00:00Z' }));
  const before = render(older, null, '').html;
  const after = render([{ ...base, type: 'user_joined' }, ...older], null, '').html;
  const groupAttrs = html => html.match(/data-target="[^"]+" data-group-key="[^"]+"/g);
  assert.deepEqual(groupAttrs(after), groupAttrs(before), 'adding a new day must not shift older group keys or IDs');
  const batch = Array.from({ length: 3 }, (_, i) => ({ ...base, type: 'book_created', bookId: 10 + i }));
  assert.deepEqual(groupAttrs(render([{ ...base, type: 'book_created', bookId: 20 }, ...batch], null, '').html),
    groupAttrs(render(batch, null, '').html), 'new batch head must retain the container expansion key');
  const seriesCreated = { ...base, type: 'series_created', completedAt: '2026-10-01T09:00:00Z' };
  const oldBook = { ...base, type: 'book_created', bookId: 40, bookName: 'Older volume', completedAt: '2026-10-01T10:00:00Z' };
  const newBook = { ...base, type: 'book_created', bookId: 41, bookName: 'New volume', parentBookId: null, parentBookName: null };
  const entries = [newBook, oldBook, seriesCreated];
  const untouched = JSON.stringify(entries);
  const crossDay = render(entries, null, '');
  const today = crossDay.blocks.find(b => b.key === 'day:Fri Oct 02 2026').html;
  const yesterday = crossDay.blocks.find(b => b.key === 'day:Thu Oct 01 2026').html;
  assert.ok(today.includes('feed.tmpl.created_in_series') && today.includes('feed.book_in_batch|n=1'));
  assert.ok(today.includes('data-book-id="41"') && !today.includes('data-book-id="40"'));
  assert.ok(!today.includes('feed.tmpl.created_series'), 'new volume does not announce another series creation');
  assert.ok(yesterday.includes('feed.tmpl.created_series') && yesterday.includes('data-book-id="40"'));
  assert.ok(!yesterday.includes('data-book-id="41"'), 'today’s new volume never moves to the older day');
  assert.equal(JSON.stringify(entries), untouched, 'grouping preserves actual event dates and payloads');
  const alone = render([newBook], null, '').html;
  assert.ok(alone.includes('feed.tmpl.created_in_series') && alone.includes('feed.book_in_batch|n=1'), 'older series need no creation event in the current feed window');
  const second = { ...newBook, bookId: 42, bookName: 'Another new volume' };
  const two = render([second, newBook], null, '').html;
  assert.equal((two.match(/feed.tmpl.created_in_series/g) || []).length, 1);
  assert.ok(two.includes('feed.books_in_batch|n=2'));
  assert.deepEqual(groupAttrs(two), groupAttrs(alone), 'new same-day books retain the series expansion key');
  const otherUser = render([newBook, { ...second, username: 'Other creator' }], null, '').html;
  assert.equal((otherUser.match(/feed.tmpl.created_in_series/g) || []).length, 2, 'different creators retain separate announcements');
  const standalone = render([{ ...newBook, seriesId: null, parentBookId: null }], null, '').html;
  assert.ok(!standalone.includes('feed-group-toggle'), 'books without containers remain standalone');
  const anthologyChild = { ...newBook, parentBookId: 2, parentBookName: 'Anthology' };
  const anthology = render([{ ...base, type: 'book_created', isContainer: true, bookId: 2 }, anthologyChild], null, '').html;
  assert.ok(!anthology.includes('feed.tmpl.created_in_series'), 'same-day anthology claims its child only once');
  assert.equal((anthology.match(/data-book-id="41"/g) || []).length, 1);
  const oldAnthology = { ...base, type: 'book_created', isContainer: true, bookId: 2, completedAt: '2026-10-01T09:00:00Z' };
  const anthologyDays = render([anthologyChild, { ...oldBook, parentBookId: 2 }, oldAnthology], null, '');
  const anthologyToday = anthologyDays.blocks.find(b => b.key === 'day:Fri Oct 02 2026').html;
  const anthologyYesterday = anthologyDays.blocks.find(b => b.key === 'day:Thu Oct 01 2026').html;
  assert.ok(anthologyToday.includes('feed.tmpl.created_in_anthology') && anthologyToday.includes('feed.book_in_batch|n=1'));
  assert.ok(!anthologyToday.includes('data-book-id="40"') && !anthologyYesterday.includes('data-book-id="41"'));
  assert.ok(!anthologyToday.includes('feed.tmpl.created_in_series'), 'the immediate anthology takes priority over its outer series');
  const onlyAnthology = render([{ ...anthologyChild, seriesId: null }], null, '').html;
  assert.ok(onlyAnthology.includes('feed.tmpl.created_in_anthology'), 'an older anthology needs no creation event in the window');
  const privateAnthology = render([{ ...anthologyChild, parentBookIsPublic: false }], null, '').html;
  assert.ok(!privateAnthology.includes('href="/anthology/2"'), 'private anthology headings remain unlinked');
}

// Auth routing, single-flight and failure recovery are exercised through the facade.
token = null; await snapshot([{ ...base, type: 'book_created' }]); assert.equal(calls.filter(c => c[0] === 'public').length, 1);
token = 'account';
let resolveFetch;
fetchImpl = () => new Promise(resolve => { resolveFetch = resolve; });
const a = api.loadFeed(), b = api.loadFeed(); assert.equal(a, b);
resolveFetch({ ok: true, json: async () => payload }); await a;
const previous = feed.innerHTML;
fetchImpl = async () => { throw new Error('offline'); }; await api.loadFeed(); assert.equal(feed.innerHTML, previous);
feed.innerHTML = ''; await api.loadFeed(); assert.ok(feed.innerHTML.includes('feed.empty'));
fetchImpl = null; await api.loadFeed();
assert.equal(docListeners.get('click').length, 1);
assert.equal(windowListeners.get('resize').length, 1);
api.refreshDayCoverFlows(); api.refreshDayCoverFlows(); assert.equal(frames.size, 1); assert.equal(timers.size, 1);

if (!baseline) {
  const lastHtml = feed.innerHTML;
  fetchImpl = async () => ({ ok: false, json: async () => ({ entries: [], pinned: null }) });
  await api.loadFeed(); assert.equal(feed.innerHTML, lastHtml, 'HTTP failure preserves rendered feed');
  fetchImpl = async () => ({ ok: true, json: async () => ({ entries: null }) });
  await api.loadFeed(); assert.equal(feed.innerHTML, lastHtml, 'invalid payload preserves rendered feed');
  const requests = [];
  fetchImpl = () => new Promise(resolve => requests.push(resolve));
  const oldAccount = api.loadFeed(); token = 'other-account';
  const newAccount = api.loadFeed(); assert.notEqual(oldAccount, newAccount, 'account change starts a separate request');
  const beforeRewardCalls = calls.filter(c => c[0] === 'reward').length;
  requests[0]({ ok: true, json: async () => ({ entries: [], pinned: null }) }); await oldAccount;
  assert.equal(feed.innerHTML, lastHtml, 'old account response cannot replace feed');
  assert.equal(calls.filter(c => c[0] === 'reward').length, beforeRewardCalls);
  assert.equal(api.loadFeed(), newAccount, 'old completion cannot clear newer in-flight guard');
  requests[1]({ ok: true, json: async () => payload }); await newAccount;
  // Account changes during JSON parsing must invalidate the response too.
  let resolveJson;
  fetchImpl = async () => ({ ok: true, json: () => new Promise(resolve => { resolveJson = resolve; }) });
  const lateJson = api.loadFeed(); await new Promise(resolve => setImmediate(resolve));
  token = null; const beforeLateJson = feed.innerHTML;
  resolveJson({ entries: [], pinned: null }); await lateJson;
  assert.equal(feed.innerHTML, beforeLateJson);
  fetchImpl = null; token = 'account';
  const day = modules.get(resolve(root, 'feed/day-covers.js')).namespace;
  const card = new Element({ dayIndex: '0' }), stack = new Element();
  card.queries.set('.feed-day-cover-stack', stack);
  feed.queries.set('.feed-day-card[data-day-index]', [card]);
  day.replaceDayCoverLists([['/natural.jpg']]);
  const applying = day._applyDayCoverFlows(feed);
  images.at(-1).finish(); await applying;
  assert.ok(stack.innerHTML.includes('width:100px;height:150px'));
  assert.ok(stack.innerHTML.includes('top:75px'), 'center cover uses natural aspect ratio');
  await day._applyDayCoverFlows(feed); assert.equal(images.filter(img => img.url === '/natural.jpg').length, 1);
  const failedLoad = day._applyDayCoverFlows(feed, [['/retry.jpg']]);
  images.at(-1).onerror(); await failedLoad;
  const imageCount = images.length;
  const retryLoad = day._applyDayCoverFlows(feed, [['/retry.jpg']]);
  assert.equal(images.length, imageCount + 1, 'failed cover metadata must be retried rather than cached forever');
  images.at(-1).finish(); await retryLoad;
  assert.ok(stack.innerHTML.includes('/retry.jpg'));
  card.getBoundingClientRect = () => ({ top: 5000, bottom: 5300 });
  const beforeOffscreen = images.length;
  await day._applyDayCoverFlows(feed, [['/offscreen.jpg']]);
  assert.equal(images.length, beforeOffscreen, 'offscreen days do not fetch or decode covers');
  assert.equal(stack.innerHTML, '', 'offscreen days release their background tiles');
  card.getBoundingClientRect = () => ({ top: 0, bottom: 300 });
  await day._applyDayCoverFlows(feed, [['/natural.jpg']]);
  assert.ok(stack.innerHTML.includes('/natural.jpg'), 'scrolling a day back into view restores its covers');
  body.classList.add('no-feed-day-covers');
  await day._applyDayCoverFlows(feed);
  assert.equal(stack.innerHTML, '', 'disabled cover preference releases decoded-image DOM references');
  body.classList.remove('no-feed-day-covers');
  await day._applyDayCoverFlows(feed, [['/natural.jpg']]);
  body.classList.add('feed-collapsed');
  await day._applyDayCoverFlows(feed);
  assert.equal(stack.innerHTML, '', 'collapsed feed releases background tiles');
  body.classList.remove('feed-collapsed');
  await day._applyDayCoverFlows(feed, [['/natural.jpg']]);
  delete card.getBoundingClientRect;
  assert.equal(observers[0].cards.size, 1); day.replaceDayCoverLists([]); assert.equal(observers[0].cards.size, 0);
  body.classList.add('no-feed-day-covers'); const beforeImages = images.length;
  await day._applyDayCoverFlows(feed, [['/hidden.jpg']]); assert.equal(images.length, beforeImages);
  body.classList.remove('no-feed-day-covers');
  card.offsetWidth = 0;
  await day._applyDayCoverFlows(feed, [['/zero-width.jpg']]);
  assert.equal(images.length, beforeImages, 'hidden cards do not load images or generate zero-width tiles');
  card.offsetWidth = 100;
  const oldStack = stack.innerHTML;
  const staleApply = day._applyDayCoverFlows(feed, [['/pending-old.jpg']]);
  const pendingImage = images.at(-1);
  day.replaceDayCoverLists([]); pendingImage.finish(); await staleApply;
  assert.equal(stack.innerHTML, oldStack, 'stale image completion does not rewrite old cards');
  assert.equal(observers[0].cards.size, 0);
  const secondCard = new Element({ dayIndex: '1' }), secondStack = new Element();
  secondCard.queries.set('.feed-day-cover-stack', secondStack);
  feed.queries.set('.feed-day-card[data-day-index]', [card, secondCard]);
  day.replaceDayCoverLists([['/stalled.jpg'], ['/natural.jpg']]);
  const priorTimers = new Set(timers.keys());
  const stalledFlow = day._applyDayCoverFlows(feed);
  const stalledImage = images.at(-1);
  await new Promise(resolve => setImmediate(resolve));
  assert.ok(secondStack.innerHTML.includes('/natural.jpg'), 'a stalled cover cannot block another day');
  const timeoutId = [...timers.keys()].find(id => !priorTimers.has(id));
  assert.ok(timeoutId, 'stalled image loads have a bounded timeout');
  const expire = timers.get(timeoutId); timers.delete(timeoutId); expire();
  await stalledFlow;
  assert.equal(stalledImage.onload, null);
  assert.equal(stalledImage.onerror, null);
  const beforeRetry = images.length;
  const retryStalled = day._applyDayCoverFlows(feed);
  assert.equal(images.length, beforeRetry + 1, 'timeouts are retryable after a later refresh');
  images.at(-1).finish(); await retryStalled;
  assert.equal(timers.size, priorTimers.size, 'completed loads leave no retry timers running');
  for (let i = 0; i < 5; i++) {
    body.classList.add('no-feed-day-covers');
    await day._applyDayCoverFlows(feed);
    body.classList.remove('no-feed-day-covers');
    await day._applyDayCoverFlows(feed);
    assert.ok(stack.innerHTML.includes('/stalled.jpg'), 'repeated off/on retains loaded backgrounds');
  }
  feed.queries.set('.feed-day-card[data-day-index]', [card]);
  day.replaceDayCoverLists([['/natural.jpg']]);
  // Empty results must take the same observer cleanup path as populated results.
  await day._applyDayCoverFlows(feed, [['/natural.jpg']]); assert.equal(observers[0].cards.size, 1);
  payload = { entries: [], pinned: null }; await api.loadFeed(); assert.equal(observers[0].cards.size, 0);

  payload = {
    entries: [{ ...base, type: 'announcement', bookCovers: { '/book/1': '/announcement-cover.jpg' } }],
    pinned: { title: 'Pinned', body: '[Pinned book](/book/2)', bookCovers: { '/book/2': '/pinned-cover.jpg' } },
  };
  await api.loadFeed();
  assert.ok(feed.innerHTML.includes('href="/book/1" data-cover="/announcement-cover.jpg"'), 'regular announcement links opt into hover covers');
  assert.ok(feed.innerHTML.includes('href="/book/2" data-cover="/pinned-cover.jpg"'), 'pinned announcement links opt into hover covers');

  // Bindings dispatch the same library/profile/run actions and preserve expanded groups.
  const binding = modules.get(resolve(root, 'feed/bindings.js')).namespace;
  const target = new Element(), chevron = new Element(), toggle = new Element({ target: 'group', groupKey: 'saved' });
  elements.set('group', target); toggle.queries.set('.feed-group-chevron', chevron);
  const selectors = {
    '.feed-group-toggle': [toggle], '.feed-user-pub': [new Element({ username: 'Player' })],
    '.feed-verb-pub': [new Element({ bookId: '1', userId: '7', runIndex: '0' }), new Element({ bookId: '3', userId: '7', runIndex: '1', seriesRun: '1' })],
    '.feed-book-btn': [new Element({ bookId: '1', bookName: 'Book' })], '.feed-anthology-tag': [new Element({ anthologyId: '2', anthologyName: 'Anthology' })], '.feed-series-tag': [new Element({ seriesId: '3', seriesName: 'Series' })],
  };
  for (const [selector, items] of Object.entries(selectors)) feed.queries.set(selector, items);
  const expandedGroups = new Set(['saved']);
  binding.bindFeedInteractions(feed, expandedGroups); assert.equal(target.hidden, false);
  await toggle.emit('click', { target: { closest: () => null } }); assert.equal(target.hidden, true);
  assert.equal(expandedGroups.has('saved'), false, 'manual collapse clears saved intent');
  await toggle.emit('click', { target: { closest: () => null } }); assert.equal(target.hidden, false);
  assert.equal(expandedGroups.has('saved'), true, 'manual expansion saves intent for later refreshes');
  await toggle.emit('click', { target: { closest: () => null } }); assert.equal(target.hidden, true);
  await toggle.emit('click', { target: { closest: () => ({}) } }); assert.equal(target.hidden, true);
  for (const [selector, items] of Object.entries(selectors)) if (selector !== '.feed-group-toggle') for (const item of items) await item.emit('click', { preventDefault() {} });
  for (const name of ['openPublicProfile', 'openPublicRun', 'openPublicSeriesRun', 'openCoverActivity', 'openSeriesActivity']) assert.ok(calls.some(c => c[0] === name));
  const freshGroup = () => {
    const control = new Element({ target: 'persisted-body', groupKey: 'persisted' });
    control.setAttribute('aria-expanded', 'false');
    control.queries.set('.feed-group-chevron', new Element());
    const content = new Element(); content.hidden = true;
    elements.set('persisted-body', content);
    feed.queries.set('.feed-group-toggle', [control]);
    return { control, content };
  };
  let savedGroup = freshGroup(); await api.loadFeed();
  await savedGroup.control.emit('click', { target: { closest: () => null } });
  feed.queries.set('.feed-group-toggle', []); await api.loadFeed();
  savedGroup = freshGroup(); await api.loadFeed();
  assert.equal(savedGroup.content.hidden, false, 'loader retains expansion when a group temporarily disappears');
  await savedGroup.control.emit('click', { target: { closest: () => null } });
  savedGroup = freshGroup(); await api.loadFeed();
  assert.equal(savedGroup.content.hidden, true, 'loader respects explicit collapse');
  await savedGroup.control.emit('click', { target: { closest: () => null } });
  token = 'different-account'; savedGroup = freshGroup(); await api.loadFeed();
  assert.equal(savedGroup.content.hidden, true, 'another account does not inherit expansion');
  const previews = modules.get(resolve(root, 'feed/previews.js')).namespace;
  const hover = new Element({ cover: '/cover.jpg' }); feed.queries.set('.feed-user, [data-cover]', [hover]);
  previews.bindFeedPreviews(feed); await hover.emit('mouseenter', { clientX: 100, clientY: 100 });
  const previewImg = elements.get('feed-img-preview-img');
  for (let i = 0; i < 5; i++) await hover.emit('mouseenter', { clientX: 100, clientY: 100 });
  assert.equal(previewImg.listeners.get('load').length, 1, 'hover load listeners do not accumulate');
  assert.equal(previewImg.listeners.get('error').length, 1);
  assert.equal(elements.get('feed-img-preview').style.display, 'block'); assert.equal(elements.get('feed-img-preview-img').style.width, '90px');
  for (const fn of docListeners.get('click')) fn(); assert.equal(elements.get('feed-img-preview').style.display, 'none');
  assert.equal(previewImg.listeners.get('load').length, 0);
  assert.equal(previewImg.listeners.get('error').length, 0);
  context.window.innerWidth = 768;
  const mobileHover = new Element({ cover: '/cover.jpg' }); feed.queries.set('.feed-user, [data-cover]', [mobileHover]);
  previews.bindFeedPreviews(feed); assert.equal(mobileHover.listeners.size, 0);
}
if (!baseline) {
  const filters = modules.get(resolve(root, 'feed/filters.js')).namespace;
  const categoryTypes = {
    catalog: ['book_created', 'series_created'],
    library: ['book_added', 'series_added'],
    runs: ['run_started', 'run_completed', 'series_run_started', 'series_run_completed'],
    achievements: ['level_up', 'all_visited', 'all_discovered', 'first_win', 'first_loss', 'first_battle_death', 'won_all_series', 'won_all_anthology', 'visit_all_series', 'discover_all_series', 'visit_all_anthology', 'discover_all_anthology'],
    ratings: ['book_rated', 'series_rated'],
    players: ['user_joined', 'party_formed'],
    news: ['announcement'],
  };
  for (const [category, members] of Object.entries(categoryTypes)) {
    const visible = filters.filterFeedEntries(types.map(type => ({ type })), new Set([category]));
    assert.deepEqual(Array.from(visible, e => e.type), types.filter(type => !members.includes(type)), category);
  }
  assert.ok(!filters.feedHeaderHtml(false, new Set()).includes('data-feed-filter'));
  assert.equal((filters.feedHeaderHtml(true, new Set()).match(/aria-pressed="true"/g) || []).length, 7);
  assert.deepEqual([...filters.FEED_FILTERS], ['players', 'runs', 'achievements', 'catalog', 'library', 'ratings', 'news']);
  assert.equal(filters.filterFeedEntries(types.map(type => ({ type })), new Set(filters.FEED_FILTERS)).length, 0);
  assert.equal(filters.filterFeedEntries([{ type: 'future_event' }], new Set(filters.FEED_FILTERS)).length, 1, 'unknown future events are not silently lost');

  token = 'ordinary-player';
  const savedFilters = [];
  hooks.savePrefs = patch => savedFilters.push(patch);
  hooks.getIsAdmin = () => false;
  hooks.getIsModerator = () => false;
  payload = { entries: [{ ...base, type: 'book_created' }, { ...base, type: 'run_started' }, { ...base, type: 'announcement', body: 'Regular news body' }], pinned: { title: 'Admin news', body: 'Pinned' } };
  const filterButton = new Element({ feedFilter: 'catalog' });
  feed.queries.set('[data-feed-filter]', [filterButton]);
  await api.loadFeed();
  assert.equal((feed.innerHTML.match(/aria-pressed="true"/g) || []).length, 7, 'ordinary players have controls without role resolution');
  const beforeRequests = calls.filter(c => c[0] === 'private').length;
  feed.queries.set('[data-feed-filter]', []);
  await filterButton.emit('click');
  assert.equal(JSON.stringify(savedFilters.at(-1)), JSON.stringify({ feedFilters: { catalog: false } }));
  assert.ok(!feed.innerHTML.includes('feed.tmpl.created|'), 'catalog entries hidden');
  assert.ok(feed.innerHTML.includes('feed.tmpl.run_started'), 'runs retained');
  assert.equal(calls.filter(c => c[0] === 'private').length, beforeRequests, 'toggle does not fetch');
  await api.loadFeed();
  assert.ok(!feed.innerHTML.includes('feed.tmpl.created|'), 'live refresh retains filter');
  assert.ok(feed.innerHTML.includes('data-feed-filter="catalog" aria-pressed="false"'));
  const newsButton = new Element({ feedFilter: 'news' });
  feed.queries.set('[data-feed-filter]', [newsButton]);
  api.refreshFeedFilters();
  feed.queries.set('[data-feed-filter]', []);
  await newsButton.emit('click');
  assert.ok(feed.innerHTML.includes('feed-pinned-card'), 'pinned announcements stay visible with news disabled');
  assert.ok(!feed.innerHTML.includes('Regular news body'), 'news filter still hides regular announcements');
  api.refreshFeedFilters();
  assert.ok(!feed.innerHTML.includes('feed.tmpl.created|'), 'ordinary-player filters survive refresh');
  assert.ok(feed.innerHTML.includes('data-feed-filter'));
  token = 'second-player';
  await api.loadFeed();
  assert.equal((feed.innerHTML.match(/aria-pressed="true"/g) || []).length, 7, 'different account starts with all enabled');
  api.applyFeedFilterPrefs({ catalog: false, news: false, unknown: false });
  assert.ok(!feed.innerHTML.includes('feed.tmpl.created|'), 'saved account filters hide catalog entries');
  assert.ok(feed.innerHTML.includes('feed-pinned-card'), 'saved news preferences keep pinned announcements visible');
  assert.equal((feed.innerHTML.match(/aria-pressed="false"/g) || []).length, 2, 'unknown saved keys ignored');
  api.applyFeedFilterPrefs(Object.fromEntries(filters.FEED_FILTERS.map(key => [key, false])));
  assert.ok(feed.innerHTML.startsWith('<div class="feed-pinned-card">'), 'pinned announcement stays first with all filters disabled');
  assert.ok(!feed.innerHTML.includes('feed-day-card'), 'all filters disabled hides ordinary activity');
  assert.ok(!feed.innerHTML.includes('feed-empty'), 'visible pinned announcement prevents empty state');
  await api.loadFeed();
  assert.ok(feed.innerHTML.startsWith('<div class="feed-pinned-card">'), 'live refresh retains pinned announcement with all filters disabled');
  api.applyFeedFilterPrefs({ catalog: true });
  assert.equal((feed.innerHTML.match(/aria-pressed="true"/g) || []).length, 7, 'remote preference sync restores selected categories');
  token = 'lorekeeper';
  hooks.getIsModerator = () => true;
  const lorekeeperButton = new Element({ feedFilter: 'runs' });
  feed.queries.set('[data-feed-filter]', [lorekeeperButton]);
  await api.loadFeed();
  assert.equal((feed.innerHTML.match(/aria-pressed="true"/g) || []).length, 7, 'lorekeepers also have filters');
  feed.queries.set('[data-feed-filter]', []);
  await lorekeeperButton.emit('click');
  assert.ok(!feed.innerHTML.includes('feed.tmpl.run_started'), 'lorekeepers can toggle categories');
  hooks.getIsModerator = () => false;
  api.refreshFeedFilters();
  assert.ok(feed.innerHTML.includes('data-feed-filter'), 'removing lorekeeper role retains controls');
  assert.ok(!feed.innerHTML.includes('feed.tmpl.run_started'), 'removing role retains selected filters');
  hooks.getIsModerator = () => true;
  token = null;
  const guestButton = new Element({ feedFilter: 'runs' });
  feed.queries.set('[data-feed-filter]', [guestButton]);
  await api.loadFeed();
  assert.equal((feed.innerHTML.match(/aria-pressed="true"/g) || []).length, 7, 'guests have controls with reset selections');
  const savedCount = savedFilters.length;
  feed.queries.set('[data-feed-filter]', []);
  await guestButton.emit('click');
  assert.ok(!feed.innerHTML.includes('feed.tmpl.run_started'), 'guests can filter locally');
  assert.equal(savedFilters.length, savedCount, 'guest filters do not write account preferences');
}
console.log(JSON.stringify({ digest, cases: snapshots.length - 1 }));
