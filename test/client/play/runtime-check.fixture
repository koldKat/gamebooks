  api.setOpenWorldContext({ isOpenWorld: true, seriesId: 88, onRunDeleted: () => { newDeleteHooks++; } });
  effects.length = 0; releaseDelete({}); await deletePromise;
  assert.equal(oldDeleteHooks, 0); assert.equal(newDeleteHooks, 0, 'async delete must not call the new book hook');
  assert.equal(effects.some(e => e[0] === 'graph'), false, 'async delete must not render the new book');
  stateModule.namespace.replaceState(state); stateModule.namespace.setApiFetch(originalFetch);
  confirmModule.setExport('showConfirm', immediateConfirm);
  api.showTwoChoice('One', 'A', () => {}, 'B', () => {});
  api.showTwoChoice('Two', 'A', () => {}, 'B', () => {});
  assert.equal(el('choice-overlay').listeners.get('mousedown').length, 1, 'one backdrop mousedown listener');
  assert.equal(el('choice-overlay').listeners.get('click').length, 1, 'one backdrop click listener');
  el('choice-overlay').dispatch('mousedown'); el('choice-overlay').click();
  assert.equal(el('choice-overlay').classList.contains('active'), false);
  api.openPortalModal(1); api.openPortalModal(1); api.openPortalModal(1);
  assert.equal(el('portal-section-input').listeners.get('keydown').length, 1, 'one portal Escape listener');
  el('portal-section-input').dispatch('keydown', { key: 'Escape' });
  assert.equal(el('portal-modal-overlay').classList.contains('active'), false);
}
