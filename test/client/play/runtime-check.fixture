function helper(name) {
  const start = stateSource.indexOf('export function ' + name + '(');
  assert.ok(start >= 0, name);
  let depth = 0, opened = false, end = start;
  for (; end < stateSource.length; end++) {
    if (stateSource[end] === '{') { depth++; opened = true; }
    if (stateSource[end] === '}' && --depth === 0 && opened) break;
  }
