const helperNames = ['parseSecId', 'isValidSecId', 'currentPlaythrough', 'currentSection', 'allDiscoveredSections', 'discoveredSectionsFor', 'mappedCount', 'mappedCountFor'];
const stateModule = new SourceTextModule(`
  export let state = _fixtureState;
  export const replaceState = next => { state = next; };
  export let viewingPt = null, viewingPtIndex = -1, currentUserLevel = 0, bonusUndos = 0, bonusFastTravels = 0;
  export const isTerminal = s => s === -1 || s === 0;
  export function setViewingPt(pt, force) { viewingPt = pt; viewingPtIndex = pt ? state.playthroughs.indexOf(pt) : -1; _setViewing(pt, force); }
  export const saveState = () => _effects.push(['save']);
  export let apiFetch = async (...args) => { _effects.push(['api', ...args]); return {}; };
  export const setApiFetch = fn => { apiFetch = fn; };
  export const setLevel = (level, undos, fast) => { currentUserLevel = level; bonusUndos = undos; bonusFastTravels = fast; };
