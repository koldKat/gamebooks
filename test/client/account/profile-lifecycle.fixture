import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { SourceTextModule, SyntheticModule, createContext } from 'node:vm';

const nodes = new Map(), pending = [];
const el = id => {
  if (!nodes.has(id)) {
    const classes = new Set();
    nodes.set(id, { style: {}, textContent: '', innerHTML: '', value: '',
      querySelector: () => null,
      classList: { add: c => classes.add(c), remove: c => classes.delete(c), contains: c => classes.has(c) } });
  }
  return nodes.get(id);
};
let token = 'first-session', snapshots = 0;
const frames = [];
let now = 0;
const context = createContext({ document: { getElementById: el }, console,
  performance: { now: () => now }, requestAnimationFrame: callback => frames.push(callback) });
const stubs = {
  '../core/state.js': { apiFetch: () => new Promise((resolve, reject) => pending.push({ resolve, reject })), getToken: () => token,
    getUsername: () => 'Tester', setUsername() {}, setCurrentUserLevel() {} },
  '../i18n.js': { t: key => key },
  '../progression/shop.js': { updateCoinsDisplay() {} },
  '../progression/diamonds.js': { updateDiamondsDisplay() {} },
  '../core/util.js': { escapeHtml: value => String(value), compressToBlob() {} },
};
const mod = new SourceTextModule(readFileSync(process.argv[1], 'utf8'), { context });
await mod.link(specifier => {
  const values = stubs[specifier]; assert.ok(values, specifier);
  return new SyntheticModule(Object.keys(values), function () {
    for (const [name, value] of Object.entries(values)) this.setExport(name, value);
  }, { context });
});
await mod.evaluate();
const profile = mod.namespace;
profile.setProfileHooks({ onRewardSnapshot: () => { snapshots++; } });
const overlay = el('profile-modal-overlay');
overlay.classList.add('active'); profile.closeProfileModal();
assert.equal(overlay.classList.contains('active'), false);

const data = { username: 'Tester', xp: 0, level: 0 };
const normal = profile.openProfileModal(); pending.shift().resolve({ json: async () => data }); await normal;
assert.equal(overlay.classList.contains('active'), true, 'valid profile still opens');
assert.equal(snapshots, 1);
profile.closeProfileModal();

const late = profile.openProfileModal();
profile.closeProfileModal(); token = null;
pending.shift().resolve({ json: async () => data }); await late;
assert.equal(overlay.classList.contains('active'), false, 'late response cannot reopen after logout');
assert.equal(snapshots, 1, 'late response does not apply account data');

token = 'second-session';
const slowJson = profile.openProfileModal(); let resolveJson;
pending.shift().resolve({ json: () => new Promise(resolve => { resolveJson = resolve; }) });
for (let i = 0; i < 5; i++) await Promise.resolve();
profile.closeProfileModal(); resolveJson(data); await slowJson;
assert.equal(overlay.classList.contains('active'), false, 'closing during JSON parsing cancels opening');

const switched = profile.openProfileModal(); token = 'third-session';
pending.shift().resolve({ json: async () => data }); await switched;
assert.equal(overlay.classList.contains('active'), false, 'another session cannot receive the old profile');

const failed = profile.openProfileModal(); profile.closeProfileModal();
pending.shift().reject(new Error('late failure')); await failed;
assert.equal(overlay.classList.contains('active'), false);
assert.equal(el('profile-error').textContent, '', 'cancelled failure does not paint an error');
console.log('Profile close, pending-response, delayed-JSON, session-switch and error guards passed.');

const xpData = { xp: 2000, level: 1, nextLevelXp: 3000, xpFromBoost: 100, xpBoostPct: 0.1, bonusHeartbeatXp: 0, bonusHeartbeatXpFree: 0 };
profile.renderBooksXpSummary(xpData);
profile.renderBooksXpSummary({ ...xpData, xpBoostPct: 0.2, bonusHeartbeatXp: 1 }, { fromXp: 2000 });
for (const prefix of ['books', 'play']) {
  assert.ok(el(prefix + '-xp-boost').innerHTML.includes('+0.2% boost'), 'same-XP purchase immediately updates ' + prefix + ' boost');
  assert.equal(el(prefix + '-xp-hb-rate').textContent, '+1.1 heartbeat XP/min');
}
assert.ok(el('profile-xp-boost-earned').innerHTML.includes('+0.2% boost'));
assert.equal(el('profile-xp-hb-rate').textContent, '+1.1 heartbeat XP/min');
assert.equal(frames.length, 0, 'rate-only changes do not start XP animation');
profile.renderBooksXpSummary({ ...xpData, xp: 2010 }, { fromXp: 2000 });
assert.equal(frames.length, 1);
profile.renderBooksXpSummary({ ...xpData, xp: 2010, xpBoostPct: 0.3, bonusHeartbeatXp: 2 }, { fromXp: 2010 });
assert.equal(frames.length, 1, 'purchase does not cancel or duplicate an active tween');
now = 50; frames.shift()(now);
assert.ok(el('books-xp-boost').innerHTML.includes('+0.3% boost'), 'old animation frame cannot restore pre-purchase boost');
assert.equal(el('play-xp-hb-rate').textContent, '+1.2 heartbeat XP/min');
now = 100; frames.shift()(now);
assert.equal(frames.length, 0, 'existing tween still finishes');
assert.ok(el('play-xp-boost').innerHTML.includes('+0.3% boost'));
console.log('Immediate boost/heartbeat purchase updates and active-animation preservation passed.');
