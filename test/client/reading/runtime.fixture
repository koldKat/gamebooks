import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { createContext, SourceTextModule, SyntheticModule } from 'node:vm';
import { pathToFileURL } from 'node:url';

let section = 1;
let mapMode = false, coreModule;
let failedSection = null;
let run = { path: [1], completed: false };
const graph = {};
const requests = [], commits = [], suppression = [], physics = [];
const active = new Set();
const panel = { classList: { contains: value => active.has(value), add: value => active.add(value), remove: value => active.delete(value) } };
const body = { innerHTML: '', scrollTop: 9, querySelectorAll: () => [] };
let markup = '', mapForm;
Object.defineProperty(body, 'innerHTML', {
  get: () => markup,
  set(html) {
    markup = html;
    mapForm = null;
    if (!html.includes('data-reading-map-entry')) return;
    const input = { value: '', max: '150', disabled: false, addEventListener() {} };
    const submit = { disabled: false };
    const listeners = [];
    mapForm = { input, submit, querySelector: selector => selector.startsWith('input') ? input : submit,
      reportValidity: () => true, addEventListener: (_type, fn) => listeners.push(fn),
      fire() { for (const fn of listeners) fn({ preventDefault() {} }); } };
  },
});
body.querySelectorAll = selector => selector.startsWith('form') && mapForm ? [mapForm] : [];
const button = { setAttribute() {}, removeAttribute() {} };
const elements = { 'liveread-panel': panel, 'liveread-body': body, 'liveread-heading': {}, 'liveread-btn': button,
  'liveread-preview-return': { addEventListener() {} } };
const context = createContext({ document: { getElementById: id => elements[id], addEventListener() {}, removeEventListener() {} }, console });
const stubData = {
  '../core/state.js': { state: { startSection: 1, totalSections: 150, graph }, getToken: () => 'account', currentBookId: 42, currentPlaythrough: () => run, currentSection: () => section,
    viewingPt: null, isTerminal: sec => sec === 0 || sec === -1, parseSecId: Number, isSectionMapped: sec => sec === 1,
    apiFetch: async url => { requests.push(url); const sec = Number(url.split('/').at(-1));
      if (sec === failedSection) { failedSection = null; throw new Error('Temporary connection failure'); }
      return { ok: true, json: async () => ({ html: '<p>Section ' + sec + '</p>' + (mapMode ? '<form data-reading-map-entry><input name="marker" max="150"><button type="submit">Go</button></form>' : ''), choices: sec === 1 ? [2] : sec === 120 ? [197] : [] }) }; } },
  '../play.js': { navigate(sec) { section = sec; run.path.push(sec); }, startPlaythrough() {}, commitChoices(sec, choices) { commits.push([sec, [...choices]]); graph[sec] = { ...graph[sec], choices: [...choices] }; }, showAlert() {}, suppressAutoNav: value => suppression.push(value) },
  './access.js': { showReadingGate: async () => false },
  './content.js': { renderReadingMatter: () => false },
  '../graph.js': { network: null, setLightweightRestabilize: value => physics.push(value) },
  '../i18n.js': { t: key => key },
  '../core/util.js': { shortcutLabel() {}, registerPanelShortcut() {}, ALL_PANEL_OVERLAY_IDS: [] },
};
const mod = new SourceTextModule(readFileSync(process.argv[1], 'utf8'), { context });
await mod.link(specifier => {
  if (specifier === './map-entry.js' || specifier === '../core/section-labels.js') return new SourceTextModule(readFileSync(new URL(specifier, pathToFileURL(process.argv[1])), 'utf8'), { context });
  if (specifier === './liveread-shared.js') return new SourceTextModule(readFileSync(new URL('./liveread-shared.js', pathToFileURL(process.argv[1])), 'utf8'), { context });
  assert.ok(stubData[specifier], 'unexpected dependency: ' + specifier);
  const values = stubData[specifier];
  const stub = new SyntheticModule(Object.keys(values), function () { for (const [name, value] of Object.entries(values)) this.setExport(name, value); }, { context });
  if (specifier === '../core/state.js') coreModule = stub;
  return stub;
});
await mod.evaluate();
const reader = mod.namespace;
const settle = async () => { for (let i = 0; i < 12; i++) await Promise.resolve(); };
await reader.previewSection(1);
assert.equal(requests.length, 0, 'closed reader must not fetch a clicked section');
assert.equal(active.has('active'), false, 'node clicks must not open the reader');
assert.equal(body.innerHTML, '');
assert.deepEqual(suppression, []);
assert.deepEqual(physics, []);
active.add('active');
reader.renderLiveRead();
await settle();
assert.equal(body.innerHTML, '<p>Section 1</p>');
assert.equal(body.scrollTop, 0);
assert.deepEqual(commits, [[1, [2]]]);
assert.deepEqual(requests, ['/api/books/42/sections/1', '/api/books/42/sections/2']);
reader.renderLiveRead();
await settle();
assert.equal(requests.length, 2, 'unchanged section does not fetch again');
section = 2;
reader.renderLiveRead();
await settle();
assert.equal(body.innerHTML, '<p>Section 2</p>');
assert.equal(requests.length, 2, 'navigation uses prefetched section');
await reader.previewSection(3);
assert.equal(requests.length, 2, 'unmapped preview cannot read ahead');
await reader.previewSection(1);
assert.match(body.innerHTML, /Section 1/);
assert.equal(requests.length, 2, 'mapped preview uses cached section');
reader.setLiveReadVisible(false);
assert.equal(active.has('active'), false);
assert.equal(button.disabled, true);
assert.deepEqual(suppression, [false]);
assert.deepEqual(physics, [false]);

const closedHtml = body.innerHTML;
await reader.previewSection(1);
await reader.previewSection(2);
assert.equal(active.has('active'), false, 'node clicks must not reopen a closed reader');
assert.equal(body.innerHTML, closedHtml);
assert.equal(requests.length, 2);
assert.deepEqual(suppression, [false]);
assert.deepEqual(physics, [false]);

mapMode = true;
coreModule.setExport('currentBookId', 570);
section = 1;
active.add('active');
reader.renderLiveRead();
await settle();
assert.ok(mapForm && !mapForm.input.disabled, 'active map entry is available');
assert.equal(graph[1].manualNavigation, true);
const firstForm = mapForm;
firstForm.input.value = '12';
firstForm.fire();
await settle();
assert.deepEqual(run.path, [1,12]);
assert.deepEqual(graph[1].choices, [2,12], 'only the selected map edge is added');
assert.equal(graph[1].manualNavigation, true);
firstForm.input.value = '13';
firstForm.fire();
assert.deepEqual(run.path, [1,12], 'detached stale map form cannot navigate');
await reader.previewSection(1);
assert.ok(mapForm.input.disabled && mapForm.submit.disabled, 'mapped previews disable manual entry');
mapForm.input.value = '14';
mapForm.fire();
assert.deepEqual(run.path, [1,12]);
reader.setLiveReadVisible(false);
active.add('active');
reader.renderLiveRead();
await settle();
const staleRunForm = mapForm;
run = { path: [12], completed: false };
staleRunForm.input.value = '15';
staleRunForm.fire();
assert.deepEqual(run.path, [12], 'map form cannot navigate a replacement run');
reader.setLiveReadVisible(false);

mapMode = false;
coreModule.setExport('currentBookId', 198);
section = 120;
run = { path: [120], completed: false };
failedSection = 120;
active.add('active');
reader.renderLiveRead();
await settle();
assert.equal(graph[120], undefined, 'failed fetch must not fabricate outgoing choices');
const attempts = requests.length;
reader.renderLiveRead();
await settle();
assert.ok(requests.length > attempts, 'failed section must be retried on the next render');
assert.equal(body.innerHTML, '<p>Section 120</p>');
assert.deepEqual(graph[120].choices, [197], 'successful arrival reveals the unvisited outgoing section');
assert.deepEqual(run.path, [120], 'revealing an outgoing link must not visit its destination');
const successfulRequests = requests.length;
reader.renderLiveRead();
await settle();
assert.equal(requests.length, successfulRequests, 'successful section must not start a refetch loop');
reader.setLiveReadVisible(false);
