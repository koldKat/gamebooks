import assert from 'node:assert/strict';
import { readFileSync, readdirSync } from 'node:fs';
import { resolve, dirname } from 'node:path';
import { createHash } from 'node:crypto';
import { createContext, SourceTextModule, runInNewContext } from 'node:vm';

const root = process.argv[1];
const baseline = JSON.parse(readFileSync(resolve(root, '../../test/client/i18n/tables-baseline.json'), 'utf8'));
const parserContext={exports:{},module:{}};
runInNewContext(process.binding('natives')['internal/deps/acorn/acorn/dist/acorn'],parserContext);
function verifyLiteralKeys(node, file) {
  if(!node||typeof node!=='object')return;
  if(node.type==='ObjectExpression'){
    const keys=node.properties.filter(p=>p.type==='Property'&&!p.computed).map(p=>String(p.key.name??p.key.value));
    assert.equal(new Set(keys).size,keys.length,'duplicate literal key in '+file);
  }
  for(const value of Object.values(node))if(Array.isArray(value))value.forEach(child=>verifyLiteralKeys(child,file));
  else if(value&&typeof value==='object')verifyLiteralKeys(value,file);
}
const rosterTables = new Map([
  ['528','gateway-of-doom'], ['529','voyage-of-terror'], ['530','kingdom-of-horror'],
  ['531','realm-of-chaos'], ['532','tomb-of-nightmares'], ['533','legion-of-the-dead'],
]);
const hash = entries => createHash('sha256').update(JSON.stringify(entries)).digest('hex');
const sorted = table => Object.keys(table).sort().map(key => [key, table[key]]);
async function environment(language) {
  const selectors = new Map(), modules = new Map(), reads = [];
  const document = { documentElement: {}, title: '', querySelectorAll: selector => selectors.get(selector) || [] };
  const context = createContext({ document, localStorage: { getItem: key => { reads.push(key); return language; } } });
  function get(path) {
    path = resolve(path);
    if (!modules.has(path)) modules.set(path, new SourceTextModule(readFileSync(path, 'utf8'), {
      context, identifier: path,
      importModuleDynamically: async (specifier, parent) => {
        const module = get(resolve(dirname(parent.identifier), specifier));
        if (module.status === 'unlinked') await module.link((s, p) => get(resolve(dirname(p.identifier), s)));
        if (module.status !== 'evaluated') await module.evaluate();
        return module;
      },
    }));
    return modules.get(path);
  }
  async function load(path) {
    const module = get(resolve(root, path));
    if (module.status === 'unlinked') await module.link((specifier, parent) => {
      assert.ok(specifier.startsWith('.'), 'only local synchronous dependencies');
      return get(resolve(dirname(parent.identifier), specifier));
    });
    if (module.status !== 'evaluated') await module.evaluate();
    return module.namespace;
  }
  const api = await load('i18n.js');
  const table = (await load('i18n/en/index.js')).default;
  return { api, table, document, selectors, modules, reads, load };
}
const en = await environment('en');
assert.deepEqual(Object.keys(en.api).sort(), ['applyTranslations', 'setTranslationOverride', 't']);
assert.equal(Object.keys(en.table).length, baseline.coreKeys, 'only core and shared simulator strings are eager');
assert.ok([...en.modules.keys()].every(path => !/battlesim\d+\.js$/.test(path)), 'startup loads no per-simulator tables');
assert.equal(en.api.t('battlesim214.status.fallen'), 'battlesim214.status.fallen', 'simulator strings start unloaded');
assert.deepEqual(en.reads, ['gamebook_lang'], 'language read once through the shared runtime');

const paths = [];
function walk(dir) {
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    const path = resolve(dir, entry.name);
    if (entry.isDirectory()) walk(path);
    else if (entry.name.endsWith('.js') && entry.name !== 'index.js') paths.push(path);
  }
}
walk(resolve(root, 'i18n/en'));
for(const name of Object.keys(baseline.tables))assert.ok(paths.includes(resolve(root,'i18n/en',name)),'baseline table remains present: '+name);
const lazy = await en.load('i18n/battlesim.js');
const simulatorIds = [];
const keys = new Set();
for (const path of paths) {
  const source = readFileSync(path, 'utf8');
  const simulatorId = path.match(/battlesim(\d+)\.js$/)?.[1];
  assert.doesNotMatch(source, /\b(?:document|localStorage|fetch)\s*[.(]|\bimport\s*\(/m, 'tables have no browser or dynamic runtime dependencies');
  if (rosterTables.has(simulatorId)) {
    const roster = '../../../battlesim/engines/grailquest/'+rosterTables.get(simulatorId)+'-roster.js';
    assert.deepEqual([...source.matchAll(/\bfrom\s+'([^']+)'/g)].map(match => match[1]), [roster], 'names share only their own static encounter roster');
    assert.doesNotMatch(readFileSync(resolve(dirname(path), roster), 'utf8'), /^import |\b(?:document|localStorage|fetch)\s*[.(]/m, 'shared roster is data-only');
  }
  verifyLiteralKeys(parserContext.exports.parse(source,{ecmaVersion:'latest',sourceType:'module'}),path);
  const table = (await en.load(path)).default;
  const snapshot=baseline.tables[path.slice(resolve(root,'i18n/en').length+1)];
  if(snapshot){assert.equal(Object.keys(table).length,snapshot.keys,path);assert.equal(hash(sorted(table)),snapshot.sha256,'exact reviewed Unicode/string values: '+path);}
  if (simulatorId) {
    simulatorIds.push(Number(simulatorId));
    await lazy.loadBattleSimTranslations(simulatorId);
  }
  if (rosterTables.has(simulatorId)) {
    const roster = await en.load('battlesim/engines/grailquest/'+rosterTables.get(simulatorId)+'-roster.js');
    const entries = Object.entries(roster).filter(([key]) => /_(ENCOUNTERS|WANDERING|DREAMS|NAVIGATION)$/.test(key)).flatMap(([,rows]) => rows);
    const id = entry => entry.id ?? entry.section;
    assert.equal(new Set(entries.map(id)).size, entries.length, 'generated enemy-name keys are unique');
    for (const entry of entries) assert.equal(table['battlesim'+simulatorId+'.enemy_names.' + id(entry)], entry.name);
  }
  for (const key of Object.keys(table)) {
    assert.equal(keys.has(key), false, 'no duplicate key across tables: ' + key);
    keys.add(key);
    assert.equal(typeof table[key], 'string');
    const localizedPath = simulatorId && resolve(root, 'i18n/bg/battlesim/battlesim' + simulatorId + '.js');
    const localized = localizedPath && en.modules.has(localizedPath) ? (await en.load(localizedPath)).default : table;
    assert.equal(en.api.t(key), localized[key]);
  }
  if (simulatorId) {
    for (const key of Object.keys(table)) {
      const id = Number(key.match(/^battlesim(\d+)\./)?.[1]);
      assert.equal(id, Number(simulatorId), 'string belongs to its simulator: ' + key);
    }
  }
}
assert.equal(keys.size, Object.keys(en.table).length, 'aggregator includes every table exactly once');
const simulatorRuleUpdates = JSON.parse(readFileSync(resolve(root, '../../test/client/i18n/simulator-rules-updates.json'), 'utf8'));
for (const [key, value] of Object.entries(simulatorRuleUpdates.added)) assert.equal(en.api.t(key), value);
for (const [key, [, value]] of Object.entries(simulatorRuleUpdates.changed)) assert.equal(en.api.t(key), value);
const added734 = {
  'battlesim734.log.next_enemy': 'Продължаваш срещу {enemy}.',
  'battlesim734.btn.switch_target': 'Смени противника',
};
for (const [key, value] of Object.entries(added734)) assert.equal(en.api.t(key), value);
assert.equal(en.api.t('covers.login_to_add_book'), 'Log in or sign up to add book');
const added230 = {
  'battlesim230.log.shared_round': '{enemy}: {enemyAS}, against your same Attack Strength of {playerAS}. Only the highest lands a blow.',
  'battlesim230.ui.paired_source': 'Fight two opponents together (only the highest lands a blow)',
  'battlesim230.btn.switch_target': 'Switch attack target',
};
for (const [key, value] of Object.entries(added230)) assert.equal(en.api.t(key), value);
const addedMax = {
  'covers.edit_series': 'Edit series',
  'stats.moderators': 'Lorekeepers',
  'modal.book.max_section': 'Highest section',
  'modal.book.optional': '(optional)',
  'modal.book.max_section_hint': 'Optional, for numbering with gaps. Leave blank to use total sections.',
  'err.max_section': 'Highest section number must be a whole number of at least {min}.',
};
for (const [key, value] of Object.entries(addedMax)) assert.equal(en.api.t(key), value);
assert.equal(en.api.t('err.max_section', { min: 1003 }), 'Highest section number must be a whole number of at least 1003.');
const addedMint = {
  'notif.coin_mint_bonus': 'Coin Mint bonus',
  'notif.gold_coins': '{amount} Gold Coin{s}',
};
for (const [key, value] of Object.entries(addedMint)) assert.equal(en.api.t(key), value);
assert.equal(en.api.t('notif.gold_coins', { amount: 2, s: 's' }), '2 Gold Coins');
const renamedRoleLabels = {
  ...simulatorRuleUpdates.changed,
  'stats.admins': ['Admins', 'Gamemasters'],
  'stats.authors': ['Authors', 'Fateweavers'],
  'stats.contributors': ['Contributors', 'Pathmakers'],
  'auth.no_email_on_file': ['This account has no email address on file. Please contact an admin using the feedback form.', 'This account has no email address on file. Please contact a Gamemaster using the feedback form.'],
};
for (const [key, [, label]] of Object.entries(renamedRoleLabels)) assert.equal(en.api.t(key), label);
const original = sorted(en.table);
assert.equal(hash(original.map(([key]) => [key,en.api.t(key)])),hash(original),'every source key resolves after lazy loading');
assert.equal(en.api.t('reading_access.unlock', { cost: 0 }), 'Unlock book · 0');
for (const path of ['battlesim/loader.js', '../mobile/js/battlesim-dispatch.js']) {
  const source = readFileSync(resolve(root, path), 'utf8');
  const registry = source.match(/const SUPPORTED_BATTLE_SIM_BOOKS = new Set\(\[([\s\S]*?)\]\)/)[1];
  const ids = [...registry.matchAll(/\d+/g)].map(match => Number(match[0])).sort((a, b) => a - b);
  assert.deepEqual([...simulatorIds].sort((a, b) => a - b), ids, 'every supported simulator has exactly one translation file');
}
for (const [key, value] of Object.entries(en.table)) {
  const params = Object.fromEntries([...value.matchAll(/\{(\w+)\}/g)].map(match => [match[1], '[' + match[1] + ']']));
  assert.equal(en.api.t(key, params), value.replace(/\{(\w+)\}/g, (_, name) => params[name] ?? '{' + name + '}'), key);
}
assert.equal(en.api.t('missing.key'), 'missing.key');
en.api.setTranslationOverride('test.params', '{zero}|{no}|{empty}|{nil}|{missing}|{a-b}');
assert.equal(en.api.t('test.params', { zero: 0, no: false, empty: '', nil: null }), '0|false||null|{missing}|{a-b}');
en.api.setTranslationOverride('app.tagline', 'Custom {name}');
assert.equal(en.api.t('app.tagline', { name: 'tagline' }), 'Custom tagline');
en.api.setTranslationOverride('app.tagline', '');
assert.equal(en.api.t('app.tagline'), '', 'empty override takes priority');
en.api.setTranslationOverride('app.tagline', null);
assert.equal(en.api.t('app.tagline'), en.table['app.tagline'], 'null override falls back');
const runtime = await en.load('i18n/runtime.js');
assert.equal(en.api.t, runtime.t, 'facade and direct runtime share function identity');
runtime.setTranslationOverride('app.title', 'Same shared override');
assert.equal(en.api.t('app.title'), 'Same shared override');

for (const [selector, datasetKey, target, key] of [
  ['[data-i18n]', 'i18n', 'textContent', 'books.title'],
  ['[data-i18n-placeholder]', 'i18nPlaceholder', 'placeholder', 'ph.authors'],
  ['[data-i18n-title]', 'i18nTitle', 'title', 'title.user_guide'],
  ['[data-i18n-tooltip]', 'i18nTooltip', 'tooltip', 'bonus_gc.tooltip_empty'],
]) {
  const el = { dataset: { [datasetKey]: key } };
  en.selectors.set(selector, [el]);
  en.api.applyTranslations();
  assert.equal(target === 'tooltip' ? el.dataset.tooltip : el[target], en.api.t(key));
}
assert.equal(en.document.title, 'Same shared override');
assert.equal(en.document.documentElement.lang, 'en');
const unknown = await environment('unavailable-language');
const unknownLazy = await unknown.load('i18n/battlesim.js');
for (const id of simulatorIds) await unknownLazy.loadBattleSimTranslations(id);
assert.equal(hash(original.map(([key]) => [key,unknown.api.t(key)])),hash(original),'unknown language falls back to English for every source string');
for (const key of Object.keys(unknown.table)) assert.equal(unknown.api.t(key), unknown.table[key]);
unknown.api.applyTranslations();
assert.equal(unknown.document.documentElement.lang, 'unavailable-language', 'stored language behavior unchanged');
assert.equal(unknown.document.title, unknown.table['app.title']);
const unset = await environment(null);
unset.api.applyTranslations();
assert.equal(unset.document.documentElement.lang, 'en');
