localStorage.setItem('gamebook_lang','en');
const enemies=RAIDERS_ENEMIES;let interceptedSaves=0,rosterLoads=0;
globalThis.fetch=async(url,options={})=>{
  if(String(url)==='/api/books/1288/enemies'){rosterLoads++;return new Response(JSON.stringify(enemies),{status:200});}
  if(String(url)==='/api/books/1288/state'&&options.method==='PUT'){interceptedSaves++;return new Response('{}',{status:200});}
  if(String(url)==='/api/items/8')return new Response(JSON.stringify({id:8,name:'Rope'}),{status:200});
  throw Error('Unexpected network request '+url);
};
const app=await import('REPO/public/js/core/state.js');
const {loadBattleSimTranslations}=await import('REPO/public/js/i18n/battlesim.js');
const {prepareBattleSimLayout}=await import('REPO/public/js/battlesim/layout.js');
const {createDestinySession}=await import('REPO/public/js/battlesim/engines/destinyquest/session.js');
await loadBattleSimTranslations(1288);app.setCurrentBookId(1288);
const hero={speed:100,brawn:20,magic:10,armour:20,health:1000,maxHealth:1000};
const run={startedAt:1,path:[1],notebook:'keep',inventory:[{itemId:8,qty:2}],equipment:{head:{itemId:9,label:'Hat'}},sim1286:{keep:true},sim1288:createDestinySession({setup:{hero,abilities:{haste:1,burn:1,charm:1}}})};
app.state.playthroughs=[run];app.state.activePtIndex=0;
const shared=JSON.stringify([run.inventory,run.equipment,run.notebook,run.sim1286]);
const entry=await import('REPO/public/js/battlesim/battlesim1288.js');
await entry.loadData();entry.init();entry.setVisible(true);
const el=key=>document.getElementById('sim1288-'+key),data=()=>run.sim1288;
let scenarios=0;const check=(value,message)=>{if(!value)throw Error(message);scenarios++;};
const click=key=>{if(!el(key))throw Error('Missing control '+key);el(key).click();};
const change=(key,value)=>{el(key).value=value;el(key).dispatchEvent(new Event('change',{bubbles:true}));};

click('btn');prepareBattleSimLayout(el('overlay'));
check(el('overlay').textContent.includes('The Raiders of Dune Sea'),'native title translated');
check(el('encounter').options.length===123,'122 source presets plus editable custom fight');
check(el('owned').querySelector('select').options.length===193,'all 193 source abilities');
check(el('petPreset').options.length===8,'six source companions plus none/custom');
check(!el('allyEnabled'),'no two-hero setup in Raiders');
const {getRaidersPetCatalog}=await import('REPO/public/js/battlesim/engines/destinyquest/raiders.js');
const {getRoster}=await import('REPO/public/js/battlesim/books/1288/definition.js');
const pets=getRaidersPetCatalog(getRoster());
const reset=(section,options={})=>{run.sim1288=createDestinySession({setup:{hero:{...hero,...options.hero},section,pet:options.pet,abilities:options.abilities||{},encounterOptions:options.encounterOptions||{}},character:options.character||{}});entry.render();};
reset('735',{pet:{...pets.find(pet=>pet.id==='fire-sprite'),stance:'passive',target:0},abilities:{'volatile-link':1}});
click('start');check(data().fight?.pet?.maxHealth===9,'pet setup reaches native factory with one Health bonus');
check(data().fight?.abilities.conflagration===1,'companion modifier is usable without equipping it on the hero');
check(el('roundPetStance'),'round stance control exists');change('roundPetStance','aggressive');click('next');
check(data().fight.pet.stance==='aggressive','round stance saves through real application state');
check(el('combatants').textContent.includes('Fire sprite: 9/9'),'companion visible alongside combatants');
reset('542',{character:{sourceCounters:{grundyRounds:3}}});check(el('source-grundyRounds').value==='3','recorded source rounds populate context input');click('start');check(data().fight.opponents[0].armour===1,'source base Armour preserved');
const {destinyStat}=await import('REPO/public/js/battlesim/engines/destinyquest/effects.js');check(destinyStat(data().fight,0,'armour')===3,'rounded context Armour applied through book UI');
reset('442',{hero:{magic:10}});click('start');el('manualDice').value='1 1 3';click('next');check(el('arcaneAmount'),'Magic surge amount appears for challenge');change('arcaneAmount','2');click('book-action');check(data().fight.hero.health===992,'surge spends eight Health through native session');click('next');check(data().fight.opponents[1].health===25,'boosted control damages Dryads');click('next');check(data().fight.opponents[0].health===15,'backlash damages druid');check(destinyStat(data().fight,'hero','magic')===10,'backlash restores spent Magic');
reset('492');click('start');check(el('combatants').textContent.includes('Shield Health: 20'),'magnetite Health shown separately');check(el('target').options.length===2,'friendly wind shield cannot be targeted');
reset('697');click('start');check(el('roundAid-harpoon'),'harpoon offered at round start');el('roundAid-harpoon').checked=true;click('next');check(data().fight.opponents[0].health===190,'harpoon source option reaches start-round action');
reset('735',{hero:{brawn:0},abilities:{charm:1,burn:1}});click('start');for(let i=0;i<6;i++)click('next');check(data().fight.phase==='ability-choice','Soul Steal choice reached');check([...el('choiceAbility').options].some(option=>option.value==='charm'),'unplayed ability offered');change('choiceAbility','charm');click('sacrifice-choice');check(data().fight.used.charm===1,'restorable stolen charge recorded');
reset('16',{abilities:{'fists-of-the-tempest':1}});click('start');for(let i=0;i<3;i++)click('next');change('useAbility','fists-of-the-tempest');el('manualDice').value='1 2 3';click('ability');check(el('allocated-0')&&el('allocated-2')&&!el('next'),'allocated dice expose one clear acceptance action');click('resolve-allocated');check(data().fight.opponents[0].health===44,'allocation choices reach native resolver');
check(JSON.stringify([run.inventory,run.equipment,run.notebook,run.sim1286])===shared,'shared player inventory/equipment/notebook/other simulator preserved');
check(!el('overlay').textContent.includes('battlesim1288.'),'untranslated: '+(el('overlay').textContent.match(/battlesim1288\.[A-Za-z.]+/g)||[]).join(', '));
check(document.documentElement.scrollWidth<=innerWidth,'no viewport overflow');
document.body.dataset.test=JSON.stringify({width:innerWidth,scenarios,rosterLoads,interceptedSaves,actualBookEntry:true,panelOnly:true,playerDatabaseWrites:0});
