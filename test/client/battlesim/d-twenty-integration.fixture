// Exercise the d20 family through the application's actual lazy loaders.
localStorage.setItem('gamebook_lang','LANGUAGE');
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const seeds=ROSTER_SEEDS,check=(value,label)=>{if(!value)throw Error(label);};
window.fetch=async(url)=>new Response(JSON.stringify(seeds[String(url).match(/\/api\/books\/(\d+)\/enemies$/)?.[1]]??{}),{headers:{'Content-Type':'application/json'}});
console.warn=(message,error)=>{if(error instanceof Error)throw error;};
const run={startedAt:1,path:[1],inventory:[{name:'Keep me',qty:2}],equipment:{weapon:'Original'},sim1608:{unchanged:true}};
app.setCurrentBookId(1620);app.state.playthroughs=[run];app.state.activePtIndex=0;
if('MODE'==='mobile')await mobile.openSimForBook(1620);else await desktop.showBattleSimForBook(1620);
const module=await import('REPO/public/js/battlesim/battlesim1620.js');
const trigger=document.getElementById('sim1620-btn');if('MODE'!=='mobile')trigger.click();
const overlay=document.getElementById('sim1620-overlay'),left=overlay.querySelector('.bsim-col-left');
const controls=()=>document.getElementById('sim1620-controls'),data=()=>run.sim1620;
const field=(root,key)=>root.querySelector('[data-field="'+key+'"]');
const button=(root,key)=>root.querySelector('[data-action="'+key+'"]');
const change=(input,value)=>{input.value=String(value);input.dispatchEvent(new Event('change',{bubbles:true}));};
const player=left.querySelector('details');
const fill=(root,values)=>{for(const [key,value]of Object.entries(values))field(root,key).value=String(value);};
const choose=key=>change(field(left,'preset'),key);
const start=()=>button(left,'start').click();
const cancel=()=>{button(left,'cancel').click();document.getElementById('confirm-ok').click();};
const preserved=JSON.stringify([run.path,run.inventory,run.equipment,run.sim1608]);
fill(player,{hp:80,maxHp:80,ac:20,bonus:100,formula:'100',strengthScore:18});
choose('naga');
check(field(left,'preset').options.length===19,'all18source presets plus custom');
check(left.querySelector('[data-stat="count"]').disabled,'source preset count locked');
start();check(data()?.fight.status==='fighting','source encounter starts through panel');
check(data().fight.groups[0].hp===58&&data().fight.groups[0].ac===15,'source naga stats');
check(field(left,'preset').disabled&&field(player,'hp').disabled,'setup locked during combat');
check(!overlay.querySelector('.bsim-col-right input'),'results column contains no setup fields');
field(controls(),'manualDice').value='20';const staleAttack=button(controls(),'attack');staleAttack.click();
check(data().fight.status==='win'&&data().history.length===1,'victory saved once');
const won=JSON.stringify(data());staleAttack.click();module.render();check(JSON.stringify(data())===won,'stale attack and repeated render preserve outcome');
choose('arena-skeleton-6');start();check(data().fight.groups.length===6,'source arena group size');cancel();
choose('tgozur-east');fill(player,{hp:80,maxHp:80,ac:20,bonus:0,formula:'1'});start();
change(field(controls(),'combatant'),'enemy0');
const originalRandom=Math.random;Math.random=()=>0.9;button(controls(),'chooseAttack').click();Math.random=originalRandom;
check(field(controls(),'attack').value==='4','source random selection reaches fourth ray');
field(controls(),'manualDice').value='20';button(controls(),'attack').click();
check(data().fight.events.at(-1).save.success&&data().fight.player.hp===80,'ray save resolved through real controls');cancel();
choose('flameskull');start();change(field(controls(),'combatant'),'enemy0');
change(field(controls(),'spell'),'blur');button(controls(),'cast').click();
check(data().fight.groups[0].spellSlots['2']===1&&data().fight.groups[0].pendingCast.spell==='blur','source spell spends one slot');
button(controls(),'addEffect').click();const effect=controls().querySelector('fieldset');
change(field(effect,'effect'),'condition');change(field(effect,'target'),'enemy0');change(field(effect,'condition'),'blurred');
fill(effect,{concentrationMinimum:0,duration:10});button(controls(),'resolveSpell').click();
check(!data().fight.groups[0].pendingCast&&data().fight.groups[0].conditions.some(row=>row.name==='blurred'&&row.concentrationMinimum===0),'atomic source spell effect applied');
change(field(controls(),'combatant'),'player');field(controls(),'manualDice').value='1,20';button(controls(),'attack').click();
check(data().fight.events.at(-1).check.mode==='disadvantage'&&data().fight.groups[0].hp===50,'blur alters actual attack controls');cancel();
choose('');
const custom=[...left.querySelectorAll('details')].find(root=>root.querySelector(':scope > summary')?.textContent.includes('Custom opponent'));
field(custom,'formula').value='1';
const opponent=left.querySelector('.bsim-opponent-row');
for(const [key,value]of Object.entries({hp:3,ac:10,bonus:0,count:1}))opponent.querySelector('[data-stat="'+key+'"]').value=value;
opponent.querySelector('[role="combobox"]').value='Training foe';
fill(player,{hp:80,maxHp:80,ac:20,bonus:100,formula:'100'});start();
check(data().fight.opponent.name==='Training foe'&&data().fight.groups[0].hp===3,'ordinary custom encounter needs no preset');
field(controls(),'manualDice').value='20';button(controls(),'attack').click();check(data().fight.status==='win','custom encounter can finish');
choose('naga');button(left,'addCompanion').click();
const companion=[...left.querySelectorAll('[data-field="name"]')].find(input=>input.value==='Companion').closest('details');
fill(companion,{name:'Friend',hp:20,maxHp:20,ac:12,bonus:2,formula:'1d6'});start();
check(data().fight.companions.length===1&&data().fight.companions[0].name==='Friend','companion setup works');
const live=JSON.stringify(data());module.render();check(JSON.stringify(data())===live,'active render preserves fight');
button(left,'cancel').click();app.setCurrentBookId(9999);document.getElementById('confirm-ok').click();
check(JSON.stringify(data())===live,'stale delayed cancel cannot mutate old book');
app.setCurrentBookId(1620);trigger.click();cancel();
const old=JSON.stringify(data());app.state.playthroughs=[{startedAt:2,path:[1]}];app.state.activePtIndex=0;
start();check(app.currentPlaythrough().sim1620===undefined,'stale setup cannot write another run');
app.state.playthroughs=[run];app.state.activePtIndex=0;trigger.click();check(JSON.stringify(data())===old,'original run retained');
check(JSON.stringify([run.path,run.inventory,run.equipment,run.sim1608])===preserved,'story/inventory/equipment/other simulator untouched');
for(const input of overlay.querySelectorAll('input'))check(input.type==='checkbox'||input.autocomplete==='off','browser autocomplete disabled');
for(const key of overlay.textContent.match(/battlesim1620\.[\w.]+/g)??[])throw Error('Missing translation '+key);
check(overlay.querySelector('.inv-modal').scrollWidth<=overlay.querySelector('.inv-modal').clientWidth+2,'no horizontal dialog overflow');
document.body.dataset.test=JSON.stringify({mode:'MODE',language:'LANGUAGE',width:innerWidth,sourcePresets:18,
  sourceOpponentProfiles:11,sourceAndCustomCombat:true,rayAndSpellControls:true,companions:true,runAndBookIsolation:true,
  repeatedRenderPreservesState:true,autocompleteOff:true,productionWrites:0});
