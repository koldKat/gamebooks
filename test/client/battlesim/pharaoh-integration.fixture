// Exercise database presets and run-bound actions through both actual loaders.
localStorage.setItem('gamebook_lang','LANGUAGE');
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const seeds=ROSTER_SEEDS,check=(value,label)=>{if(!value)throw Error(label);};
window.fetch=async(url)=>new Response(JSON.stringify(seeds[String(url).match(/\/api\/books\/(\d+)\/enemies$/)?.[1]]??{}),{headers:{'Content-Type':'application/json'}});
console.warn=(message,error)=>{if(error instanceof Error)throw error;};
const run={startedAt:1,path:[1],inventory:[{name:'Kept',qty:2}],equipment:{weapon:'Original'},sim1608:{unchanged:true}};
app.setCurrentBookId(390);app.state.playthroughs=[run];app.state.activePtIndex=0;
if('MODE'==='mobile')await mobile.openSimForBook(390);else await desktop.showBattleSimForBook(390);
const module=await import('REPO/public/js/battlesim/battlesim390.js');
const source=await import('REPO/public/js/battlesim/books/390/definition.js');
const trigger=document.getElementById('sim390-btn');if('MODE'!=='mobile')trigger.click();
const overlay=document.getElementById('sim390-overlay'),left=overlay.querySelector('.bsim-col-left');
const controls=()=>document.getElementById('sim390-controls'),data=()=>run.sim390;
const field=(root,key)=>root.querySelector('[data-field="'+key+'"]');
const button=(root,key)=>root.querySelector('[data-action="'+key+'"]');
const start=()=>button(left,'start').click();
const cancel=()=>{button(left,'cancel').click();document.getElementById('confirm-ok').click();};
const stats=()=>{field(left,'currentVigour').value=100;field(left,'currentPsi').value=10;field(left,'currentAgility').value=10;};
const roll=(a,b)=>{field(controls(),'die1').value=a;field(controls(),'die2').value=b;button(controls(),'roll').click();};
const choose=entry=>{
  const input=left.querySelector('[role="combobox"]');input.value='§'+entry.section+')';input.dispatchEvent(new FocusEvent('focus'));input.dispatchEvent(new Event('input',{bubbles:true}));
  const option=[...left.querySelectorAll('[role="option"]')].find(node=>node.textContent.includes('(§'+entry.section+')'));
  check(option,'source encounter searchable '+entry.section);option.dispatchEvent(new PointerEvent('pointerdown',{bubbles:true,cancelable:true}));
};
const preserved=JSON.stringify([run.path,run.inventory,run.equipment,run.sim1608]);
check(source.ENCOUNTERS.length===35,'complete source roster');
for(const entry of source.ENCOUNTERS){
  choose(entry);stats();const inputs=[...left.querySelectorAll('[data-stat="hp"]')];
  check(inputs.length===entry.profiles.length,'source group size');
  for(const [i,input]of inputs.entries()){
    check(entry.requiresCurrentHp?input.value==='':Number(input.value)===entry.profiles[i].hp,'printed or explicit current health');
    if(entry.requiresCurrentHp)input.value=Math.max(1,entry.profiles[i].hp-1);
  }
  start();check(data().fight.status==='fighting'&&data().fight.opponent.key===entry.key,'source fight starts');
  check(data().fight.opponent.profiles.every((profile,index)=>profile.unit===entry.profiles[index].unit),'source combat units preserved');
  check(field(left,'currentVigour').disabled&&left.querySelector('[role="combobox"]').disabled,'setup locked');
  check(!overlay.querySelector('.bsim-col-right input,.bsim-col-right button'),'read-only results');
  const active=JSON.stringify(data());module.render();check(JSON.stringify(data())===active,'render preserves fight');
  cancel();check(data().fight.status==='cancelled','cancellation recorded');
}
const preset=section=>{choose(source.ENCOUNTERS.find(entry=>entry.section===String(section)));stats();start();};
preset(63);roll(6,6);roll(6,6);check(data().fight.status==='win'&&data().fight.enemies[0].hp===3,'surrender preserves health');
preset(87);roll(6,6);roll(6,6);check(data().fight.status==='win'&&data().fight.enemies[1].hp===6,'surviving foe flees');
choose(source.ENCOUNTERS.find(entry=>entry.section==='87'));stats();field(left,'currentVigour').value=8;start();roll(2,2);
check(data().fight.status==='loss'&&data().fight.player.hp===5,'overpowered below six');
for(const section of [125,145,284]){preset(section);while(data().fight.status==='fighting')roll(6,6);check(data().fight.status==='paused','first foe stage pauses');}
preset(154);roll(1,2);check(data().fight.status==='paused'&&data().fight.enemies[0].hp===15,'worm pauses with unchanged health');
for(const section of [214,296]){preset(section);roll(6,6);check(data().fight.status==='win'&&data().fight.enemies[0].hp===12,'printed immediate victory');}
check(field(left,'gauntlet').closest('label').hidden,'unrelated item modifier hidden');
button(left,'custom').click();stats();left.querySelector('[role="combobox"]').value='Training foe';left.querySelector('[data-stat="hp"]').value=3;start();
const before=JSON.stringify(data());field(controls(),'die1').value=6;button(controls(),'roll').click();
check(JSON.stringify(data())===before,'partial manual dice rejected');document.getElementById('confirm-ok')?.click();
roll(6,6);check(data().fight.status==='win','custom fight requires no preset');
stats();start();const live=JSON.stringify(data());button(left,'cancel').click();app.setCurrentBookId(9999);document.getElementById('confirm-ok').click();
check(JSON.stringify(data())===live,'delayed cancel respects book');app.setCurrentBookId(390);trigger.click();cancel();
const old=JSON.stringify(data());app.state.playthroughs=[{startedAt:2,path:[1]}];app.state.activePtIndex=0;start();
check(app.currentPlaythrough().sim390===undefined,'stale setup respects run');app.state.playthroughs=[run];app.state.activePtIndex=0;trigger.click();
check(JSON.stringify(data())===old,'original run retained');check(JSON.stringify([run.path,run.inventory,run.equipment,run.sim1608])===preserved,'unrelated state preserved');
for(const input of overlay.querySelectorAll('input:not([type="checkbox"])'))check(input.autocomplete==='off','browser autocomplete disabled');
check(!/battlesim390\.[\w.]+/.test(overlay.textContent),'translated labels');
check(overlay.querySelector('.inv-modal').scrollWidth<=overlay.querySelector('.inv-modal').clientWidth+2,'no dialog overflow');
document.body.dataset.test=JSON.stringify({mode:'MODE',language:'LANGUAGE',width:innerWidth,sourceEncounters:35,currentHealthRequired:true,customCombat:true,groupPauses:true,runAndBookIsolation:true,productionWrites:0});
