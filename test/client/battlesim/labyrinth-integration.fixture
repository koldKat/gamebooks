// Verify source encounter presets through the real desktop and mobile loaders.
localStorage.setItem('gamebook_lang','LANGUAGE');
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const seeds=ROSTER_SEEDS,check=(v,label)=>{if(!v)throw Error(label);};
window.fetch=async url=>new Response(JSON.stringify(seeds[String(url).match(/\/api\/books\/(\d+)\/enemies$/)?.[1]]??{}),{headers:{'Content-Type':'application/json'}});
const run={startedAt:1,path:[1],inventory:[{name:'Kept',qty:2}]};
app.setCurrentBookId(286);app.state.playthroughs=[run];app.state.activePtIndex=0;
if('MODE'==='mobile')await mobile.openSimForBook(286);else await desktop.showBattleSimForBook(286);
const module=await import('REPO/public/js/battlesim/battlesim286.js');
const trigger=document.getElementById('sim286-btn');if('MODE'!=='mobile')trigger.click();
const overlay=document.getElementById('sim286-overlay'),d=run.sim286;
Object.assign(d.player,{life:100,lifeMax:100,weaponKey:'glove'});d.lifeRollCount=1;d.aeRolled=true;module.render();
const choose=async id=>{
 const input=document.getElementById('sim286-enemy-pick');input.value='';input.dispatchEvent(new FocusEvent('focus'));
 for(let i=0;i<30&&!document.getElementById('sim286-enemy-pick-dropdown').children.length;i++)await new Promise(r=>setTimeout(r,10));
 await new Promise(r=>setTimeout(r,10));
 const options=[...document.getElementById('sim286-enemy-pick-dropdown').querySelectorAll('[role="option"]')];check(options.length===24,'all 24 source presets; found '+options.length);
 const name=seeds[286].find(row=>row.id===id)?.name;
 options.find(li=>li.textContent.startsWith(name)).dispatchEvent(new MouseEvent('mousedown',{bubbles:true,cancelable:true}));
};
for(const enemy of seeds[286]){
 await choose(enemy.id);
 check(d.group.hp.length===enemy.stats.encounter.count,'source group size');
 check(d.enemy.fixedDamage===(enemy.stats.encounter.fixedDamage||0),'source fixed damage');
 check(d.player.enemyFirst===!!enemy.stats.encounter.enemyFirst,'source initiative');
 check(document.getElementById('sim286-enemy-extra').disabled,'preset group size fixed');
 const saved=JSON.stringify(d);module.render();check(JSON.stringify(d)===saved,'render preserves selected fight');
}
await choose(217);Math.random=()=>0;document.getElementById('sim286-round').click();
check(d.player.life===85&&d.group.hp.filter(hp=>hp>0).length===5,'miss removes one Shadow and exact 15 life');
Math.random=()=>.2;for(let i=0;i<5;i++)document.getElementById('sim286-round').click();
check(d.history.at(-1).outcome==='win'&&document.getElementById('sim286-round').disabled,'six Shadows resolved once');
await choose(216);d.player.life=100;Math.random=()=>.5;module.render();
for(let i=0;i<3;i++)document.getElementById('sim286-round').click();
const retreat=document.getElementById('sim286-retreat');check(!retreat.hidden&&!retreat.disabled,'source retreat available');retreat.click();
check(JSON.stringify(d.group.hp)==='[0,18,18,18]'&&!document.getElementById('sim286-heal').disabled,'retreat preserves casualties and permits recovery');
await choose(216);d.player.life=200;d.player.lifeMax=200;Math.random=()=>.999;module.render();
for(let i=0;i<8;i++)document.getElementById('sim286-round').click();
check(d.group.hp.every(hp=>hp===0)&&!document.getElementById('sim286-heal').disabled,'victory permits recovery');
const woundedLife=d.player.life;document.getElementById('sim286-heal-amount').value='5';document.getElementById('sim286-heal').click();
check(d.player.life===woundedLife+5&&document.getElementById('sim286-heal').disabled,'post-victory healing applies once');
for(const gadget of ['laser','blaster']){
 await choose(216);d.player.life=200;module.render();
 overlay.querySelector(`[data-tech="${gadget}"]`).click();
 check(d.enemy.hp===8&&d.roundsThisBattle===1,'gadget damage starts combat');
 check(document.getElementById('sim286-heal').disabled&&document.getElementById('sim286-sleep').disabled,'no recovery during gadget combat');
 if(gadget==='blaster'){
  overlay.querySelector('[data-tech="blaster"]').click();
  check(d.roundsThisBattle===2&&d.group.hp.filter(hp=>hp>0).length===3,'charged follow-up continues group combat');
 }
}
await choose(215);d.player.life=7;module.render();check(!document.getElementById('sim286-round').disabled,'seven still fights for chief');
d.player.life=6;module.render();check(document.getElementById('sim286-round').disabled,'below seven ends chief fight');
check([...overlay.querySelectorAll('[data-tech]')].every(b=>b.disabled),'bare-hand fight blocks equipment gadgets');
check(JSON.stringify(run.path)==='[1]'&&run.inventory[0].qty===2,'story state preserved');
check(!overlay.textContent.match(/battlesim286\.[\w.]+/),'translations loaded');
check(overlay.querySelector('.inv-modal').scrollWidth<=overlay.querySelector('.inv-modal').clientWidth+2,'no horizontal overflow');
document.body.dataset.test=JSON.stringify({mode:'MODE',language:'LANGUAGE',width:innerWidth,presets:24,groupRules:true,shadows:true,retreat:true,earlySurrender:true,productionWrites:0});
