// Exercise printed combat rules through the real desktop and mobile lazy loaders.
localStorage.setItem('gamebook_lang','LANGUAGE');
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const seeds=ROSTER_SEEDS,check=(value,label)=>{if(!value)throw Error(label);};
window.fetch=async(url)=>new Response(JSON.stringify(seeds[String(url).match(/\/api\/books\/(\d+)\/enemies$/)?.[1]]??{}),{headers:{'Content-Type':'application/json'}});
console.warn=(message,error)=>{if(error instanceof Error)throw error;};
const run={startedAt:1,path:[1],inventory:[{name:'Keep me',qty:2}],equipment:{weapon:'Original'},sim1608:{unchanged:true}};
app.setCurrentBookId(1621);app.state.playthroughs=[run];app.state.activePtIndex=0;
if('MODE'==='mobile')await mobile.openSimForBook(1621);else await desktop.showBattleSimForBook(1621);
const module=await import('REPO/public/js/battlesim/battlesim1621.js');
const trigger=document.getElementById('sim1621-btn');if('MODE'!=='mobile')trigger.click();
const overlay=document.getElementById('sim1621-overlay'),left=overlay.querySelector('.bsim-col-left');
const controls=()=>document.getElementById('sim1621-controls'),data=()=>run.sim1621;
const field=(root,key)=>root.querySelector('[data-field="'+key+'"]');
const button=(root,key)=>root.querySelector('[data-action="'+key+'"]');
const change=(input,value)=>{input.value=String(value);input.dispatchEvent(new Event('change',{bubbles:true}));};
const player=left.querySelector('details');
const fill=(root,values)=>{for(const [key,value]of Object.entries(values))field(root,key).value=String(value);};
const choose=key=>change(field(left,'preset'),key);
const start=()=>button(left,'start').click();
const cancel=()=>{button(left,'cancel').click();document.getElementById('confirm-ok').click();};
const as=key=>change(field(controls(),'combatant'),key);
const random=(value,fn)=>{const previous=Math.random;try{Math.random=()=>value;fn();}finally{Math.random=previous;}};
const preserved=JSON.stringify([run.path,run.inventory,run.equipment,run.sim1608]);
fill(player,{hp:80,maxHp:80,ac:20,bonus:100,formula:'100',strengthScore:18});
choose('bullywug-bank');check(field(left,'preset').options.length===13,'12 source presets plus custom');
check(left.querySelector('[data-stat="count"]').disabled,'source count locked');start();
check(data().fight.groups[0].hp===53&&data().fight.groups[0].ac===13,'printed bullywug stats');
check(field(left,'preset').disabled&&field(player,'hp').disabled,'combat locks setup');
check(!overlay.querySelector('.bsim-col-right input'),'results column has no setup controls');
field(controls(),'manualDice').value='20';const stale=button(controls(),'attack');stale.click();
check(data().fight.status==='win'&&data().history.length===1,'victory saved once');
const won=JSON.stringify(data());stale.click();module.render();check(JSON.stringify(data())===won,'stale action and render preserve outcome');
choose('swords');start();check(data().fight.groups.length===2,'two printed swords');cancel();
choose('unseen-wounded');fill(player,{hp:80,maxHp:80,ac:20,bonus:0,formula:'1',athletics:20});start();as('player');
check(data().fight.player.hp===80&&data().fight.player.conditions.some(c=>c.name==='poisoned'&&c.remainingTurns===2),'source poison without repeating story damage');
field(controls(),'manualDice').value='20,20';button(controls(),'tryFlee').click();check(data().fight.status==='fled','printed escape check');
choose('rats');fill(player,{hp:80,maxHp:80,ac:20,bonus:100,formula:'5'});start();as('player');
random(0,()=>button(controls(),'startTurn').click());
field(controls(),'metalWeapon').checked=true;field(controls(),'manualDice').value='20,20';button(controls(),'attack').click();
check(data().fight.groups[0].hp===22&&data().fight.player.attacks[0].damagePenalty===1,'first metal hit corrodes once');
field(controls(),'manualDice').value='20,20';button(controls(),'attack').click();
check(data().fight.groups[0].hp===18&&data().fight.player.attacks[0].damagePenalty===1,'later damage uses corrosion');cancel();
choose('elemental');fill(player,{hp:80,maxHp:80,ac:20,bonus:0,formula:'1'});start();as('enemy0');
change(field(controls(),'distance'),0);random(0,()=>button(controls(),'enterFireSpace').click());
check(data().fight.player.hp===79&&data().fight.player.conditions.some(c=>c.name==='burning'),'fire space ignites');
as('player');random(0,()=>button(controls(),'startTurn').click());check(data().fight.player.hp===78,'burn starts turn');
button(controls(),'douse').click();check(!data().fight.player.conditions.some(c=>c.name==='burning'),'douse ends burning');
as('enemy0');change(field(controls(),'waterUnit'),'gallons');field(controls(),'amount').value='4';button(controls(),'water').click();
check(data().fight.groups[0].hp===51,'printed water damage');cancel();
choose('illusionist');start();as('enemy0');button(controls(),'scriptedInvisibility').click();
check(data().fight.groups[0].spellSlots['4']===0&&data().fight.groups[0].conditions.some(c=>c.name==='invisible'),'printed opening preserves zero fourth-level slots');
button(controls(),'printedMageArmour').click();check(data().fight.groups[0].ac===15&&data().fight.groups[0].spellSlots['1']===2,'armor does not double count AC');
button(controls(),'displacement').click();check(data().fight.groups[0].conditions.some(c=>c.name==='displaced'),'displacement control');
for(let stage=1;stage<=3;stage++){
  field(controls(),'manualDice').value='20';button(controls(),'castPrintedIllusion').click();
  check(data().fight.groups[0].sourceIllusionStage===stage&&data().fight.groups[0].spellSlots['2']===3-stage,'printed illusion stage '+stage);
}
check(data().fight.groups[0].sourceDisplacementReady,'starred illusion recharges displacement');cancel();
choose('mirrormind-seen');fill(player,{hp:80,maxHp:80});start();as('enemy0');
field(controls(),'attackSpell').checked=true;field(controls(),'attackSpell').dispatchEvent(new Event('change',{bubbles:true}));
fill(controls(),{spellAttackBonus:100,originalSpellDamage:10});field(controls(),'manualDice').value='20';
random(.5,()=>button(controls(),'reflectSpell').click());
check(data().fight.player.hp===75&&data().fight.groups[0].sourceReflectionTurn===0,'reflection applies half damage once per turn');
check(button(controls(),'reflectSpell').disabled,'reflection reaction consumed');cancel();
choose('');
const custom=[...left.querySelectorAll('details')].find(root=>root.querySelector(':scope > summary')?.textContent.includes('Custom opponent'));
field(custom,'formula').value='1';const opponent=left.querySelector('.bsim-opponent-row');
for(const [key,value]of Object.entries({hp:3,ac:10,bonus:0,count:1}))opponent.querySelector('[data-stat="'+key+'"]').value=value;
opponent.querySelector('[role="combobox"]').value='Training foe';fill(player,{hp:80,maxHp:80,ac:20,bonus:100,formula:'100'});start();as('player');
check(data().fight.opponent.name==='Training foe'&&data().fight.groups[0].hp===3,'ordinary custom encounter');
field(controls(),'manualDice').value='20,20';button(controls(),'attack').click();check(data().fight.status==='win','custom encounter finishes with retained poison');
choose('bullywug-bank');button(left,'addCompanion').click();
const companion=[...left.querySelectorAll('[data-field="name"]')].find(input=>input.value==='Companion').closest('details');
fill(companion,{name:'Friend',hp:20,maxHp:20,ac:12,bonus:2,formula:'1d6'});start();
check(data().fight.companions.length===1,'companion setup');const live=JSON.stringify(data());module.render();check(JSON.stringify(data())===live,'active render preserves fight');
button(left,'cancel').click();app.setCurrentBookId(9999);document.getElementById('confirm-ok').click();check(JSON.stringify(data())===live,'delayed cancel respects book');
app.setCurrentBookId(1621);trigger.click();cancel();const old=JSON.stringify(data());
app.state.playthroughs=[{startedAt:2,path:[1]}];app.state.activePtIndex=0;start();check(app.currentPlaythrough().sim1621===undefined,'stale setup respects run');
app.state.playthroughs=[run];app.state.activePtIndex=0;trigger.click();check(JSON.stringify(data())===old,'original run retained');
check(JSON.stringify([run.path,run.inventory,run.equipment,run.sim1608])===preserved,'story and other simulator untouched');
for(const input of overlay.querySelectorAll('input'))check(input.type==='checkbox'||input.autocomplete==='off','autocomplete disabled');
for(const key of overlay.textContent.match(/battlesim1621\.[\w.]+/g)??[])throw Error('Missing translation '+key);
check(overlay.querySelector('.inv-modal').scrollWidth<=overlay.querySelector('.inv-modal').clientWidth+2,'no dialog overflow');
document.body.dataset.test=JSON.stringify({mode:'MODE',language:'LANGUAGE',width:innerWidth,sourcePresets:12,sourceOpponentProfiles:7,
  printedSpellAndReflectionControls:true,environmentAndEscapeControls:true,customCombat:true,companions:true,runAndBookIsolation:true,productionWrites:0});
