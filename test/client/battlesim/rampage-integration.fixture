const checks = [], saves = [];
const assert = (value, label) => { if (!value) throw Error(label); checks.push(label); };
window.fetch = async (url, options = {}) => {
  assert(url === '/api/books/856/state' && options.method === 'PUT', 'only intercepted state saves');
  saves.push(JSON.parse(options.body));
  return new Response('{}', {headers: {'Content-Type': 'application/json'}});
};
const app = await import('REPO/public/js/core/state.js');
const desktop = await import('REPO/public/js/battlesim/loader.js');
const mobile = await import('REPO/public/mobile/js/battlesim-dispatch.js');
await import('REPO/public/js/ui-helpers/dialog-escape.js');
const el = key => document.getElementById('sim856-' + key);
const run = {startedAt: 123, path: [1], sim838: {preserved: true}};
app.setCurrentBookId(856); app.state.playthroughs = [run]; app.state.activePtIndex = 0;
assert(!el('overlay') && mobile.hasSim(856), 'registered and lazy');
const sim = await import('REPO/public/js/battlesim/battlesim856.js');
if ('MODE' === 'mobile') await mobile.openSimForBook(856);
else { await desktop.showBattleSimForBook(856); el('btn').click(); }
assert(el('overlay').classList.contains('active'), 'opens through real loader');
assert(el('title').textContent === 'Развилняване', 'Bulgarian source uses Bulgarian without injected translations');
assert(!el('overlay').textContent.includes('battlesim856.'), 'translated initial controls');
const choose = value => { el('encounter').value = value; el('encounter').dispatchEvent(new Event('change')); };
choose('40'); assert(run.sim856.traits.firstHit && run.sim856.encounter === '40', 'alchemist preset');
let name = el('editor').querySelector('[role="combobox"]');
name.value = 'Яда'; name.dispatchEvent(new Event('input', {bubbles: true}));
assert(run.sim856.encounter === '' && !run.sim856.traits.firstHit, 'manual name clears stale route and traits');
name.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowDown', bubbles: true, cancelable: true}));
name.dispatchEvent(new KeyboardEvent('keydown', {key: 'Enter', bubbles: true, cancelable: true}));
assert(run.sim856.encounter === '20' && run.sim856.traits.drain && !run.sim856.traits.firstHit, 'autocomplete synchronizes encounter rules');
choose('40');
name = el('editor').querySelector('[role="combobox"]'); name.focus();
name.dispatchEvent(new KeyboardEvent('keydown', {key: 'Escape', bubbles: true, cancelable: true}));
assert(el('overlay').classList.contains('active') && name.getAttribute('aria-expanded') === 'false', 'Escape dismisses autocomplete only');
el('manual').click(); el('die-one').value = 6; el('die-two').value = 1;
el('start').click();
assert(el('encounter').disabled && el('strength').disabled && el('start').disabled, 'active fight locks setup');
el('round').click();
assert(run.sim856.fight.outcome === 'win' && run.sim856.fight.destination === '29', 'alchemist exits on first wound');
assert(run.sim856.history.length === 1, 'one outcome recorded');
const before = JSON.stringify(run); sim.render(); sim.render();
assert(JSON.stringify(run) === before, 'render does not mutate saved state');
assert(!el('overlay').textContent.includes('battlesim856.'), 'translated results');
assert(run.sim838.preserved, 'unrelated simulator preserved');
choose('');
el('editor').querySelector('.bsim-opponent-editor > button').click();
const added = el('editor').querySelector('fieldset:last-child');
added.querySelector('[role="combobox"]').value = 'Друг противник';
for (const input of added.querySelectorAll('[data-stat]')) input.value = input.dataset.stat === 'hp' ? 4 : 1;
added.querySelector('[role="combobox"]').dispatchEvent(new Event('input', {bubbles: true}));
assert(run.sim856.opponents.length === 2, 'custom fight permits added opponent');
assert(!el('overlay').querySelector('.bsim-col-right input, .bsim-col-right select'), 'setup stays left');
for (const detail of el('overlay').querySelectorAll('details')) detail.open = true;
assert(el('overlay').querySelector('.bsim-modal').getBoundingClientRect().width <= innerWidth, 'modal fits viewport');
assert(document.documentElement.scrollWidth <= innerWidth, 'no horizontal overflow');
el('start').click(); el('flee').click();
assert(document.getElementById('confirm-overlay').classList.contains('active'), 'flee confirms');
const saved = JSON.stringify(run);
app.state.playthroughs = [{startedAt: 456, path: [1]}];
document.getElementById('confirm-ok').click(); sim.render();
assert(!el('overlay').classList.contains('active'), 'run switch closes stale panel');
assert(JSON.stringify(run) === saved && !app.currentPlaythrough().sim856, 'stale confirmation preserves both runs');
await app.saveState(); await new Promise(resolve => setTimeout(resolve, 0));
document.body.dataset.test = JSON.stringify({mode: 'MODE', language: 'LANGUAGE', width: innerWidth, checks: checks.length, saves: saves.length, productionWrites: 0});
