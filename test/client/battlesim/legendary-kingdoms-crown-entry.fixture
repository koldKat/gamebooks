const checks=[],saves=[];
const assert=(value,label)=>{if(!value)throw Error(label);checks.push(label);};
window.fetch=async(url,options={})=>{
  assert(url==='/api/books/690/state'&&options.method==='PUT','only isolated simulator saves');
  saves.push(JSON.parse(options.body));
  return new Response('{}',{status:200,headers:{'Content-Type':'application/json'}});
};
const app=await import('REPO/public/js/core/state.js');
const {loadBattleSimTranslations}=await import('REPO/public/js/i18n/battlesim.js');
app.setCurrentBookId(690);
const run={startedAt:123,path:[1],sim689:{preserved:true}};
app.state.playthroughs=[run];app.state.activePtIndex=0;
await loadBattleSimTranslations(690);
const entry=await import('REPO/public/js/battlesim/battlesim690.js');
assert(entry.definition.id===690&&entry.definition.stateKey==='sim690','standard book identity');
entry.init();entry.setVisible(true);entry.render();
const el=key=>document.getElementById('sim690-'+key);
el('btn').click();
assert(el('overlay').classList.contains('active'),'book facade opens panel');
assert(!el('overlay').textContent.includes('battlesim690.'),'lazy translations present');
assert(el('context').options.length===85,'full personal catalog');
assert(getComputedStyle(el('btn')).borderRadius==='7px','themed trigger');
assert(run.sim690.party.length===0&&saves.length===0,'opening preserves empty party');
el('create').click();
assert(run.sim690.party.length===4&&run.sim690.party[0].skills.fighting===7,'Crown party setup');
el('hero-0-health').value='3';el('applyParty').click();el('start').click();
assert(run.sim690.fight.status==='active'&&run.sim690.fight.party[0].health===3,'current Health retained');
await app.saveState();
assert(saves.at(-1).playthroughs[0].sim690.fight.party[0].health===3,'real serializer retains current fight');
assert(run.sim689.preserved,'other simulator preserved');
for(const details of el('overlay').querySelectorAll('details'))details.open=true;
const body=el('overlay').querySelector('.bsim-body');body.scrollTop=Number.MAX_SAFE_INTEGER;
assert(Math.abs(body.scrollTop-Math.max(0,body.scrollHeight-body.clientHeight))<=1,'bottom reachable');
assert(body.scrollWidth<=body.clientWidth+1&&document.documentElement.scrollWidth<=innerWidth+1,'no overflow');
el('close').dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
assert(!el('overlay').classList.contains('active'),'Escape');
const preserved=JSON.stringify(run);
app.state.playthroughs.push({startedAt:456,path:[1]});app.state.activePtIndex=1;
entry.render();el('btn').click();
assert(app.currentPlaythrough().sim690.party.length===0&&JSON.stringify(run)===preserved,'run isolation');
app.setCurrentBookId(689);entry.render();
assert(!el('overlay').classList.contains('active'),'leaving book closes');
document.body.dataset.test=JSON.stringify({mode:'MODE',width:innerWidth,checks:checks.length,saves:saves.length,
  realBookEntry:true,scope:'BOOK-FACADE-ONLY-NOT-SUPPORTED-REGISTRIES-OR-LIVE-API',productionWrites:0});
