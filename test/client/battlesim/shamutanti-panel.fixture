import { createShamutantiPanel } from 'REPO/public/js/battlesim/engines/shamutanti/panel.js';
import en from 'REPO/public/js/i18n/en/battlesim/battlesim671.js';
import bg from 'REPO/public/js/i18n/bg/battlesim/battlesim671.js';
import { renderReadingMatter } from 'REPO/public/js/reading/content.js';
const checks = [], alerts = [];
const assert = (value, label) => {
  if (!value) { document.body.setAttribute('data-failure', label); throw Error(label); }
  checks.push(label);
};
let locale = en;
const matter = document.createElement('div');
matter.className = 'reading-frontmatter';
assert(renderReadingMatter(matter, 671, '<h2>Spells</h2><table><thead><tr><th scope="col">Code</th><th scope="col">Cost</th></tr></thead><tbody><tr><th scope="row">ZAP</th><td>4</td></tr></tbody></table>', document), 'real browser matter table accepted');
assert(matter.querySelector('tbody td').textContent === '4' && matter.querySelectorAll('th[scope]').length === 3, 'real browser table cells retained');
for (const unsafe of ['<table onclick="bad()"><tr><td>bad</td></tr></table>', '<table><tr><td><scr' + 'ipt>bad()</scr' + 'ipt></td></tr></table>', '<table style="position:fixed"><tr><td>bad</td></tr></table>']) {
  const mount = document.createElement('div');
  assert(!renderReadingMatter(mount, 671, unsafe, document) && mount.children.length === 0, 'unsafe tables rejected atomically');
}
const t = (key, params = {}) => {
  const value = locale[key] ?? { 'battlesim.title': 'Simulator', 'btn.close': 'Close', 'battlesim.no_active_playthrough': 'Start a run' }[key];
  assert(value !== undefined, 'translation: ' + key);
  return value.replace(/\{(\w+)\}/g, (_, name) => params[name] ?? '');
};
let run = { path: [1], sim272: { preserved: true } }, book = 671, saves = 0, confirmation;
const panel = createShamutantiPanel({ document, t, getRun: () => run, getBookId: () => book,
  saveState: () => saves++, showAlert: message => alerts.push(message),
  showConfirm: (_, callback) => confirmation = callback, getButtonRow: () => document.getElementById('buttons') });
const el = key => document.getElementById('sim671-' + key);
const set = (key, value) => el(key).value = String(value);
const click = key => el(key).click();
const change = key => el(key).dispatchEvent(new Event('change', { bubbles: true }));
Math.random = () => .999;
panel.init(); panel.init(); panel.setVisible(true); click('btn');
assert(document.querySelectorAll('#sim671-overlay').length === 1, 'idempotent initialization');
assert(run.sim671.character === null && el('start').disabled, 'opening does not create a character');
assert(document.activeElement === el('close'), 'focus inside dialog');
assert(JSON.stringify(Object.keys(en).sort()) === JSON.stringify(Object.keys(bg).sort()), 'locale parity');
assert(el('context').options.length === 32, 'all named encounters');
assert([...el('context').options].every(item => !/^Section \d/.test(item.textContent)), 'named contexts');
set('role', 'wizard'); click('roll');
assert(run.sim671.character.skill === 10 && run.sim671.character.provisions === 2 && run.sim671.character.gold === 20, 'wizard starting resources');
assert(run.sim671.character.luckCharm === false && !el('luckCharm').checked, 'charm is opt-in equipment');
set('skill', 100); set('skillInitial', 100); set('luck', 0); set('stamina', 10); click('apply');
set('context', 47); change('context'); click('start');
assert(el('roll').disabled && el('apply').disabled && el('meal').disabled, 'active fight locks edits');
assert(el('luckCharm').disabled, 'active fight locks charm changes');
assert(el('janPresent').disabled, 'active fight locks companion changes');
const beforeOverride = JSON.stringify(run.sim671.fight.enemies);
set('enemySkillOverride', 8); click('enemyOverride');
assert(run.sim671.fight.enemySkillOverride === 8 && JSON.stringify(run.sim671.fight.enemies) === beforeOverride, 'enemy override preserves roster and wounds');
set('enemySkillOverride', ''); click('enemyOverride');
assert(run.sim671.fight.enemySkillOverride === null && JSON.stringify(run.sim671.fight.enemies) === beforeOverride, 'clearing override restores printed rules without resetting wounds');
for (let i = 0; i < 3; i++) click('step');
assert(run.sim671.fight.status === 'win' && run.sim671.history.length === 1, 'one victory record');
click('step'); assert(run.sim671.history.length === 1, 'no duplicate reward');
click('meal'); assert(run.sim671.character.stamina === 12 && run.sim671.character.provisions === 1, 'meal survives ended fight');
const preserved = JSON.stringify(run); set('staminaInitial', 0); click('apply');
assert(alerts.length === 1 && JSON.stringify(run) === preserved, 'invalid edits atomic');
alerts.length = 0; set('staminaInitial', 24); click('apply');
set('context', 407); change('context'); click('start');
assert(run.sim671.fight.status === 'allFled' && run.sim671.history.length === 1, 'morale gives no combat reward');
set('context', 123); change('context');
assert(!el('previousSection-row').hidden && !el('nightModifier-row').hidden, 'night fields visible');
set('previousSection', 283); set('nightModifier', 2); click('start');
assert(run.sim671.fight.status === 'noEncounter' && run.sim671.fight.destination === 283, 'night returns to actual caller');
set('context', 388); set('summonCount', 1); change('context');
assert(!el('summonCount-row').hidden && el('previousSection-row').hidden, 'summon settings visible');
click('start');
assert(run.sim671.fight.allies.length === 1 && run.sim671.character.stamina === 7, 'summon entry cost includes prior lightning cost');
click('libra');
assert(run.sim671.character.stamina === 24 && run.sim671.fight.character.libraUsed, 'Libra can restore during combat');
const dice = (...values) => Math.random = () => {
  assert(values.length > 0, 'deterministic handoff die available');
  return (values.shift() - .5) / 6;
};
dice(6, 6, 1, 1); click('step');
dice(1, 1, 6, 6, 6); click('step');
dice(1, 1, 6, 6, 6); click('step');
assert(run.sim671.fight.enemies[0].stamina === 16 && !run.sim671.fight.allies[run.sim671.fight.ally], 'summoned giant wounds enemy before dying');
click('otherSpell'); set('context', 227); change('context'); click('start');
assert(run.sim671.fight.enemies[0].stamina === 16 && run.sim671.history.length === 1, 'new encounter preserves wounded Manticore without phantom reward');
Math.random = () => .999;
click('cancel'); confirmation();
assert(run.sim671.fight.status === 'cancelled' && run.sim671.history.length === 1, 'cancel does not reward');
set('context', 47); set('skill', 1); set('skillInitial', 1); set('luck', 12); click('apply'); click('start'); click('step');
assert(run.sim671.fight.pending && el('step').disabled && el('cancel').disabled && el('libra').disabled, 'pending Luck locks continuation');
assert(el('enemyOverride').disabled && el('enemySkillOverride').disabled, 'pending Luck locks enemy override');
click('luckNo'); assert(!run.sim671.fight.pending && !el('step').disabled, 'damage resolves explicitly');
click('cancel'); const staleCancel = confirmation, old = run;
run = { path: [1] }; staleCancel();
assert(!run.sim671 && old.sim671.fight.status === 'fighting', 'stale confirmation cannot change runs');
panel.render(); assert(run.sim671.character === null, 'new run isolated');
run = old; panel.render(); assert(run.sim272.preserved, 'other simulator unchanged');
click('cancel'); confirmation(); click('roll'); const staleRoll = confirmation;
const snapshot = JSON.stringify(run); book = 272; panel.render(); staleRoll();
assert(JSON.stringify(run) === snapshot && !el('overlay').classList.contains('active'), 'book switch protects state');
book = 671; panel.render(); click('btn');
set('context', 47); set('skill', 100); set('skillInitial', 100); set('luck', 6); el('luckCharm').checked = true; click('apply');
assert(run.sim671.character.luckCharm, 'charm equipment edit persists');
click('start'); dice(1, 1, 1, 1); click('step');
assert(el('luckCharm').disabled && run.sim671.fight.pending, 'pending Luck locks charm setting');
dice(3, 4); click('luckYes');
assert(run.sim671.fight.enemies[0].stamina === 2 && run.sim671.character.luck === 5, 'charm turns roll seven into Lucky six');
click('cancel'); confirmation();
el('janPresent').checked = true; click('apply');
set('context', 388); change('context');
assert(el('start').disabled && el('contextNote').textContent.includes(en['battlesim671.janBlocksSpell']), 'Jan blocks spell start with an explanation');
set('context', 47); change('context');
assert(!el('start').disabled, 'Jan does not block ordinary combat');
el('janPresent').checked = false; click('apply');
set('context', 388); change('context');
assert(!el('start').disabled && !run.sim671.character.janPresent, 'removing Jan restores spell choices');
locale = bg;
for (const spec of el('context').options) { set('context', spec.value); change('context'); }
panel.render();
assert(!el('overlay').textContent.includes('battlesim671.'), 'no visible raw keys');
for (const details of el('overlay').querySelectorAll('details')) details.open = true;
const left = el('overlay').querySelector('.bsim-col-left'); left.scrollTop = 1e6;
assert(Math.abs(left.scrollTop - Math.max(0, left.scrollHeight - left.clientHeight)) < 2, 'bottom reachable');
left.scrollTop = 0; assert(left.scrollTop === 0, 'top reachable');
assert(left.scrollWidth <= left.clientWidth + 1 && document.documentElement.scrollWidth <= innerWidth, 'no horizontal overflow');
el('close').dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
assert(!el('overlay').classList.contains('active'), 'Escape closes');
run = null; click('btn'); assert(alerts.length === 1, 'no run rejected');
assert(saves > 0, 'actions persist');
assert(getComputedStyle(el('btn')).backgroundColor === 'rgba(31, 41, 55, 0.88)', 'button theme');
document.body.setAttribute('data-test', JSON.stringify({ width: innerWidth, checks: checks.length, passed: true }));
