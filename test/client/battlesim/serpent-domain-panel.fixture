const checks=[],saves=[];
const assert=(value,label)=>{if(!value)throw Error(label);checks.push(label);};
window.fetch=async(url,options={})=>{
  assert(url==='/api/books/680/state'&&options.method==='PUT','only simulator saves');
  saves.push(JSON.parse(options.body));
  return new Response('{}',{status:200,headers:{'Content-Type':'application/json'}});
};
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const {SERPENT_FIGHTS}=await import('REPO/public/js/battlesim/engines/fabled-lands/serpent-domain.js');
app.setCurrentBookId(680);
const run={startedAt:123,path:[1],sim679:{preserved:true}};
app.state.playthroughs=[run];app.state.activePtIndex=0;
const mode='MODE',el=key=>document.getElementById('sim680-'+key);
if(mode==='mobile')await mobile.openSimForBook(680);
else {await desktop.showBattleSimForBook(680);el('btn').click();}
const sim=await import('REPO/public/js/battlesim/battlesim680.js');
assert(el('overlay').classList.contains('active'),'real loader opens');
assert(!el('overlay').textContent.includes('battlesim680.'),'translated labels');
assert(el('context').options.length===40&&el('seaContext').options.length===12,'complete source encounters and sea checks');
assert(getComputedStyle(el('btn')).borderRadius==='7px','themed button');
assert(run.sim680.character===null&&saves.length===0,'open creates no character');
el('profession').value='warrior';el('create').click();
assert(run.sim680.character.rank===7&&run.sim680.character.stamina===30,'book-seven defaults');
assert(el('baseCombat').value==='9'&&el('nahual').value==='0','base and spiritual fields');
assert(document.querySelectorAll('#sim680-baseCombat').length===1,'no duplicate extra fields');
el('combat').value='15';el('obfuscation').checked=true;el('apply').click();
assert(run.sim680.character.combat===15&&run.sim680.character.baseCombat===9,'equipment does not alter base');
el('context').value=String(SERPENT_FIGHTS.findIndex(f=>f.section===1196));
el('context').dispatchEvent(new Event('change',{bubbles:true}));
el('obfuscationUse').checked=true;el('start').click();
assert(run.sim680.fight.defence===16&&!run.sim680.character.obfuscation,'Defence and consumed protection');
Math.random=()=>0;el('step').click();
assert(run.sim680.fight.pendingAction==='nyarTrackers'&&el('step').disabled&&!el('pending').hidden,'pending action blocks round');
el('resolveAction').click();
assert(run.sim680.fight.rounds===1&&run.sim680.fight.combatPenalty===4&&!el('step').disabled,'resume preserves round and wounds');
assert(!run.sim680.log.some(line=>line.includes('battlesim680.')),'special events translated');
run.sim680.fight.status='cancelled';sim.renderSim680();
el('hazard').value='967';el('hazard').dispatchEvent(new Event('change',{bubbles:true}));
assert(!el('hazardEntry-row').hidden&&el('hazardLuck-row').hidden,'hazard controls follow selection');
el('seaContext').value='965';el('seaContext').dispatchEvent(new Event('change',{bubbles:true}));
assert(el('safetyFromStorms').disabled,'deliberate tempest rejects blessing in UI');
await app.saveState();assert(saves.at(-1).playthroughs[0].sim680.fight.combatPenalty===4,'special fight state persisted');
assert(run.sim679.preserved,'previous simulator state preserved');
for(const node of el('overlay').querySelectorAll('details'))node.open=true;
const body=el('overlay').querySelector('.bsim-body');body.scrollTop=Number.MAX_SAFE_INTEGER;
assert(Math.abs(body.scrollTop-Math.max(0,body.scrollHeight-body.clientHeight))<=1,'scroll reaches bottom');
assert(document.documentElement.scrollWidth<=innerWidth+1&&body.scrollWidth<=body.clientWidth+1,'no overflow');
el('close').dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
assert(!el('overlay').classList.contains('active'),'Escape closes');
const preserved=JSON.stringify(run);
app.state.playthroughs.push({startedAt:456,path:[1]});app.state.activePtIndex=1;
if(mode==='mobile')await mobile.openSimForBook(680);
else {await desktop.showBattleSimForBook(680);el('btn').click();}
assert(app.currentPlaythrough().sim680.character===null&&JSON.stringify(run)===preserved,'separate run isolation');
document.body.setAttribute('data-test',JSON.stringify({mode,width:innerWidth,checks:checks.length,saves:saves.length,realModules:true,productionWrites:0}));
