const checks=[],saves=[];
const assert=(value,label)=>{if(!value)throw Error(label);checks.push(label);};
window.fetch=async(url,options={})=>{
  assert(url==='/api/books/689/state'&&options.method==='PUT','only isolated simulator saves');
  saves.push(JSON.parse(options.body));
  return new Response('{}',{status:200,headers:{'Content-Type':'application/json'}});
};
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
app.setCurrentBookId(689);
const run={startedAt:123,path:[1],sim680:{preserved:true}};
app.state.playthroughs=[run];app.state.activePtIndex=0;
const mode='MODE',el=key=>document.getElementById('sim689-'+key);
const open=async()=>{
  if(mode==='mobile')await mobile.openSimForBook(689);
  else {await desktop.showBattleSimForBook(689);el('btn').click();}
};
await open();
assert(mobile.hasSim(689),'mobile registered');
assert(el('overlay').classList.contains('active'),'real loader opens');
assert(!el('overlay').textContent.includes('battlesim689.'),'lazy translations');
assert(el('context').options.length===75,'all personal encounters');
assert(getComputedStyle(el('btn')).borderRadius==='7px','themed trigger');
assert(run.sim689.party.length===0&&saves.length===0,'opening preserves empty party');
el('create').click();
assert(run.sim689.party.length===4&&run.sim689.party[0].name==='Sar Jessica Dayne','source party setup');
el('hero-0-health').value='3';el('applyParty').click();
assert(run.sim689.party[0].health===3,'current Health edited');
el('context').value='16';el('context').dispatchEvent(new Event('change',{bubbles:true}));
el('start').click();
assert(run.sim689.fight.status==='active'&&run.sim689.fight.party[0].health===3,'fight carries current Health');
await app.saveState();
assert(saves.at(-1).playthroughs[0].sim689.fight.party[0].health===3,'real state serializer preserves party');
assert(run.sim680.preserved,'other simulator preserved');
for(const details of el('overlay').querySelectorAll('details'))details.open=true;
const body=el('overlay').querySelector('.bsim-body');body.scrollTop=Number.MAX_SAFE_INTEGER;
assert(Math.abs(body.scrollTop-Math.max(0,body.scrollHeight-body.clientHeight))<=1,'bottom reachable');
assert(body.scrollWidth<=body.clientWidth+1&&document.documentElement.scrollWidth<=innerWidth+1,'no overflow');
el('close').dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
assert(!el('overlay').classList.contains('active'),'Escape');
const preserved=JSON.stringify(run);
app.state.playthroughs.push({startedAt:456,path:[1]});app.state.activePtIndex=1;
await open();
assert(app.currentPlaythrough().sim689.party.length===0&&JSON.stringify(run)===preserved,'run isolation');
desktop.hideActiveBattleSim();
app.setCurrentBookId(680);
const module=await import('REPO/public/js/battlesim/battlesim689.js');module.renderSim689();
assert(!el('overlay').classList.contains('active'),'leaving book closes');
document.body.dataset.test=JSON.stringify({mode,width:innerWidth,checks:checks.length,saves:saves.length,realModules:true,productionWrites:0});
