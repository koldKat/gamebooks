const checks = [], saves = [];
const assert = (value, label) => { if (!value) throw Error(label); checks.push(label); };
window.fetch = async (url, options = {}) => {
  assert(url === '/api/books/706/state' && options.method === 'PUT', 'only intercepted state saves');
  saves.push(JSON.parse(options.body));
  return new Response('{}', { status: 200, headers: { 'Content-Type': 'application/json' } });
};
const app = await import('REPO/public/js/core/state.js');
const desktop = await import('REPO/public/js/battlesim/loader.js');
const mobile = await import('REPO/public/mobile/js/battlesim-dispatch.js');
const { t } = await import('REPO/public/js/i18n.js');
const { registerTranslations } = await import('REPO/public/js/i18n/runtime.js');
const { loadBattleSimTranslations } = await import('REPO/public/js/i18n/battlesim.js');
const { ALL_PANEL_OVERLAY_IDS } = await import('REPO/public/js/core/util.js');
const mode = 'MODE', language = 'LANGUAGE', el = key => document.getElementById('sim706-' + key);
assert(!el('overlay'), 'lazy mount');
assert(mobile.hasSim(706) && ALL_PANEL_OVERLAY_IDS.includes('sim706-overlay'), 'registries');
await loadBattleSimTranslations(706);
if (language === 'bg') registerTranslations((await import('REPO/public/js/i18n/bg/battlesim/battlesim706.js')).default);
app.setCurrentBookId(706);
const run = { startedAt: 123, path: [1], sim700: { preserved: true } };
app.state.playthroughs = [run]; app.state.activePtIndex = 0;
const open = async () => {
  if (mode === 'mobile') await mobile.openSimForBook(706);
  else { await desktop.showBattleSimForBook(706); el('btn').click(); }
};
const change = (key, value) => { el(key).value = value; el(key).dispatchEvent(new Event('change')); };
const key = (target, code, name = code.slice(3)) => target.dispatchEvent(new KeyboardEvent('keydown', { code, key: name, bubbles: true }));
await open();
assert(el('overlay').classList.contains('active'), 'actual lazy loader opens');
assert(!el('overlay').textContent.includes('battlesim706.'), 'all translations resolve');
assert(el('title').textContent === t('battlesim706.title'), 'translated title');
assert(run.sim706.character.endurance === 40 && run.sim706.character.silver === 40, 'printed defaults');
key(document.activeElement, 'Escape', 'Escape');
assert(!el('overlay').classList.contains('active'), 'Escape closes');
await open();
assert(document.querySelectorAll('#sim706-overlay').length === 1, 'single mount');
if (mode === 'desktop') {
  key(document.body, 'KeyS', 's'); assert(!el('overlay').classList.contains('active'), 'shortcut closes');
  key(document.body, 'KeyS', 's'); assert(el('overlay').classList.contains('active'), 'shortcut opens');
  key(el('endurance'), 'KeyS', 's'); assert(el('overlay').classList.contains('active'), 'typing is safe');
}
assert(!el('mode') && !el('encounter') && !el('penalty2'), 'narrative helper removed');
const legacy = { outcome: 'win', name: 'Bodyguard', penalties: 2 };
run.sim706.fight = legacy;
const deployment = { А: 6, Б: 3, В: 5, Г: 3, Д: 1, Е: 1, Ж: 7, И: 4, К: 1 };
for (const [point, force] of Object.entries(deployment)) el(point + '-force').value = force;
el('А-pots').value = 5; el('Ж-bows').value = 3;
for (const item of ['whip', 'chestnuts', 'poison']) el('owned-' + item).checked = true;
el('Ж-whip').checked = el('К-chestnuts').checked = el('Д-poison').checked = true;
el('defend').click();
assert(run.sim706.naval.survivors === 8 && run.sim706.naval.remainingPirates === 0, 'complete naval defence');
assert(!el('retakeFields').hidden && el('attackFields').hidden, 'stage two controls');
assert(el('А-force').disabled, 'deployment locked');
assert(el('apply').disabled, 'active naval fight locks character setup');
el('retake').click();
assert(run.sim706.naval.phase === 2 && run.sim706.naval.survivors === 8, 'retaking ship');
el('availablePots').value = 5; el('attack').click(); el('attack').click();
assert(run.sim706.naval.destination === 68 && run.sim706.history.length === 1, 'naval victory once');
assert(JSON.stringify(run.sim706.fight) === JSON.stringify(legacy), 'legacy narrative state preserved without new reward');
assert(run.sim706.character.endurance === 40 && run.sim706.character.silver === 40, 'no invented story rewards or wounds');
assert(JSON.stringify(run.sim700) === '{"preserved":true}', 'other simulator preserved');
await app.saveState();
assert(saves.at(-1).playthroughs[0].sim706.history.length === 1, 'real persistence payload');
const original = JSON.stringify(run);
el('close').click(); await open();
assert(JSON.stringify(run) === original, 'reopening preserves completed state');
for (const details of el('overlay').querySelectorAll('details')) details.open = true;
const left = el('overlay').querySelector('.bsim-col-left');
left.scrollTop = Number.MAX_SAFE_INTEGER;
assert(Math.abs(left.scrollTop - Math.max(0, left.scrollHeight - left.clientHeight)) <= 1, 'bottom reachable');
left.scrollTop = 0; assert(left.scrollTop === 0, 'top reachable');
for (const details of el('overlay').querySelectorAll('details')) details.open = true;
left.scrollTop = Number.MAX_SAFE_INTEGER;
assert(Math.abs(left.scrollTop - Math.max(0, left.scrollHeight - left.clientHeight)) <= 1, 'naval bottom reachable');
assert(document.documentElement.scrollWidth <= innerWidth + 1, 'no horizontal overflow');
app.state.playthroughs.push({ startedAt: 456, path: [1] }); app.state.activePtIndex = 1;
const module = await import('REPO/public/js/battlesim/battlesim706.js'); module.render();
assert(!el('overlay').classList.contains('active'), 'run change closes stale controls');
el('defend').click(); assert(!app.currentPlaythrough().sim706, 'stale controls cannot create state');
await open(); assert(app.currentPlaythrough().sim706.history.length === 0, 'new run isolated');
assert(JSON.stringify(run) === original, 'previous run unchanged');
document.body.dataset.test = JSON.stringify({ mode, language, width: innerWidth, checks: checks.length, saves: saves.length, realModules: true, productionWrites: 0 });
