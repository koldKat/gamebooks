const checks=[],saves=[];
const assert=(value,label)=>{if(!value)throw Error(label);checks.push(label);};
window.fetch=async(url,options={})=>{assert(url==='/api/books/723/state'&&options.method==='PUT','only intercepted state saves');saves.push(JSON.parse(options.body));return new Response('{}',{status:200});};
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const {registerTranslations}=await import('REPO/public/js/i18n/runtime.js');
const {loadBattleSimTranslations}=await import('REPO/public/js/i18n/battlesim.js');
await import('REPO/public/js/ui-helpers/dialog-escape.js');
const mode='MODE',language='LANGUAGE',el=key=>document.getElementById('sim723-'+key);
assert(!el('overlay'),'lazy mount');assert(mobile.hasSim(723),'mobile registry');
await loadBattleSimTranslations(723);
if(language==='bg')registerTranslations((await import('REPO/public/js/i18n/bg/battlesim/battlesim723.js')).default);
app.setCurrentBookId(723);const run={startedAt:123,path:[1],sim722:{preserved:true}};
app.state.playthroughs=[run];app.state.activePtIndex=0;
const open=async()=>{if(mode==='mobile')await mobile.openSimForBook(723);else{await desktop.showBattleSimForBook(723);el('btn').click();}};
const change=(key,value)=>{el(key).value=value;el(key).dispatchEvent(new Event('change'));};
const cancel=()=>{el('cancel').click();assert(document.getElementById('confirm-overlay').classList.contains('active'),'cancel confirmation');document.getElementById('confirm-ok').click();};
await open();assert(el('overlay').classList.contains('active'),'actual lazy entry opens');
assert(!el('overlay').textContent.includes('battlesim723.'),'translated UI');
assert(run.sim723.character===null&&el('start').disabled,'opening never rolls a character');
assert(el('encounter').options.length===77,'all named encounters');
assert([...el('encounter').options].every(option=>!/^(Section|Епизод)\s+\d/.test(option.textContent)),'descriptive encounter names');
el('role').value='wizard';
for(const [key,value] of Object.entries({skill:99,skillInitial:99,stamina:99,staminaInitial:99,luck:12,luckInitial:12,gold:20,provisions:2,mealsToday:0,goblinTeeth:4,giantTeeth:1,pebbles:0,medicines:1,attackModifier:0}))el(key).value=String(value);
el('apply').click();assert(run.sim723.character.stamina===99,'manual stats saved');
el('start').click();assert(el('apply').disabled&&el('encounter').disabled,'active fight locks setup');
for(let n=0;n<4;n++){el('round').click();el('skipLuck').click();}
assert(run.sim723.fight.outcome==='win'&&run.sim723.fight.destination===106,'ordinary fight victory');
assert(run.sim723.history.length===1,'victory recorded once');el('round').click();assert(run.sim723.history.length===1,'no repeated victory');
change('encounter','382');el('hasComponent').checked=true;el('hasComponent').dispatchEvent(new Event('change'));el('start').click();
assert(run.sim723.fight.allies.length===1,'mirror ally starts');assert(!el('round').disabled&&el('escape').disabled,'ally round before escape');
assert(!el('libraRestore').disabled,'Libra available between combat rounds');el('libraRestore').click();
assert(run.sim723.character.libraUsed&&run.sim723.character.stamina===99,'Libra restores the live fighter');
assert(el('libraRestore').disabled,'Libra cannot be invoked twice');
cancel();assert(run.sim723.history.length===1,'cancellation not rewarded');
change('encounter','459');change('summonCount','4');el('start').click();
assert(run.sim723.fight.allies.length===4&&run.sim723.character.goblinTeeth===0,'summoned allies consume teeth once');cancel();
change('encounter','391');assert(el('enemyOrder').value==='1,2','centaur order adapts');el('start').click();assert(run.sim723.fight.enemies.length===2,'confused centaur excluded');cancel();
change('encounter','291');assert(!el('count-row').hidden,'explicit fish count');change('count','2');el('start').click();assert(run.sim723.fight.enemies.length===2,'no invented fish count');cancel();
el('poisoned').checked=true;el('antidote').checked=true;el('apply').click();el('useAntidote').click();
assert(!run.sim723.character.poisoned&&!run.sim723.character.antidote,'antidote control');
const random=Math.random;Math.random=()=>0;try{el('liftEarthSerpent').click();}finally{Math.random=random;}
assert(run.sim723.log.some(line=>line.includes('127')),'lifting control');
el('poisoned').checked=true;el('apply').click();el('nextDay').click();
assert(document.getElementById('confirm-overlay').classList.contains('active'),'poison deadline confirms');
document.getElementById('confirm-cancel').click();assert(!run.sim723.character.dead,'declining deadline preserves character');
const modal=el('overlay').querySelector('.bsim-modal');
assert(modal.getBoundingClientRect().width<=innerWidth,'modal fits viewport');
for(const column of el('overlay').querySelectorAll('.bsim-col')){
  assert(getComputedStyle(column).overflowY==='auto','scrollable column');
  const maximum=Math.max(0,column.scrollHeight-column.clientHeight);column.scrollTop=1e9;
  assert(Math.abs(column.scrollTop-maximum)<2,'column bottom reachable');column.scrollTop=0;
}
assert(document.documentElement.scrollWidth<=innerWidth,'no horizontal overflow');
el('close').focus();el('close').dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true,cancelable:true}));
assert(!el('overlay').classList.contains('active'),'Escape closes through actual handler');await open();
const snapshot=JSON.stringify(run);app.state.playthroughs=[{startedAt:456,path:[1]}];
(await import('REPO/public/js/battlesim/battlesim723.js')).render();
assert(!el('overlay').classList.contains('active'),'run switch closes stale panel');
el('roll').click();assert(JSON.stringify(run)===snapshot&&!app.currentPlaythrough().sim723,'stale controls preserve both runs');
assert(run.sim722.preserved,'unrelated simulator preserved');
document.body.dataset.test=JSON.stringify({mode,language,width:innerWidth,checks:checks.length,saves:saves.length,productionWrites:0});
