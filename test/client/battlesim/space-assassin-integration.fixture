const checks = [], saves = [];
const assert = (value, label) => { if (!value) throw Error(label); checks.push(label); };
Math.random = () => 0;
let imageAccess = false;
window.fetch = async (url, options = {}) => {
  if (url === '/api/books/735/reading-matter') { imageAccess = true; return new Response('{}'); }
  assert(url === '/api/books/735/state' && options.method === 'PUT', 'only intercepted state saves');
  saves.push(JSON.parse(options.body)); return new Response('{}');
};
const imageSrc = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, 'src');
Object.defineProperty(HTMLImageElement.prototype, 'src', { ...imageSrc, set(value) {
  const file = String(value).match(/^\/api\/books\/735\/reading-images\/([a-f0-9]{64}\.png)$/);
  if (file) assert(imageAccess, 'map authorized before loading');
  imageSrc.set.call(this, file ? 'file:///media/koldKat/MediaDrive/.tmp/reading-imports-2026-10-11/735-art-draft/' + file[1] : value);
} });
const app = await import('REPO/public/js/core/state.js');
const desktop = await import('REPO/public/js/battlesim/loader.js');
const mobile = await import('REPO/public/mobile/js/battlesim-dispatch.js');
const { registerTranslations } = await import('REPO/public/js/i18n/runtime.js');
const { loadBattleSimTranslations } = await import('REPO/public/js/i18n/battlesim.js');
await import('REPO/public/js/ui-helpers/dialog-escape.js');
const mode = 'MODE', language = 'LANGUAGE', el = key => document.getElementById('sim735-' + key);
assert(!el('overlay') && mobile.hasSim(735), 'lazy entry and mobile registry');
await loadBattleSimTranslations(735);
if (language === 'bg') registerTranslations((await import('REPO/public/js/i18n/bg/battlesim/battlesim735.js')).default);
app.setCurrentBookId(735);
const run = { startedAt: 123, path: [1], sim208: { preserved: true } };
app.state.playthroughs = [run]; app.state.activePtIndex = 0;
const sim = await import('REPO/public/js/battlesim/battlesim735.js');
const open = async () => {
  if (mode === 'mobile') await mobile.openSimForBook(735);
  else { await desktop.showBattleSimForBook(735); el('btn').click(); }
};
const choose = (id, value) => { el(id).value = String(value); el(id).dispatchEvent(new Event('change')); };
const cancel = () => { el('cancel').click(); assert(document.getElementById('confirm-overlay').classList.contains('active'), 'stop confirms'); document.getElementById('confirm-ok').click(); };
await open();
assert(el('overlay').classList.contains('active') && run.sim735.character === null, 'opening does not roll or fight');
el('newCharacter').click();
assert(run.sim735.character.stamina === 14 && run.sim735.character.equipmentBudget === 1, 'printed initial rolls');
assert(el('start').disabled && !el('loadout').hidden, 'starting weapon required');
el('buyLoadout').click();
assert(run.sim735.character.weapon === 'lash' && el('loadout').hidden, 'one-point loadout applied');
el('stamina').value = 8; el('saveCharacter').click();
el('start').click();
assert(run.sim735.fight.player.stamina === 8 && el('encounter').disabled, 'current scores preserved and setup locked');
el('pill').click();
assert(run.sim735.fight.player.stamina === 13 && run.sim735.character.pills === 3, 'pill updates active fight once');
for (let i = 0; i < 3; i++) el('round').click();
assert(run.sim735.fight.outcome === 'win' && run.sim735.history.length === 1, 'ordinary victory once');
const snapshot = JSON.stringify(run); sim.render(); assert(JSON.stringify(run) === snapshot, 'render never changes saved state');
await app.saveState(); await new Promise(resolve => setTimeout(resolve, 0));
assert(saves.some(value => value.playthroughs?.[0]?.sim735?.history?.length === 1), 'history reaches state endpoint');
choose('encounter', 239); el('start').click();
assert(run.sim735.fight.openingPending && run.sim735.character.luck === 6 && el('round').disabled, 'opening Luck paid before guarded volley');
el('opening').click();
assert(!run.sim735.fight.openingPending && !el('round').disabled, 'opening volley resolved'); cancel();
choose('encounter', 359); choose('mode', 'gunfire'); el('start').click();
assert(!run.sim735.fight && run.sim735.history.length === 1 && run.sim735.character.luck === 5, 'lucky plant avoidance is not a win');
choose('encounter', 338); choose('mode', 'gunfire'); choose('enemyWeapon', 'none'); el('start').click();
assert(run.sim735.fight.enemies[0].shots === 0, 'technician ruling is explicit'); cancel();
run.sim735 = { ...run.sim735, character: { ...run.sim735.character, nerveGas: 1 } }; sim.render();
choose('encounter', 108); el('start').click(); el('gas').click();
assert(run.sim735.fight.enemies.every(enemy => enemy.stamina === 3) && run.sim735.character.nerveGas === 0, 'single gas roll and flask consumption'); cancel();
run.sim735 = { ...run.sim735, character: { ...run.sim735.character, gravityBombs: 1 } }; sim.render();
choose('encounter', 267); el('start').click(); el('gravityBomb').click();
assert(run.sim735.fight.outcome === 'win' && run.sim735.history.length === 2 && run.sim735.character.gravityBombs === 0, 'gravity bomb victory once');
const hp = run.sim735.character.stamina;
el('startTank').click();
assert(run.sim735.tank.status === 1 && run.sim735.tank.shields === 5 && run.sim735.tank.enemyShields === 4, 'tank starts with printed shields');
el('tankMoves').querySelector('[data-tank-move="331"]').click();
el('tankMoves').querySelector('[data-tank-move="91"]').click();
assert(run.sim735.tank.pendingSection === 188, 'tank route triggers printed unseen hit');
el('resolveTank').click();
assert(run.sim735.tank.shields === 4 && run.sim735.character.stamina === hp && run.sim735.tank.phase === 'move', 'tank damage affects shields only');
run.sim735 = { ...run.sim735, tank: { ...run.sim735.tank, section: 223, status: 3, phase: 'encounter', pendingSection: 33 } }; sim.render();
el('resolveTank').click();
assert(run.sim735.tank.status === 4 && run.sim735.tank.phase === 'move' && !run.sim735.tank.pendingSection, 'return does not retrigger STATUS');
for (let retry = 0; retry < 100 && !el('map').src.includes('99420122'); retry++) await new Promise(resolve => setTimeout(resolve, 1));
await el('map').decode(); assert(el('map').naturalWidth > 0 && !el('map').hidden, 'original map decodes');
assert(!el('overlay').textContent.includes('battlesim735.'), 'all visible labels translated');
assert((await import('REPO/public/js/core/util.js')).ALL_PANEL_OVERLAY_IDS.includes('sim735-overlay'), 'overlay shortcut registry');
const modal = el('overlay').querySelector('.bsim-modal');
assert(modal.getBoundingClientRect().width <= innerWidth, 'modal fits viewport');
for (const column of el('overlay').querySelectorAll('.bsim-col')) {
  for (const detail of column.querySelectorAll('details')) detail.open = true;
  assert(getComputedStyle(column).overflowY === 'auto', 'scrollable column');
  const maximum = Math.max(0, column.scrollHeight - column.clientHeight); column.scrollTop = 1e9;
  assert(Math.abs(column.scrollTop - maximum) < 2, 'column bottom reachable'); column.scrollTop = 0;
}
assert(document.documentElement.scrollWidth <= innerWidth, 'no horizontal overflow');
el('close').dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true, cancelable: true }));
assert(!el('overlay').classList.contains('active'), 'Escape closes'); await open();
el('cancel').click(); const beforeSwitch = JSON.stringify(run);
app.state.playthroughs = [{ startedAt: 456, path: [1] }];
document.getElementById('confirm-ok').click(); sim.render(); el('start').click();
assert(!el('overlay').classList.contains('active') && JSON.stringify(run) === beforeSwitch && !app.currentPlaythrough().sim735, 'stale confirmation and actions preserve both runs');
assert(run.sim208.preserved, 'existing English simulator preserved');
document.body.dataset.test = JSON.stringify({ mode, language, width: innerWidth, checks: checks.length, saves: saves.length, productionWrites: 0 });
