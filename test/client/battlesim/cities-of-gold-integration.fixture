const checks = [], saves = [];
const assert = (value, label) => { if (!value) throw Error(label); checks.push(label); };
window.fetch = async (url, options = {}) => {
  assert(url === '/api/books/675/state' && options.method === 'PUT', 'only simulator state saves');
  saves.push(JSON.parse(options.body));
  return new Response('{}', { status: 200, headers: { 'Content-Type': 'application/json' } });
};
const app = await import('REPO/public/js/core/state.js');
const desktop = await import('REPO/public/js/battlesim/loader.js');
const mobile = await import('REPO/public/mobile/js/battlesim-dispatch.js');
const { t } = await import('REPO/public/js/i18n.js');
const { CITIES_OF_GOLD_FIGHTS } = await import('REPO/public/js/battlesim/engines/fabled-lands/cities-of-gold.js');
assert(!document.getElementById('sim675-overlay'), 'lazy panel');
app.setCurrentBookId(675);
const run = { startedAt: 123, path: [1], sim674: { preserved: true } };
app.state.playthroughs = [run]; app.state.activePtIndex = 0;
const mode = 'MODE';
const el = key => document.getElementById('sim675-' + key);
const open = async () => {
  if (mode === 'mobile') await mobile.openSimForBook(675);
  else { await desktop.showBattleSimForBook(675); el('btn').click(); }
};
await open();
assert(el('overlay').classList.contains('active'), 'real loader opens panel');
assert(!el('overlay').textContent.includes('battlesim675.'), 'translated visible labels');
assert(run.sim675.character === null && saves.length === 0, 'opening creates no character');
assert(el('context').options.length === 26, 'book-specific roster');
assert(getComputedStyle(el('btn')).borderRadius === '7px', 'themed button');
el('create').click();
assert(run.sim675.character.rank === 2 && run.sim675.character.stamina === 13, 'book-two defaults');
el('context').value = String(CITIES_OF_GOLD_FIGHTS.findIndex(f => f.section === 207));
el('context').dispatchEvent(new Event('change', { bubbles: true }));
el('start').click();
assert(!el('flee').hidden && el('context').disabled, 'escape available while setup locked');
Math.random = () => .499;
el('flee').click();
assert(run.sim675.fight.status === 'fled' && run.sim675.fight.destination === 22, 'source escape destination');
assert(run.sim675.character.stamina === 10 && run.sim675.history.length === 0, 'escape wounds without XP reward');
el('seaContext').value = '488'; el('seaRoll').click();
assert(run.sim675.log.at(-1).includes('221'), 'special crew modifier applied');
el('context').value = String(CITIES_OF_GOLD_FIGHTS.findIndex(f => f.section === 413));
el('context').dispatchEvent(new Event('change', { bubbles: true }));
Math.random = () => .999;
el('start').click(); el('step').click();
assert(run.sim675.fight.status === 'win' && run.sim675.history.length === 1, 'one encounter reward');
assert(run.sim674.preserved === true, 'other simulator preserved');
await app.saveState();
assert(saves.at(-1).playthroughs[0].sim675.history.length === 1, 'actual state persistence');
for (const node of el('overlay').querySelectorAll('details')) node.open = true;
const body = el('overlay').querySelector('.bsim-body');
body.scrollTop = Number.MAX_SAFE_INTEGER;
assert(Math.abs(body.scrollTop - Math.max(0, body.scrollHeight - body.clientHeight)) <= 1, 'scroll reaches bottom');
assert(document.documentElement.scrollWidth <= innerWidth + 1 && body.scrollWidth <= body.clientWidth + 1, 'no overflow');
el('close').dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
assert(!el('overlay').classList.contains('active'), 'Escape closes');
const preserved = JSON.stringify(run);
app.state.playthroughs.push({ startedAt: 456, path: [1] }); app.state.activePtIndex = 1;
await open();
assert(app.currentPlaythrough().sim675.character === null && JSON.stringify(run) === preserved, 'run isolation');
document.body.setAttribute('data-test', JSON.stringify({ mode, width: innerWidth, checks: checks.length,
  saves: saves.length, encounters: 26, realModules: true, productionWrites: 0 }));
