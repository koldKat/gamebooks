const checks=[],alerts=[],saves=[];
const assert=(value,label)=>{if(!value)throw Error(label);checks.push(label);};
const {createLegendaryPanel}=await import('REPO/public/js/battlesim/engines/legendary-kingdoms/panel.js');
const dictionary=(await import('REPO/public/js/i18n/LANG/battlesim/battlesim689.js')).default;
const t=(key,params={})=>{
  const value=dictionary[key]??{'battlesim.title':'Battle Simulator','btn.close':'Close','battlesim.no_active_playthrough':'No active run'}[key];
  if(value===undefined)throw Error('Missing translation '+key);
  return value.replace(/\{(\w+)\}/g,(_,name)=>String(params[name]??''));
};
let run={startedAt:123,path:[1],sim680:{preserved:true}},bookId=689;
const panel=createLegendaryPanel({document,t,getRun:()=>run,getBookId:()=>bookId,
  saveState:()=>saves.push(structuredClone(run)),showAlert:message=>alerts.push(message),
  showConfirm:(_,update)=>update(),getButtonRow:()=>document.getElementById('buttons')});
panel.init();panel.setVisible(true);
const el=key=>document.getElementById('sim689-'+key);
el('btn').click();
assert(el('overlay').classList.contains('active'),'panel opens');
assert(el('context').options.length===75,'all personal contexts');
assert(getComputedStyle(el('btn')).borderRadius==='7px','themed simulator button');
assert(run.sim689.party.length===0&&saves.length===0,'opening changes no characters');
el('create').click();
assert(run.sim689.party.length===4,'four heroes created');
assert(run.sim689.party[1].spells.length===3,'three chosen starting spells');
assert(el('members').selectedOptions.length===0,'empty participant selection defaults to complete party');
assert(el('checkMember1').options.length===4,'skill-check hero choices');
el('start').click();
assert(run.sim689.fight.participants.length===4,'all heroes participate by default');
assert(el('spellTarget').options.length===4,'friendly spell targets');
assert(el('applyParty').disabled&&el('hero-0-health').disabled,'active fight blocks permanent-stat editing');
el('caster').value='1';el('caster').dispatchEvent(new Event('change'));
el('spell').value='iceBolt';el('spell').dispatchEvent(new Event('change'));
assert(el('spellTarget').options.length===2,'attack spell targets are living opponents');
assert(!el('cast').disabled,'charged caster action enabled');
el('cancel').click();
assert(run.sim689.fight.status==='cancelled'&&!el('applyParty').disabled,'cancel preserves editable current party');
el('applyParty').click();el('start').click();
Math.random=()=>0.999;
run.sim689.fight.enemies.forEach(enemy=>{enemy.health=1;});panel.render();
el('actor').value='0';el('target').value='0';el('attack').click();
el('actor').value='2';el('target').value='1';el('attack').click();
assert(run.sim689.fight.status==='won'&&run.sim689.history.length===1,'one win recorded exactly once');
el('applyParty').click();
el('hero-0-health').value='1';el('applyParty').click();
el('learnSpell').value='soothingTouch';el('learn').click();
el('spell').value='soothingTouch';el('spell').dispatchEvent(new Event('change'));el('spellTarget').value='0';
el('castAdventure').click();
assert(run.sim689.party[0].health===6&&!run.sim689.party[1].spells.find(spell=>spell.id==='soothingTouch').charged,'adventure healing applies once and consumes its charge');
el('learnSpell').value='warpWood';el('learn').click();
assert(run.sim689.party[1].spells.some(spell=>spell.id==='warpWood'),'learned story spell');
el('mode').value='naval';el('mode').dispatchEvent(new Event('change'));
assert(el('context').options.length===3,'all naval contexts');
el('shipName').value='Test Cog';el('shipFighting').value='4';el('shipHealth').value='3';el('applyShip').click();
el('start').click();
assert(run.sim689.fight.kind==='naval'&&run.sim689.fight.ship.health===3,'current ship Health retained');
assert(el('spell').value==='warpWood'&&!el('castStrategy').disabled,'sea spell UI is scope-filtered');
el('castStrategy').click();
assert(!run.sim689.party[1].spells.find(spell=>spell.id==='warpWood').charged,'sea spell charge consumed');
el('strategyStep').click();
assert(run.sim689.fight.status==='won'&&run.sim689.history.length===2,'naval win recorded once');
el('shipHealth').value='7';el('applyShip').click();
assert(run.sim689.ship.health===7&&run.sim689.fight===null,'ship edits are not overwritten by a completed battle');
el('mode').value='army';el('mode').dispatchEvent(new Event('change'));
assert(el('context').options.length===4,'all army contexts');
assert(!el('codes').closest('details'),'codes accessible for army mode');
for(let i=0;i<3;i++){
  el('unitName').value='Unit '+i;el('unitStrength').value='100';el('unitMorale').value='6';el('addUnit').click();
}
for(let i=0;i<3;i++)el('formation-'+(i*2)).value=run.sim689.units[i].uid;
el('codes').value='A95';el('start').click();
assert(run.sim689.fight.kind==='army'&&!run.sim689.fight.rules.descantos,'source code disables Descantos');
for(let i=0;i<8&&run.sim689.fight.status==='active';i++)el('strategyStep').click();
assert(run.sim689.fight.status==='won'&&run.sim689.history.length===3,'army ends immediately on two controlled zones');
assert(run.sim689.units.every(unit=>unit.morale===6&&!unit.routed),'friendly Morale preserved');
el('editUnit').value=run.sim689.units[0].uid;el('editUnit').dispatchEvent(new Event('change'));
el('editUnitMorale').value='5';el('updateUnit').click();
assert(run.sim689.units[0].morale===5&&run.sim689.fight===null,'explicit unit edits preserve source rewards after battle');
el('mode').value='personal';el('mode').dispatchEvent(new Event('change'));el('context').value='406';el('start').click();
run.sim689.fight.enemies.forEach(enemy=>{enemy.health=1;});panel.render();
el('actor').value='0';el('target').value='0';el('attack').click();
el('recipient').value='1';el('recipient').dispatchEvent(new Event('change'));el('takeWeapon').click();
el('actor').value='1';el('target').value='1';el('attack').click();
assert(run.sim689.fight.status==='won'&&!el('lootActions').hidden,'post-win loot remains available');
el('recipient').value='0';el('recipient').dispatchEvent(new Event('change'));el('takeWeapon').click();
assert(run.sim689.party[0].weaponBonus===1&&run.sim689.history.length===4,'post-win loot persists without recording a duplicate victory');
assert(run.sim680.preserved,'unrelated simulator state preserved');
const otherHeroes=JSON.stringify(run.sim689.party.slice(1));
el('recruitSlot').value='0';el('recruitSkullcracker').click();
assert(run.sim689.party[0].name==='Skullcracker'&&run.sim689.party[0].skills.fighting===8&&run.sim689.party[0].health===12,'source companion profile');
assert(JSON.stringify(run.sim689.party.slice(1))===otherHeroes,'recruitment preserves other heroes');
assert(el('recruitSkullcracker').disabled&&el('hero-0-armour').disabled&&el('hero-0-armed').disabled,'companion equipment and duplicate recruitment blocked');
el('hero-0-armour').value='9';el('hero-0-weaponBonus').value='9';el('hero-0-armed').checked=false;el('applyParty').click();
assert(run.sim689.party[0].armour===0&&run.sim689.party[0].weaponBonus===0&&run.sim689.party[0].armed,'companion cannot gain equipment or become disarmed');
assert(alerts.length===0,'no unexpected validation alerts');
assert(!el('overlay').textContent.includes('battlesim689.'),'all visible strings translated');
for(const node of el('overlay').querySelectorAll('details'))node.open=true;
const left=el('overlay').querySelector('.bsim-col-left');left.scrollTop=Number.MAX_SAFE_INTEGER;
assert(Math.abs(left.scrollTop-(left.scrollHeight-left.clientHeight))<=1,'controls scroll to bottom');
assert(document.documentElement.scrollWidth<=innerWidth+1&&left.scrollWidth<=left.clientWidth+1,'no horizontal overflow');
el('close').dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
assert(!el('overlay').classList.contains('active'),'Escape closes');
const preserved=JSON.stringify(run);run={startedAt:456,path:[1]};panel.render();
assert(JSON.stringify(saves.at(-1))===preserved,'state writes preserve exact previous run');
assert(run.sim689.party.length===0,'new run has isolated party');
bookId=0;panel.render();assert(!el('overlay').classList.contains('active'),'leaving book closes overlay');
document.body.setAttribute('data-test',JSON.stringify({width:innerWidth,language:'LANG',checks:checks.length,saves:saves.length,
  scope:'DIRECT-PANEL-ONLY-NOT-LOADER-OR-LIVE-API',productionWrites:0}));
