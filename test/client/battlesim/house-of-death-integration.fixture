const checks = [], saves = [];
const assert = (value,label) => {if (!value) throw Error(label);checks.push(label);};
window.fetch = async (url,options = {}) => {
  assert(url === '/api/books/860/state' && options.method === 'PUT','only intercepted state saves');
  saves.push(JSON.parse(options.body));return new Response('{}',{headers:{'Content-Type':'application/json'}});
};
const app = await import('REPO/public/js/core/state.js');
const desktop = await import('REPO/public/js/battlesim/loader.js');
const mobile = await import('REPO/public/mobile/js/battlesim-dispatch.js');
await import('REPO/public/js/ui-helpers/dialog-escape.js');
const el = key => document.getElementById('sim860-' + key);
const run = {startedAt:123,path:[1],sim857:{preserved:true}};
app.setCurrentBookId(860);app.state.playthroughs = [run];app.state.activePtIndex = 0;
assert(!el('overlay') && mobile.hasSim(860),'registered and lazy');
const sim = await import('REPO/public/js/battlesim/battlesim860.js');
if ('MODE' === 'mobile') await mobile.openSimForBook(860);
else {await desktop.showBattleSimForBook(860);el('btn').click();}
assert(el('overlay').classList.contains('active'),'real loader opens');
assert(el('title').textContent === 'В къщата на смъртта','Bulgarian source keeps Bulgarian title');
assert(!el('overlay').textContent.includes('battlesim860.'),'translated initial labels');
const choose = query => {
  const name = el('editor').querySelector('[role="combobox"]');
  name.value = query;name.dispatchEvent(new Event('input',{bubbles:true}));
  name.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowDown',bubbles:true,cancelable:true}));
  name.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',bubbles:true,cancelable:true}));
  return name;
};
let name = choose('Съдия Смърт');
assert(run.sim860.sourceId === '31','autocomplete preserves heavy-wound source rule');
name.dispatchEvent(new Event('change',{bubbles:true}));
assert(run.sim860.sourceId === '31','blur change does not detach selected exception');
name.focus();name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true,cancelable:true}));
assert(el('overlay').classList.contains('active') && name.getAttribute('aria-expanded') === 'false','Escape dismisses suggestions only');
el('manual').click();el('attackOne').value = 5;el('attackTwo').value = 5;
el('energy').value = 44;el('initialEnergy').value = 44;el('start').click();
assert(run.sim860.pending && el('energy').disabled && name.disabled,'round locks setup');
el('resolve').click();
assert(!run.sim860.pending && run.sim860.result.destination === '78','heavy wound chooses printed route');
assert(run.sim860.character.energy === 44,'heavy wound invents no numeric damage');
const beforeRepeat = JSON.stringify(run);el('resolve').click();
assert(JSON.stringify(run) === beforeRepeat,'one round cannot resolve twice');
choose('Съдия Мортис');el('attackOne').value = 4;el('attackTwo').value = 4;
el('damageOne').value = 2;el('damageTwo').value = 3;el('start').click();el('resolve').click();
assert(run.sim860.character.energy === 39,'printed threshold equality and two damage dice');
choose('Съдия Огън: първи удар');el('damageOne').value = 6;
el('start').click();el('resolve').click();
assert(run.sim860.character.energy === 33 && run.sim860.result.attackDice.length === 0,'automatic damage skips attack roll');
name = el('editor').querySelector('[role="combobox"]');
name.value = 'Мой капан';name.dispatchEvent(new Event('input',{bubbles:true}));
assert(run.sim860.sourceId === null,'custom name detaches old special rules');
const threshold = el('editor').querySelector('[data-stat="threshold"]');
threshold.value = 12;threshold.dispatchEvent(new Event('input',{bubbles:true}));
el('attackOne').value = 1;el('attackTwo').value = 1;el('start').click();el('resolve').click();
assert(run.sim860.result.outcome === 'safe' && run.sim860.character.energy === 33,'custom ordinary check works without preset');
assert(run.sim860.history.length === 0,'single wound checks grant no fake fight wins');
el('accuracyDie').value = 1;el('accuracy').click();
assert(run.sim860.log.at(-1).includes('7'),'accuracy miss keeps printed route');
assert(run.sim857.preserved,'other saved simulators preserved');
assert(!el('overlay').querySelector('.bsim-col-right input,.bsim-col-right select'),'setup stays left');
assert(el('totals').closest('.bsim-col-right') && el('destination').closest('.bsim-col-right'),'results stay right');
assert(getComputedStyle(el('overlay')).fontFamily.includes('sans-serif'),'real app base font is loaded');
assert(el('overlay').querySelector('.bsim-modal').getBoundingClientRect().width <= innerWidth,'dialog fits');
assert(document.documentElement.scrollWidth <= innerWidth,'no horizontal overflow');
assert(getComputedStyle(el('resolve')).backgroundColor !== 'rgb(239, 239, 239)','button is themed');
assert(getComputedStyle(el('manual')).appearance === 'none','checkbox is themed');
const beforeRender = JSON.stringify(run);sim.render();sim.render();
assert(JSON.stringify(run) === beforeRender,'render is read-only');
el('newCharacter').click();assert(document.getElementById('confirm-overlay').classList.contains('active'),'new character confirms');
const saved = JSON.stringify(run);app.state.playthroughs = [{startedAt:456,path:[1]}];
document.getElementById('confirm-ok').click();sim.render();
assert(!el('overlay').classList.contains('active'),'stale run closes');
assert(JSON.stringify(run) === saved && !app.currentPlaythrough().sim860,'stale confirmation preserves both runs');
await app.saveState();await new Promise(resolve => setTimeout(resolve,0));
document.body.dataset.test = JSON.stringify({mode:'MODE',language:'LANGUAGE',width:innerWidth,checks:checks.length,saves:saves.length,productionWrites:0});
