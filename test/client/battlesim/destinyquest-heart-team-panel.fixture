localStorage.setItem('gamebook_lang','en');
const app=await import('REPO/public/js/core/state.js');
const {t}=await import('REPO/public/js/i18n.js');
const {loadBattleSimTranslations}=await import('REPO/public/js/i18n/battlesim.js');
const {prepareBattleSimLayout}=await import('REPO/public/js/battlesim/layout.js');
const {definition:base}=await import('REPO/public/js/battlesim/books/1286/definition.js');
const {createDestinyState}=await import('REPO/public/js/battlesim/engines/destinyquest/state.js');
const {createDestinyPanel}=await import('REPO/public/js/battlesim/engines/destinyquest/panel.js');
const {createDestinySession,beginDestinySession}=await import('REPO/public/js/battlesim/engines/destinyquest/session.js');
const {createHeartFight}=await import('REPO/public/js/battlesim/engines/destinyquest/heart.js');
const {HEART_ABILITIES}=await import('REPO/public/js/battlesim/engines/destinyquest/heart-abilities.js');
const {destinyTeamHero}=await import('REPO/public/js/battlesim/engines/destinyquest/team-state.js');
const {decodeDestinyRoster}=await import('REPO/public/js/battlesim/engines/destinyquest/winters-fury-roster.js');
const roster=decodeDestinyRoster(HEART_ENEMIES);
await loadBattleSimTranslations(1286);app.setCurrentBookId(1287);
const hero={speed:20,brawn:4,magic:0,armour:10,health:20,maxHealth:30};
const foe={displayName:'Monster',name:'Monster',speed:0,brawn:12,magic:0,armour:0,health:200,damageStat:'brawn'};
const run={startedAt:1,path:[1],notebook:'keep',inventory:[{itemId:8,qty:2}],equipment:{head:9},sim1286:{keep:true},sim1287:createDestinySession({setup:{hero,opponents:[foe],abilities:{heal:1,defender:1}}})};
app.state.playthroughs=[run];app.state.activePtIndex=0;
let writes=0,lastAlert='',scenarios=0;
const definition={...base,id:1287,stateKey:'sim1287',abilityCatalog:HEART_ABILITIES,allowTeam:true};
const state=createDestinyState(definition,()=>({getRun:app.currentPlaythrough,getBookId:()=>1287,saveState:()=>writes++}));
const panel=createDestinyPanel({document,definition,state,getRoster:()=>roster,t,createFight:createHeartFight,
  showAlert:message=>{lastAlert=message;},showConfirm:(_text,fn)=>fn(),getButtonRow:()=>document.getElementById('m-sim-btn-row')||document.getElementById('main-screen')});
const el=key=>document.getElementById('sim1287-'+key),data=()=>run.sim1287;
const check=(value,message)=>{if(!value)throw Error(message);scenarios++;};
const click=key=>{if(!el(key))throw Error('Missing control '+key);el(key).click();if(lastAlert)throw Error(lastAlert);};
const change=(key,value)=>{el(key).value=value;el(key).dispatchEvent(new Event('change',{bubbles:true}));if(lastAlert)throw Error(lastAlert);};
const ability=name=>change('useAbility',name);
const add=(container,name)=>{const node=el(container);node.querySelector('select').value=name;node.querySelector('.bsim-btn-row button').click();if(lastAlert)throw Error(lastAlert);};
const shared=JSON.stringify([run.inventory,run.equipment,run.notebook,run.sim1286]);
panel.init();panel.setVisible(true);click('btn');prepareBattleSimLayout(el('overlay'));
check(el('allyFields').hidden,'second hero starts collapsed and disabled');
el('teamEnabled').checked=true;el('teamEnabled').dispatchEvent(new Event('change',{bubbles:true}));
check(!el('allyFields').hidden,'second hero setup becomes visible');
change('allyName','Companion');change('ally-speed','20');change('ally-brawn','4');change('ally-health','10');
add('allyOwned','regrowth');add('allyOwned','defender');
el('allyGearPresent').checked=true;el('allyGearPresent').dispatchEvent(new Event('change',{bubbles:true}));
change('allyGearType','staff');change('allyGear-magic','5');
check(data().setup.ally.equipment.mainHand.magic===5,'second hero modifiers are saved separately');
const config=structuredClone(data().setup),before=writes;click('start');
check(writes===before+1&&data().fight.team.order.length===2,'starting both heroes makes one save');
check(el('setup').disabled,'team setup locks during combat');
check(data().fight.allies[0].abilities.regrowth===1&&data().fight.abilities.heal===1,'heroes retain their own abilities');
click('next');check(data().fight.team.roles.join(',')==='attack,attack','both attackers are passed to the engine');
el('manualDice').value='6 5 1 2';click('team-roll-speed');
check(data().fight.team.rolled.join(',')==='0','first attacker rolls once');
el('manualDice').value='6 5';click('team-roll-speed');
check(data().fight.team.rolled.join(',')==='0,1','second attacker reuses the opponent roll');
click('team-resolve-speed');check(el('teamWinner')?.options.length===2,'equal winning heroes get a striker choice');
el('teamWinner').value='1';click('team-resolve-speed');
check(data().fight.team.roundWinner===1&&data().fight.team.active===1,'selected striker owns the attack');
ability('regrowth');change('abilityAlly','0');click('ability');
check(destinyTeamHero(data().fight,0).hero.health===26&&data().fight.hero.health===10,'ally healing reaches its selected recipient');
el('manualDice').value='1';click('next');click('next');
check(data().fight.opponents[0].health===195,'winning second hero resolves the normal attack');
const saved=JSON.stringify(data());run.sim1287=JSON.parse(saved);panel.render();
check(JSON.stringify(data())===saved,'team render and JSON resume preserve state');
click('next');check(data().fight.phase==='start','shared end of round returns to team setup');

const begin=(setup,id)=>beginDestinySession(createDestinySession(),setup,{outcomeId:id,catalog:HEART_ABILITIES,bookRules:definition.bookRules,createFight:createHeartFight,roster});
const defenceConfig={...config,hero:{...hero,health:30},opponents:[{...foe,speed:100}],ally:{...config.ally,hero:{...config.ally.hero,health:30}}};
run.sim1287=begin(defenceConfig,'team-defender');panel.render();el('teamRole-1').value='support';click('next');
el('manualDice').value='1 2 6 5';click('team-roll-speed');click('team-resolve-speed');
check(data().fight.team.roundWinner===0&&el('defenderActor')?.options.length===1,'support hero can defend the attacked hero');
click('team-defend');check(data().fight.team.active===1&&data().fight.used.defender===1,'Defender switches the attack without an inspection action');
el('manualDice').value='1';click('next');click('next');
check(destinyTeamHero(data().fight,0).hero.health===30&&destinyTeamHero(data().fight,1).hero.health===17,'Defender takes damage using their own Armour');

const pairedHero={speed:30,brawn:0,magic:0,armour:20,health:80,maxHealth:80};
const pairedConfig={...config,section:'163',hero:pairedHero,ally:{...config.ally,hero:{...pairedHero,name:'Companion',speed:10}}};
run.sim1287=begin(pairedConfig,'paired-wicker');panel.render();
check(el('teamRole-0').options.length===1&&el('teamRole-1').options.length===1,'paired encounter requires both heroes to attack');
click('next');check(data().fight.team.targetsByActor[0]===0&&data().fight.team.targetsByActor[1]===1,'source assigns the faster hero to Wicker Man');
el('manualDice').value='6 5 1 2';click('team-roll-speed');click('team-resolve-speed');el('manualDice').value='1';click('next');click('next');
check(data().fight.team.active===1&&data().fight.team.stage==='speed','second independent contest becomes active');
el('manualDice').value='6 5 1 2';click('team-roll-speed');click('team-resolve-speed');el('manualDice').value='1';click('next');click('next');
check(data().fight.team.stage==='end','both paired contests finish before round-end effects');
click('next');check(destinyTeamHero(data().fight,0).hero.health===80&&destinyTeamHero(data().fight,1).hero.health===76,'source cage damage applies after both contests');

run.sim1287=begin({...pairedConfig,section:'662'},'paired-shrines');panel.render();
el('teamTarget-1').value='1';click('next');
check(data().fight.team.targetsByActor[0]===0&&data().fight.team.targetsByActor[1]===1,'boss and shrine assignments are passed separately');
el('manualDice').value='6 5 1 2';click('team-roll-speed');click('team-resolve-speed');el('manualDice').value='1';click('next');click('next');
check(!el('team-roll-speed')&&el('team-resolve-speed'),'shrine attack is offered without invented Speed dice');
click('team-resolve-speed');check(data().fight.turn.autoWin&&data().fight.turn.heroSpeedDice.length===0,'source shrine attack wins automatically');
el('manualDice').value='1';click('next');click('next');
check([...el('passiveDefenderSource').options].every(option=>option.value),'passive protection offers native named sources');
el('passiveDefender').value='1';el('passiveDefenderSource').value='encounter';click('team-defend-passive');click('next');
check(destinyTeamHero(data().fight,0).hero.health===80&&destinyTeamHero(data().fight,1).hero.health===70,'Defender takes the selected passive packet alongside their own damage');
check(JSON.stringify([run.inventory,run.equipment,run.notebook,run.sim1286])===shared,'team controls preserve shared items and unrelated state');
check(document.documentElement.scrollWidth<=innerWidth,'no viewport overflow');
document.body.dataset.test=JSON.stringify({width:innerWidth,scenarios,writes,panelOnly:true,playerDatabaseWrites:0});
