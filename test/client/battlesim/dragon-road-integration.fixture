const checks=[],saves=[],readingRequests=[];
const assert=(value,label)=>{if(!value)throw Error(label);checks.push(label);};
window.fetch=async(url,options={})=>{
  if(url==='/api/books/768/reading-access'&&(!options.method||options.method==='GET')) {
    readingRequests.push(url);return new Response('{}',{status:200,headers:{'Content-Type':'application/json'}});
  }
  assert(url==='/api/books/768/state'&&options.method==='PUT','only intercepted state saves');
  saves.push(JSON.parse(options.body));return new Response('{}',{status:200,headers:{'Content-Type':'application/json'}});
};
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const {loadBattleSimTranslations}=await import('REPO/public/js/i18n/battlesim.js');
const mode='MODE',language='LANGUAGE',el=key=>document.getElementById('sim768-'+key);
const module=await import('REPO/public/js/battlesim/battlesim768.js');
await loadBattleSimTranslations(768);
app.setCurrentBookId(768);
const run={startedAt:123,path:[1],sim757:{preserved:true}};
app.state.playthroughs=[run];app.state.activePtIndex=0;
const open=async()=>{if(mode==='mobile')await mobile.openSimForBook(768);else{await desktop.showBattleSimForBook(768);el('btn').click();}};
const change=(key,value)=>{el(key).value=value;el(key).dispatchEvent(new Event('change'));};
const key=(target,code,name)=>target.dispatchEvent(new KeyboardEvent('keydown',{code,key:name,bubbles:true}));
await open();
assert(el('overlay').classList.contains('active'),'real lazy loader opens');
assert(el('title').textContent==='Пътят на дракона','Bulgarian source title in either app language');
assert(!el('overlay').textContent.includes('battlesim768.'),'all labels translated');
assert(!el('overlay').querySelector('.bsim-col-right input,.bsim-col-right select'),'setup stays on left');
assert(run.sim768.character===null&&el('start').disabled,'no invented initial character');
for(const [key,value]of Object.entries({attack:12,defence:4,shooting:8,life:24,mastery:2,speed:3,magicStrength:8,magicEnergy:12,magicResistance:2}))el(key).value=value;
el('apply').click();
const enemyEditor=el('enemies').querySelector('.bsim-opponent-editor');
const name=enemyEditor.querySelector('[role="combobox"]');
name.focus();assert(enemyEditor.querySelector('[role="option"]'),'roster suggestions');
key(name,'Escape','Escape');assert(el('overlay').classList.contains('active')&&name.getAttribute('aria-expanded')==='false','Escape closes suggestions first');
name.focus();name.dispatchEvent(new Event('input',{bubbles:true}));
enemyEditor.querySelector('[role="option"]').dispatchEvent(new PointerEvent('pointerdown',{bubbles:true}));
assert(enemyEditor.querySelector('[data-stat="attack"]').value==='20','preset fills editable original stats');
name.value='Custom opponent';
for(const [stat,value]of Object.entries({attack:10,defence:2,life:16}))enemyEditor.querySelector('[data-stat="'+stat+'"]').value=value;
el('start').click();
assert(run.sim768.fight.enemies[0].displayName==='Custom opponent'&&el('apply').disabled,'custom opponent starts and setup locks');
Math.random=()=>0;
el('prepare').click();
assert(run.sim768.fight.pending.attackValue===13&&run.sim768.fight.pending.defenceValue===3,'normal rolls prepared once');
assert(el('start').disabled&&el('prepare').disabled&&el('win').disabled,'pending action cannot reroll or finish');
el('tableDamage').value=12;el('resolve').click();
assert(run.sim768.fight.enemies[0].life===7&&el('tableDamage').value==='','table damage subtracts defence once and clears result');
change('side','enemy');el('requested').value=2;el('prepare').click();
assert(run.sim768.fight.pending.strikes===2,'enemy printed strikes need no invented mastery');
el('tableDamage').value=10;el('resolve').click();
assert(run.sim768.character.life===19,'current hero LIFE persists');
change('side','player');
for(const [key,value]of Object.entries({requiredStrength:8,energyCost:5,spellDamage:2}))el(key).value=value;
el('spell').value='Source spell';el('cast').click();
assert(run.sim768.character.magicEnergy===7&&run.sim768.fight.enemies[0].life===5,'spell damage and energy persist');
el('win').click();
assert(document.getElementById('confirm-overlay').classList.contains('active'),'styled outcome confirmation');
assert(document.getElementById('confirm-ok').textContent===el('win').textContent,'confirmation is not a Delete button');
document.getElementById('confirm-ok').click();
assert(run.sim768.history.length===1&&run.sim768.fight.outcome==='win','one explicit passage victory');
el('win').click();assert(run.sim768.history.length===1,'victory cannot repeat');
el('again').click();change('system','simple');el('start').click();
assert(run.sim768.fight.battleCode===4,'simple battle code is four');
el('prepare').click();el('tableDamage').value=5;el('resolve').click();
assert(run.sim768.fight.enemies[0].life===11,'simple result is final without a second defence subtraction');
const saved=JSON.stringify(run);
key(el('close'),'Escape','Escape');assert(!el('overlay').classList.contains('active'),'Escape closes panel');
await open();assert(JSON.stringify(run)===saved,'reopening preserves ongoing fight and character');
assert([...el('tables').querySelectorAll('img')].every(image=>!image.hasAttribute('src')),'protected tables do not request anonymously');
el('tables').open=true;
await new Promise(resolve=>setTimeout(resolve,50));
assert(readingRequests.length===1&&[...el('tables').querySelectorAll('img')].every(image=>image.getAttribute('src')?.startsWith('/api/books/768/reading-images/')),'image session established before table requests');
for(const details of el('overlay').querySelectorAll('details'))details.open=true;
for(const column of el('overlay').querySelectorAll('.bsim-col')){
  column.scrollTop=Number.MAX_SAFE_INTEGER;
  assert(Math.abs(column.scrollTop-Math.max(0,column.scrollHeight-column.clientHeight))<=1,'bottom reachable');
  column.scrollTop=0;
}
assert(document.documentElement.scrollWidth<=innerWidth+1,'no horizontal overflow');
assert(JSON.stringify(run.sim757)==='{"preserved":true}','other simulator preserved');
await app.saveState();assert(saves.at(-1).playthroughs[0].sim768.history.length===1,'actual state payload');
app.state.playthroughs.push({startedAt:456,path:[1]});app.state.activePtIndex=1;module.render();
assert(!el('overlay').classList.contains('active'),'run switch closes stale panel');
el('apply').click();assert(!app.currentPlaythrough().sim768,'stale controls cannot change new run');
await open();assert(app.currentPlaythrough().sim768.character===null,'new run isolated');
assert(JSON.stringify(run)===saved,'old run is unchanged after switching');
document.body.dataset.test=JSON.stringify({mode,language,width:innerWidth,checks:checks.length,saves:saves.length,realModules:true,productionWrites:0});
