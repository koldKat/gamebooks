      Math.random=()=>.2;el('atk-crowbar').click();
      check(state().enemy.life===8&&state().player.life===17&&state().history.length===history+1&&state().extension.keep&&state().ammo.pistol===1,'Mutated Flesh metadata threshold stops saved Lenova fight before counterattack');
      d.enemy={life:14,dmg:19};d.player.life=40;delete d.rulesVersion;module.render();const legacy=JSON.stringify(d),priorHistory=d.history.length;module.render();check(JSON.stringify(state())===legacy,'Mutated Flesh legacy render preserves missing rules version');
      el('atk-crowbar').click();
      check(state().rulesVersion===undefined&&state().enemy.life===8&&state().player.life===21&&state().history.length===priorHistory&&state().extension.keep,'Mutated Flesh legacy Lenova fight retains original counterattack and victory rules');
    }finally{Math.random=random;}
  }
  if(id===772){
    const {ROSTER}=await import('REPO/public/js/battlesim/books/772/definition.js');
