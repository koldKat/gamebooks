  module.setVisible(false);overlay.classList.remove('active');
  results.push(id);
}
check(!missingTranslations.size,'missing simulator translations: '+[...missingTranslations].join(', '));
document.body.dataset.test=JSON.stringify({mode:'MODE',language:'LANGUAGE',width:innerWidth,books:results,requestedRosters:[...requestedRosters],writes,productionWrites:0});
