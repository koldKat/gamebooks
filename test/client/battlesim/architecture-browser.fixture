    name.focus();name.dispatchEvent(new Event('input',{bubbles:true}));check(editor.querySelector('[role="option"]'),'Wonderland autocomplete');
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
