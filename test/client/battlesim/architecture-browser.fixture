    stat('hp').value='1';el('start').click();el('die-player').value='1';el('die-dodge').value='6';el('round').click();
    check(state().fight.outcome==='win'&&state().history.length===5,'scarlet normal countess and unique history');
    const modal=overlay.querySelector('.bsim-modal');
    check(modal.getBoundingClientRect().width<=innerWidth&&modal.scrollWidth<=modal.clientWidth+1,'scarlet modal width');
    const max=modal.scrollHeight-modal.clientHeight;modal.scrollTop=Number.MAX_SAFE_INTEGER;
    check(Math.abs(modal.scrollTop-max)<=1,'scarlet bottom reachable');modal.scrollTop=0;
  }
  if(id===817){
    const el=key=>document.getElementById('sim817-'+key);
    const state=()=>app.currentPlaythrough().sim817;
    const editor=overlay.querySelector('.bsim-opponent-editor');
    const name=()=>editor.querySelector('[role="combobox"]');
    check(state().character.life===10&&!state().character.blaster,'area starts unarmed');
    el('blaster').checked=true;el('shots').value='2';
    name().focus();name().dispatchEvent(new Event('input',{bubbles:true}));
    check(editor.querySelector('[role="option"]'),'area autocomplete');
    name().dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    check(overlay.classList.contains('active')&&name().getAttribute('aria-expanded')==='false','area autocomplete Escape first');
    check(el('shots').value==='2','area preserves unsaved inventory');
    el('manual').checked=true;el('manual').dispatchEvent(new Event('change',{bubbles:true}));
    el('start').click();el('die').value='5';el('blasterAttack').click();
    check(state().character.life===7&&state().character.shots===0&&state().fight.remaining===2,'area ammunition shortfall');
    check(el('shots').disabled&&name().disabled,'area setup locked');
    el('die').value='6';el('blasterAttack').click();el('die').value='1';el('melee').click();
    check(state().fight.outcome==='loss'&&state().history.length===1,'area death overrides last alien victory');
    el('encounter').value='30';el('encounter').dispatchEvent(new Event('change',{bubbles:true}));
    el('life').value='10';el('grenades').value='1';el('start').click();
    el('die').value='2';el('grenade').click();
    check(state().fight.outcome==='win'&&state().fight.usedExplosives&&state().character.grenades===0,'area hostage grenade fight');
    check(el('warning').textContent.includes('заложник'),'area hostage consequence visible');
    el('encounter').value='37';el('encounter').dispatchEvent(new Event('change',{bubbles:true}));
    el('start').click();check(el('blasterAttack').disabled&&el('grenade').disabled,'area forced melee');
    el('die').value='4';el('melee').click();
    check(state().character.life===6&&state().fight.destination==='20','area forced melee loss and continuation');
    el('medkits').value='1';el('saveCharacter').click();el('heal').click();
    check(state().character.life===10&&state().character.medkits===0&&!state().fight,'area outside combat medkit');
    el('encounter').value='55';el('encounter').dispatchEvent(new Event('change',{bubbles:true}));
    el('difficulty').value='apocalyptic';el('difficulty').dispatchEvent(new Event('change',{bubbles:true}));
    check(editor.querySelector('[data-stat="count"]').value==='15','area difficulty preset');
    name().value='Ръчен патрул';editor.querySelector('[data-stat="count"]').value='2';
    el('bazookas').value='1';el('start').click();el('bazooka').click();
    check(state().fight.name==='Ръчен патрул'&&state().fight.outcome==='win'&&state().character.bazookas===0,'area manual opponent and bazooka');
    const modal=overlay.querySelector('.bsim-modal');
    check(modal.getBoundingClientRect().width<=innerWidth&&modal.scrollWidth<=modal.clientWidth+1,'area modal width');
    const max=modal.scrollHeight-modal.clientHeight;modal.scrollTop=Number.MAX_SAFE_INTEGER;
    check(Math.abs(modal.scrollTop-max)<=1,'area bottom reachable');modal.scrollTop=0;
  }
  const before=JSON.stringify(app.currentPlaythrough());module.render();
  for(const key of overlay.textContent.match(/battlesim(?:\d+)?\.[\w.]+/g)??[])missingTranslations.add(key);
  check(JSON.stringify(app.currentPlaythrough())===before,'repeat render preserves state '+id);
  module.setVisible(false);overlay.classList.remove('active');
  app.state.playthroughs=[JSON.parse(before)];app.state.activePtIndex=0;
  if('MODE'==='mobile')await mobile.openSimForBook(id);
  else{await desktop.showBattleSimForBook(id);button.click();}
  check(overlay.classList.contains('active'),'saved simulator reopens '+id);
  check(JSON.stringify(app.currentPlaythrough())===before,'save/load restoration preserves fight and history '+id);
  module.setVisible(false);overlay.classList.remove('active');
  results.push(id);
}
check(!missingTranslations.size,'missing simulator translations: '+[...missingTranslations].join(', '));
document.body.dataset.test=JSON.stringify({mode:'MODE',width:innerWidth,books:results,writes,productionWrites:0});
