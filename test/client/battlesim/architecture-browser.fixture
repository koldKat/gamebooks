      el(actor+'-pick').value=fighter.id;el(actor+'-pick').dispatchEvent(new Event('change',{bubbles:true}));
      check(state()[actor+'Id']===fighter.id&&['attack','defense','interactive','life'].every(key=>state()[actor][key]===fighter[key]),'European Fighters database profile '+actor+' '+fighter.id);
