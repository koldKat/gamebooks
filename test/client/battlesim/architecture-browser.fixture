const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const check=(value,label)=>{if(!value)throw Error(label);};
let writes=0;
window.fetch=async(url,options={})=>{
  if(options.method&&options.method!=='GET')writes++;
  return new Response(JSON.stringify(url.endsWith('/enemies')?[]:{}),{headers:{'Content-Type':'application/json'}});
};
const results=[];
const missingTranslations=new Set();
for(const id of BOOK_IDS){
  app.setCurrentBookId(id);app.state.playthroughs=[{startedAt:1,path:[1]}];app.state.activePtIndex=0;
  const module=await import('REPO/public/js/battlesim/battlesim'+id+'.js');
  check(module.definition.id===id,'book identity '+id);
  check(['init','render','setVisible'].every(key=>typeof module[key]==='function'),'standard lifecycle '+id);
  if('MODE'==='mobile')await mobile.openSimForBook(id);
  else await desktop.showBattleSimForBook(id);
  const button=document.getElementById(id===829?'battlesim-btn':'sim'+id+'-btn');
  check(button,'trigger '+id);
  const triggerStyle=getComputedStyle(button);
  check(triggerStyle.backgroundColor==='rgba(31, 41, 55, 0.88)'&&triggerStyle.borderTopStyle==='solid'&&triggerStyle.borderTopColor==='rgb(55, 65, 81)'&&triggerStyle.textTransform==='uppercase','themed simulator launcher '+id);
  if('MODE'!=='mobile')button.click();
  const overlay=document.getElementById(id===829?'bsim-overlay':id===8?'s8-overlay':'sim'+id+'-overlay');
  check(overlay?.classList.contains('active'),'opens '+id);
  for(const key of overlay.textContent.match(/battlesim(?:\d+)?\.[\w.]+/g)??[])missingTranslations.add(key);
  for(const control of overlay.querySelectorAll('input[type="checkbox"]')){
    const style=getComputedStyle(control);
    check(style.appearance==='none'&&style.backgroundColor!=='rgb(255, 255, 255)','themed checkbox '+id);
  }
  for(const button of overlay.querySelectorAll('.bsim-action-btn')){
    const style=getComputedStyle(button);
    check(style.backgroundColor==='rgb(31, 41, 55)'&&style.borderTopStyle==='solid','themed action button '+id);
  }
  const right=overlay.querySelector('.bsim-col-right');
  check(!right?.querySelector('input,select,textarea'),'report column contains no setup fields '+id);
  const textSize=parseFloat(getComputedStyle(document.documentElement).fontSize)*0.75;
  for(const control of overlay.querySelectorAll('.bsim-col :is(label,summary,p,h4,legend,input,select,textarea,button:not(.inv-close-btn),.inv-edit-label,.bsim-tech-desc,.bsim-tech-uses,.bsim-effects)')){
    const style=getComputedStyle(control);
    check(Math.abs(parseFloat(style.fontSize)-textSize)<0.1,'consistent readable text '+id+' '+control.className+': '+style.fontSize);
  }
  const left=overlay.querySelector('.bsim-col-left');
  check(parseFloat(getComputedStyle(left).rowGap)<=6,'compact column spacing '+id);
  for(const button of overlay.querySelectorAll('.bsim-col button:not(.inv-close-btn,.inv-qty-btn)')){
    const style=getComputedStyle(button);
    check(parseFloat(style.paddingTop)<=3&&parseFloat(style.paddingBottom)<=3,'compact action padding '+id);
  }
  const fields=[...overlay.querySelectorAll('.inv-edit-row > input.inv-edit-input,.inv-edit-row > select.inv-edit-input')].filter(field=>field.getClientRects().length);
  for(const field of fields){
    check(Math.abs(field.getBoundingClientRect().height-22)<0.1,'consistent compact field height '+id+' '+field.id);
    const label=field.parentElement.querySelector(':scope > span:first-child');
    if(label)check(Math.abs(field.getBoundingClientRect().left-label.getBoundingClientRect().right-5.6)<0.2,'aligned field label '+id+' '+field.id);
  }
  if([570,644,648,654,658,663,665,671,672,700,706,710,718,722,723,724,728,735,757,768,769].includes(id)){
    const title=overlay.querySelector('.inv-modal-title')?.textContent||'';
    check(/[А-Яа-я]/.test(title),'Bulgarian book has Bulgarian simulator title '+id+':'+title);
    check(!/\b(?:Character|Encounter|Programs|Save|Full Moon|Alpha versus Omega)\b/.test(overlay.textContent),'no English UI in Bulgarian simulator '+id);
  }
  if(id===199){
    const game=app.currentPlaythrough().sim199;
    Object.assign(game.player,{skill:10,skillInitial:10,stamina:20,staminaInitial:20,luck:12,luckInitial:12});
    Object.assign(game.enemy,{name:'Test opponent',skill:0,stamina:20,staminaMax:20});game.rolled=true;
    module.render();Math.random=()=>0.5;
    document.getElementById('sim199-round').click();
    check(game.enemy.stamina===18&&game.pendingLuck==='player-hit','extracted round');
    document.getElementById('sim199-luck-yes').click();
    check(game.enemy.stamina===16&&game.player.luck===11&&!game.pendingLuck,'extracted Luck');
  }
  if(id>=674&&id<=680||id===710){
    const el=key=>document.getElementById('sim'+id+'-'+key);
    const editor=overlay.querySelector('.bsim-opponent-editor');
    check(editor,'shared opponent editor '+id);
    const name=editor.querySelector('[role="combobox"]');
    name.focus();
    const option=editor.querySelector('[role="option"]');
    check(option,'autocomplete roster suggestions '+id);
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    check(overlay.classList.contains('active')&&name.getAttribute('aria-expanded')==='false','Escape closes suggestions first '+id);
    name.focus();name.dispatchEvent(new Event('input',{bubbles:true}));
    editor.querySelector('[role="option"]').dispatchEvent(new PointerEvent('pointerdown',{bubbles:true}));
    check(editor.querySelector('[data-stat="stamina"]').value!=='','preset fills editable stats '+id);
    name.value='My custom opponent';
    for(const [key,value] of Object.entries(id===710?{skill:0,stamina:2}:{combat:0,defence:1,stamina:2}))editor.querySelector('[data-stat="'+key+'"]').value=value;
    if(id!==710){
      editor.querySelector(':scope > button').click();
      const second=editor.querySelectorAll('.bsim-opponent-row')[1];
      const secondName=second.querySelector('[role="combobox"]');
      secondName.focus();second.querySelector('[role="option"]').dispatchEvent(new PointerEvent('pointerdown',{bubbles:true}));
      secondName.value='Second custom opponent';
      for(const [key,value]of Object.entries({combat:0,defence:1,stamina:2}))second.querySelector('[data-stat="'+key+'"]').value=value;
    }
    el(id===710?'roll':'create').click();
    el('start').click();
    const state=app.currentPlaythrough()['sim'+id];
    check(state.fight?.config.custom&&(state.fight.enemies[0].combat??state.fight.enemies[0].skill)===0,'custom fight starts without roster requirement '+id);
    check(name.disabled,'setup locked during fight '+id);
    if(id!==710){
      check(state.fight.enemies[0].name===state.fight.enemies[1].name,'test uses duplicate preset identities '+id);
      check(el('status').textContent.includes('My custom opponent')&&el('status').textContent.includes('Second custom opponent'),'distinct custom opponent status labels '+id);
      check([...el('target').options].map(option=>option.textContent).join('|')==='My custom opponent|Second custom opponent','distinct custom opponent target labels '+id);
    }
    el(id===710?'round':'step').click();
    if(id===710&&app.currentPlaythrough().sim710.fight.pending.length)el('skipLuck').click();
    if(id!==710)el('step').click();
    check(state!==app.currentPlaythrough()['sim'+id],'fight updates atomically '+id);
    const finished=app.currentPlaythrough()['sim'+id];
    check(finished.history.at(-1)?.enemy===(id===710?'My custom opponent':'My custom opponent / Second custom opponent (2)'),'custom name preserved in history '+id);
    if(id!==710){
      el('context').value='0';el('context').dispatchEvent(new Event('change'));
      check(!editor.querySelector('[role="combobox"]').value.includes('custom opponent'),'printed presets do not inherit prior custom names '+id);
    }
  }
  if(id===412||id===735){
    const el=key=>document.getElementById('sim'+id+'-'+key);
    const editor=overlay.querySelector('.bsim-opponent-editor');
    const name=editor.querySelector('[role="combobox"]');
    name.value='';name.focus();name.dispatchEvent(new Event('input',{bubbles:true}));
    check(editor.querySelector('[role="option"]'),'autocomplete '+id);
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    check(overlay.classList.contains('active')&&name.getAttribute('aria-expanded')==='false','Escape keeps simulator open '+id);
    name.value='Custom <opponent>';
    for(const [key,value]of Object.entries(id===412?{str:0,hp:2}:{skill:0,stamina:2}))editor.querySelector('[data-stat="'+key+'"]').value=value;
    if(id===735){
      el('weapon').value='lash';
      for(const key of ['skill','skillInitial','stamina','staminaInitial','luck','luckInitial','armour','armourInitial'])el(key).value=key.startsWith('stamina')?20:10;
      el('saveCharacter').click();
      el('mode').value='melee';
    }
    el('start').click();
    const data=app.currentPlaythrough()['sim'+id];
    check(id===412?data.enemyName==='Custom <opponent>'&&data.enemy.str===0:data.fight?.encounterSection===0&&data.fight.enemies[0].name==='Custom <opponent>','manual opponent starts '+id);
    check(name.disabled,'opponent editor locked '+id);
    if(id===412){el('auto').click();check(data.history.at(-1)?.enemy==='Custom <opponent>','custom outcome name '+id);}
    check(!overlay.querySelector('opponent'),'custom name is not HTML '+id);
  }
  if(id>=521&&id<=524){
    const el=key=>document.getElementById('sim'+id+'-'+key);
    const editor=overlay.querySelector('.bsim-opponent-editor');
    const name=editor.querySelector('[role="combobox"]');
    name.focus();
    check(editor.querySelector('[role="option"]'),'Skyfall autocomplete '+id);
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    check(overlay.classList.contains('active')&&name.getAttribute('aria-expanded')==='false','Skyfall Escape closes dropdown '+id);
    if(id===524){
      name.value='Giant Slug';name.dispatchEvent(new Event('input',{bubbles:true}));
      editor.querySelector('[role="option"]').dispatchEvent(new PointerEvent('pointerdown',{bubbles:true}));
      const expertise=editor.querySelector('[data-stat="expertise"]');
      check(!expertise.disabled&&expertise.value==='','custom Skyfall unknown stats remain editable');
    }
    name.value='Custom Skyfall foe';
    for(const [key,value]of Object.entries({expertise:-100,vitality:1,damage:0}))editor.querySelector('[data-stat="'+key+'"]').value=value;
    el('start').click();
    const data=app.currentPlaythrough()['sim'+id];
    check(data.fight?.encounter.custom&&data.fight.encounter.foes[0].name==='Custom Skyfall foe','Skyfall custom fight '+id);
    check(name.disabled,'Skyfall setup locked '+id);
    el('roll').click();el('settle').click();
    check(data.history.at(-1)?.enemy==='Custom Skyfall foe'&&data.fight.status==='win','Skyfall custom outcome '+id);
    if(id===521){
      el('encounter').value='201';el('encounter').dispatchEvent(new Event('change'));
      el('count').value='2';el('count').dispatchEvent(new Event('change'));
      el('start').click();
      check(data.fight.encounter.foes.length===2,'Marsh configurable group starts');
      const saved=JSON.stringify(app.currentPlaythrough());
      app.state.playthroughs=[JSON.parse(saved)];module.render();
      check(el('encounter').value==='201'&&el('count').value==='2','Marsh saved group count restored');
      check(JSON.stringify(app.currentPlaythrough())===saved,'Marsh setup restoration does not mutate saved fight');
      const restored=app.currentPlaythrough().sim521;
      delete restored.opponentSetup;
      const legacy=JSON.stringify(restored);
      app.state.playthroughs=[{...app.currentPlaythrough(),sim521:JSON.parse(legacy)}];module.render();
      check(el('encounter').value==='201'&&el('count').value==='2','legacy Marsh fight restores encounter and group count');
      check(JSON.stringify(app.currentPlaythrough().sim521)===legacy,'legacy Marsh restoration preserves saved state');
      app.state.playthroughs=[JSON.parse(saved)];module.render();
      app.currentPlaythrough().sim521.fight.status='win';module.render();
      el('start').click();
      check(app.currentPlaythrough().sim521.fight.encounter.foes.length===2&&app.currentPlaythrough().sim521.fight.status==='fighting','restored Marsh group can start again');
      data.fight.status='win';
      app.state.playthroughs=[{startedAt:1,path:[1],sim521:data}];module.render();
      el('encounter').value='289';el('encounter').dispatchEvent(new Event('change'));
      const damage=editor.querySelector('[data-stat="damage"]');
      check(!damage.disabled&&damage.value==='','missing Marsh damage requires explicit entry');
      damage.value='3';el('start').click();
      check(data.fight.encounter.section===289&&data.fight.encounter.foes[0].damage===3,'Marsh snake starts with manual damage');
    }
    if(id===524){
      el('encounter').value='141';el('encounter').dispatchEvent(new Event('change'));
      check(editor.querySelector('[data-stat="vitality"]').disabled&&editor.querySelector('[data-stat="vitality"]').value==='','source-null health is unavailable, not zero');
    }
  }
  if(id===636){
    const el=key=>document.getElementById('sim636-'+key);
    const editor=overlay.querySelector('.bsim-opponent-editor');
    const name=editor.querySelector('[role="combobox"]');
    name.focus();check(editor.querySelector('[role="option"]'),'Wonderland autocomplete');
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    name.value='Custom Wonderland foe';
    editor.querySelector('[data-stat="combat"]').value=0;
    editor.querySelector('[data-stat="endurance"]').value=.5;
    el('initiative').value='player';el('start').click();
    const data=app.currentPlaythrough().sim636;
    check(data.fight?.encounter.custom&&data.fight.enemies[0].endurance===.5,'Wonderland custom half-point stats');
    check(name.disabled,'Wonderland setup locked');
    const legacy=structuredClone(app.currentPlaythrough());
    delete legacy.sim636.opponentSetup;
    Object.assign(legacy.sim636.setup,{'sim636-encounter':'78',
      'sim636-enemy0Combat':'0','sim636-enemy0Endurance':'4.5',
      'sim636-enemy1Combat':'5','sim636-enemy1Endurance':'9.5'});
    const saved=JSON.stringify(legacy);
    app.state.playthroughs=[legacy];module.render();
    const rows=editor.querySelectorAll('.bsim-opponent-row');
    check(rows.length===2&&rows[0].querySelector('[data-stat="combat"]').value==='0'
      &&rows[0].querySelector('[data-stat="endurance"]').value==='4.5'
      &&rows[1].querySelector('[data-stat="combat"]').value==='5'
      &&rows[1].querySelector('[data-stat="endurance"]').value==='9.5','legacy Wonderland edited opponents restored');
    check(JSON.stringify(app.currentPlaythrough())===saved,'legacy Wonderland restoration preserves saved fight');
    legacy.sim636.fight.status='cancelled';module.render();el('start').click();
    check(app.currentPlaythrough().sim636.fight.enemies[0].combat===0
      &&app.currentPlaythrough().sim636.fight.enemies[0].endurance===4.5
      &&app.currentPlaythrough().sim636.fight.enemies[1].endurance===9.5,'legacy Wonderland settings start the next fight');
  }
  if(id===570){
    const el=key=>document.getElementById('sim570-'+key);
    const name=overlay.querySelector('[role="combobox"]');
    name.focus();check(overlay.querySelector('[role="option"]'),'Virtual Police autocomplete');
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    name.value='Ръчно въведен противник';
    for(const [prefix,values]of Object.entries({player:{attack:10,defence:10,damage:10,life:30},enemy:{attack:1,defence:1,damage:1,life:1}})){
      for(const[key,value]of Object.entries(values))el(prefix+'_'+key).value=value;
    }
    el('start').click();
    const data=app.currentPlaythrough().sim570;
    check(data.fight?.status==='fighting'&&data.encounter==='Ръчно въведен противник','Virtual Police custom fight');
    check(name.disabled,'Virtual Police setup locked');
  }
  if(id===648){
    const el=key=>document.getElementById('sim648-'+key);
    el('configure').click();
    const editor=overlay.querySelector('.bsim-opponent-editor');
    const name=editor.querySelector('[role="combobox"]');
    name.focus();check(editor.querySelector('[role="option"]'),'Space Scout autocomplete');
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    name.value='Тестов кораб';editor.querySelector('[data-stat="attack"]').value=1;
    editor.querySelector('[data-stat="shields"]').value=10;
    for(let i=0;i<3;i++)editor.querySelector(':scope > button').click();
    for(const [index,row]of [...editor.querySelectorAll('.bsim-opponent-row')].entries()){
      row.querySelector('[role="combobox"]').value=index===0?'Тестов кораб':'Тестов кораб '+index;
      row.querySelector('[data-stat="attack"]').value=0;
      row.querySelector('[data-stat="shields"]').value=1;
    }
    el('start').click();
    const data=app.currentPlaythrough().sim648;
    check(data.fight?.enemies[0].name==='Тестов кораб'&&data.fight.enemies.length===4&&data.encounter.startsWith('Тестов кораб /'),'Space Scout custom group');
    check(name.disabled,'Space Scout setup locked');
    const random=Math.random;Math.random=()=>.5;
    try{for(let i=0;i<4;i++)el('attack').click();}finally{Math.random=random;}
    check(app.currentPlaythrough().sim648.fight.status==='win','Space Scout resolves all four custom opponents');
    const legacy=structuredClone(app.currentPlaythrough());
    delete legacy.sim648.opponentSetup;
    Object.assign(legacy.sim648.setup,{'sim648-enemyAttack':'0','sim648-enemyShields':'247'});
    const saved=JSON.stringify(legacy);
    app.state.playthroughs=[legacy];module.render();
    check(editor.querySelector('[data-stat="attack"]').value==='0'
      &&editor.querySelector('[data-stat="shields"]').value==='247','legacy Space Scout edited opponent restored');
    check(JSON.stringify(app.currentPlaythrough())===saved,'legacy Space Scout restoration preserves saved fight');
    el('start').click();
    check(app.currentPlaythrough().sim648.fight.enemies[0].attack===0
      &&app.currentPlaythrough().sim648.fight.enemies[0].shields===247,'legacy Space Scout settings start the next fight');
  }
  if(id>=527&&id<=533){
    const el=key=>document.getElementById('sim'+id+'-'+key);
    const state=app.currentPlaythrough()['sim'+id];
    Object.assign(state.player,{life:40,maxLife:40});module.render();
    const editor=overlay.querySelector('.bsim-opponent-editor');
    check(editor&&!editor.hidden,'Grailquest custom setup '+id);
    const name=editor.querySelector('[role="combobox"]');
    name.focus();check(editor.querySelector('[role="option"]'),'Grailquest autocomplete '+id);
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    name.value='Custom Grailquest foe';
    for(const[key,value]of Object.entries({life:6,hit:12,bonus:0,armour:0}))editor.querySelector('[data-stat="'+key+'"]').value=value;
    el('start').click();
    const fight=app.currentPlaythrough()['sim'+id].fight;
    check(fight?.spec.custom&&fight.foes[0].name==='Custom Grailquest foe'&&fight.foes[0].life===6,'Grailquest custom fight '+id);
    check(name.disabled,'Grailquest custom setup locked '+id);
    check(!el('status').textContent.includes('enemy_names.'),'Grailquest custom labels '+id);
  }
  if([665,671,672,718,722,723,724].includes(id)){
    const el=key=>document.getElementById('sim'+id+'-'+key);
    el('roll').click();
    const editor=overlay.querySelector('.bsim-opponent-editor');
    check(editor&&!editor.hidden,'FF custom setup '+id);
    const name=editor.querySelector('[role="combobox"]');
    name.focus();check(editor.querySelector('[role="option"]'),'FF autocomplete '+id);
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    name.value='Свободен противник';
    editor.querySelector('[data-stat="skill"]').value=0;
    editor.querySelector('[data-stat="stamina"]').value=2;
    el('start').click();
    const fight=app.currentPlaythrough()['sim'+id].fight;
    check(fight?.config.custom&&fight.enemies[0].displayName==='Свободен противник','FF custom fight '+id);
    check(name.disabled,'FF custom setup locked '+id);
    check(!el('status').textContent.includes('enemy.custom'),'FF custom labels '+id);
  }
  if(id===555||id===557){
    const el=key=>document.getElementById('sim'+id+'-'+key);
    const editor=overlay.querySelector('.bsim-opponent-editor');
    const name=editor.querySelector('[role="combobox"]');
    name.focus();check(editor.querySelector('[role="option"]'),'threshold autocomplete '+id);
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    name.value='Custom threshold fight';
    editor.querySelector('[data-stat="threshold1"]').value=1;
    editor.querySelector('[data-stat="threshold2"]').value=1;
    el('start').click();
    const data=app.currentPlaythrough()['sim'+id];
    check(data.fight?.spec.custom&&name.disabled,'threshold custom fight '+id);
    el('roll').click();el('roll').click();
    check(data.history.at(-1)?.enemy==='Custom threshold fight','threshold custom result '+id);
    check(!/\b(?:null|undefined)\b/.test(el('status').textContent),'custom result has no invalid destination '+id);
  }
  if(id===757){
    const el=key=>document.getElementById('sim757-'+key);
    check(el('encounter').value==='attackers'&&!el('advancedRules').open,'True Magic defaults to combat, not narrative helpers');
    el('apply').click();
    const editor=overlay.querySelector('.bsim-opponent-editor');
    const names=[...editor.querySelectorAll('[role="combobox"]')];
    names[0].focus();check(editor.querySelector('[role="option"]'),'True Magic autocomplete');
    names[0].dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    for(const input of editor.querySelectorAll('[data-stat="defence"],[data-stat="stamina"]'))input.value=5;
    el('start').click();
    const fight=app.currentPlaythrough().sim757.fight;
    check(fight?.kind==='attackers'&&fight.enemies.length===3&&names[0].disabled,'True Magic editable attacker fight');
  }
  if(id===728){
    const el=key=>document.getElementById('sim728-'+key);
    const editor=overlay.querySelector('.bsim-opponent-editor');
    const name=editor.querySelector('[role="combobox"]');
    name.focus();check(editor.querySelector('[role="option"]'),'Golden Galleon autocomplete');
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    name.value='Пиратски кораб';editor.querySelector('[data-stat="durability"]').value=45;
    el('start').click();
    const fight=app.currentPlaythrough().sim728.fight;
    check(fight?.pirates.A.name==='Пиратски кораб'&&fight.pirates.A.durability===45&&name.disabled,'Golden Galleon manual opponents');
  }
  if(id===654){
    const el=key=>document.getElementById('sim654-'+key);
    for(const details of overlay.querySelectorAll('details'))details.open=true;
    const name=overlay.querySelector('[role="combobox"]');
    name.focus();check(overlay.querySelector('[role="option"]'),'Orc Power autocomplete');
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    name.value='Ръчно въведена фигура';
    for(const key of ['attack','defence','shooting','damage','life','magicPower','magicDamage'])el(key).value=key==='life'?10:1;
    el('add').click();
    check(app.currentPlaythrough().sim654.figures[0]?.displayName==='Ръчно въведена фигура','Orc Power custom figure');
  }
  if(id>=534&&id<=537){
    const el=key=>document.getElementById('sim'+id+'-'+key);
    const editor=overlay.querySelector('.bsim-opponent-editor');
    check(editor&&!editor.hidden,'Demonspawn custom setup '+id);
    const name=editor.querySelector('[role="combobox"]');
    name.focus();check(editor.querySelector('[role="option"]'),'Demonspawn autocomplete '+id);
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    name.value='Custom Demonspawn foe';
    for(const field of editor.querySelectorAll('[data-stat]'))field.value=['weapon','armour','shield','power'].includes(field.dataset.stat)?0:40;
    el('start').click();
    const data=app.currentPlaythrough()['sim'+id];
    const encounter=id===534?data.prepared?.encounter:data.fight?.encounter;
    const enemy=id===534?data.fight?.enemy:data.fight?.enemies[0];
    check(encounter?.custom&&enemy?.name==='Custom Demonspawn foe','Demonspawn custom fight '+id);
    check(name.disabled,'Demonspawn editor locked '+id);
  }
  if([539,548,550,644,658,663,689,690,700].includes(id)){
    const el=key=>document.getElementById('sim'+id+'-'+key);
    if(id===644){el('context').value='manual';el('context').dispatchEvent(new Event('change',{bubbles:true}));}
    if(id===663)el('roll').click();
    if([689,690].includes(id))el('create').click();
    const editor=[...overlay.querySelectorAll('.bsim-opponent-editor')].find(e=>!e.hidden);
    check(editor,'custom opponent setup '+id);
    const name=editor.querySelector('[role="combobox"]');
    name.focus();check(editor.querySelector('[role="option"]'),'custom opponent autocomplete '+id);
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    check(overlay.classList.contains('active'),'autocomplete Escape preserves simulator '+id);
    if(id===663)for(let i=0;i<3;i++)editor.querySelector(':scope > button').click();
    name.value='Custom opponent';
    const values={attributeCode:1,attributeValue:1,mentality:2,mental:0,disbelief:0,
      dexterity:1,staminaDamage:1,enduranceDamage:0,playerThreshold:1,enemyThreshold:13,
      modifier:0,killsPerHit:1,attack:0,points:1,playerPoints:100,playerEndurance:10,
      endurance:1,aggression:1,skillCode:1,damageCode:1,weaponCode:0};
    for(const field of editor.querySelectorAll('[data-stat]'))field.value=values[field.dataset.stat]??Math.max(1,Number(field.min));
    el(id===550?'prepare':'start').click();
    const fight=app.currentPlaythrough()['sim'+id].fight;
    check(fight,'custom fight starts '+id);
    const enemy=fight.enemies?.[0]??fight.opponents?.[0]??fight.enemy;
    check(id===644?fight.displayName==='Custom opponent':id===658?fight.config.name==='Custom opponent':(enemy?.displayName??enemy?.name)==='Custom opponent','custom opponent name '+id);
    check(name.disabled,'custom editor locks during fight '+id);
    if(id===663){
      check(fight.enemies.length===4,'custom Freeway group has four opponents');
      for(const enemy of fight.enemies.slice(0,3)){enemy.health=0;enemy.defeated=true;}
      module.render();check(el('target').value==='3','fourth Freeway opponent selected');
      const random=Math.random;Math.random=()=>.5;
      try{el('step').click();}finally{Math.random=random;}
      check(app.currentPlaythrough().sim663.fight.status==='win','fourth custom Freeway opponent can be fought');
    }
    if(id===700){
      fight.outcome='cancelled';el('mode').value='shooting';el('mode').dispatchEvent(new Event('change'));
      const shooting=[...overlay.querySelectorAll('.bsim-opponent-editor')].find(e=>!e.hidden);
      shooting.querySelector('[role="combobox"]').value='Custom gunfighter';
      for(const field of shooting.querySelectorAll('[data-stat]'))field.value=1;
      for(const key of ['weapon-power','weapon-range','weapon-weight','setup-playerCover'])el(key).value=1;
      el('start').click();
      const next=app.currentPlaythrough().sim700.fight;
      check(next.mode==='shooting'&&next.custom&&next.opponents[0].displayName==='Custom gunfighter','custom shooting fight');
      app.currentPlaythrough().sim700=structuredClone({...app.currentPlaythrough().sim700,
        fight:{...next,pending:{kind:'conversion',reason:'manual-unarmed-stats'}}});module.render();
      const conversion=[...overlay.querySelectorAll('.bsim-opponent-editor')].find(e=>!e.hidden&&e!==shooting);
      check(conversion,'manual melee conversion setup');
      conversion.querySelector('[data-stat="endurance"]').value='15';
      el('apply').click();
      check(conversion.querySelector('[data-stat="endurance"]').value==='15','stat edits preserve manual conversion draft');
    }
  }
  if(id===769){
    const el=key=>document.getElementById('sim769-'+key);
    const state=()=>app.currentPlaythrough().sim769;
    const editor=overlay.querySelector('.bsim-opponent-editor');
    const name=editor.querySelector('[role="combobox"]');
    name.focus();check(editor.querySelector('[role="option"]'),'Dungeon autocomplete');
    name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
    check(overlay.classList.contains('active')&&name.getAttribute('aria-expanded')==='false','Dungeon autocomplete Escape');
    el('newCharacter').click();
    check(state().character.provisions===10&&state().character.potionUses===1,'Dungeon new character defaults');
    el('luck').value=0;el('saveCharacter').click();
    el('encounter').value='294';el('encounter').dispatchEvent(new Event('change',{bubbles:true}));
    editor.querySelector('[data-stat="skill"]').value=0;
    el('start').click();
    check(state().fight.config.skillModifier===-2,'Dungeon dagger penalty');
    check(el('saveCharacter').disabled&&editor.querySelector('input').disabled,'Dungeon setup locked');
    const random=Math.random;Math.random=()=>.5;
    try{
      el('round').click();check(state().fight.pending[0]?.kind==='weakPoint','Dungeon mandatory weak-point Luck');
      check(el('skipLuck').disabled,'Dungeon mandatory Luck cannot be skipped');
      el('useLuck').click();check(state().fight.outcome==='continue'&&state().fight.destination===21,'Dungeon first miss continues');
      check(!el('continueFight').hidden&&el('start').disabled,'Dungeon continuation prevents fresh fight reset');
      const stamina=state().character.stamina;
      el('continueFight').click();check(state().character.stamina===stamina,'Dungeon continuation preserves current HP');
      el('round').click();el('useLuck').click();
      check(state().fight.outcome==='loss'&&state().fight.destination===116,'Dungeon second miss fatal');
      check(state().history.length===1,'Dungeon completed outcome recorded once');
      check(el('start').disabled&&el('eat').disabled&&el('drinkPotion').disabled,'Dungeon fatal outcome blocks fighting and recovery');
      el('saveCharacter').click();
      el('encounter').value='0';el('encounter').dispatchEvent(new Event('change',{bubbles:true}));
      editor.querySelector('[role="combobox"]').value='Ръчен противник';
      editor.querySelector('[data-stat="skill"]').value=0;
      editor.querySelector('[data-stat="stamina"]').value=1;
      el('start').click();el('round').click();el('skipLuck').click();
      check(state().fight.outcome==='win'&&state().fight.enemies[0].displayName==='Ръчен противник','Dungeon custom fight');
      check(state().history.length===2,'Dungeon custom win history');
    }finally{Math.random=random;}
  }
  const before=JSON.stringify(app.currentPlaythrough());module.render();
  for(const key of overlay.textContent.match(/battlesim(?:\d+)?\.[\w.]+/g)??[])missingTranslations.add(key);
  check(JSON.stringify(app.currentPlaythrough())===before,'repeat render preserves state '+id);
  module.setVisible(false);overlay.classList.remove('active');
  app.state.playthroughs=[JSON.parse(before)];app.state.activePtIndex=0;
  if('MODE'==='mobile')await mobile.openSimForBook(id);
  else{await desktop.showBattleSimForBook(id);button.click();}
  check(overlay.classList.contains('active'),'saved simulator reopens '+id);
  check(JSON.stringify(app.currentPlaythrough())===before,'save/load restoration preserves fight and history '+id);
  module.setVisible(false);overlay.classList.remove('active');
  results.push(id);
}
check(!missingTranslations.size,'missing simulator translations: '+[...missingTranslations].join(', '));
document.body.dataset.test=JSON.stringify({mode:'MODE',width:innerWidth,books:results,writes,productionWrites:0});
