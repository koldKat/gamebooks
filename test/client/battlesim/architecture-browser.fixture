    const el=key=>document.getElementById('sim772-'+key),state=()=>app.currentPlaythrough().sim772,random=Math.random;
    const pick=id=>{el('enemy-pick').value=id;el('enemy-pick').dispatchEvent(new Event('change',{bubbles:true}));};
    try{
      Math.random=()=>0;Object.keys(state().player).forEach(key=>state().player[key]=100);
      for(const enemy of ROSTER){
        pick(enemy.id);el('atk-hand').click();const expected=kungFuEnemy(enemy);
        check(state().enemyId===enemy.id&&['defLeg','atkLeg','defHand','atkHand','defComb','atkComb'].every(key=>state()._liveEnemy[key]===expected[key]),'Kung Fu database stats and revised overrides '+enemy.id);
        check(JSON.stringify(state()._liveEnemy.dodge)===JSON.stringify(enemy.dodge),'Kung Fu database dodge list '+enemy.id);
      }
      pick('lin_bao_rescue');el('def-passive').click();el('def-aggressive').click();el('def-aggressive').click();
      check(state().enemyAttacks===2&&state().enemyLastAction==='defend'&&state().roundIdx===3,'Kung Fu database attack limit switches to defense');
      check(el('def-passive').disabled,'Kung Fu passive defense stays once per fight');
      pick('steve_train');const d=state();
      Object.assign(d,{rulesVersion:1,roundIdx:3,started:true,playerResults:['draw','win'],enemyResults:['draw','loss'],_liveEnemy:{...kungFuEnemy(ROSTER.find(enemy=>enemy.id==='steve_train'),false),defHand:17},extension:{keep:true}});
      const saved=JSON.stringify(d),history=d.history.length;module.render();module.render();check(JSON.stringify(state())===saved,'Kung Fu render preserves legacy rules, results and altered opponent');
      el('atk-hand').click();
      check(state().rulesVersion===1&&state().roundIdx===4&&state()._liveEnemy.defHand===17&&state()._liveEnemy.defLeg===null&&state().extension.keep&&state().history.length===history+1,'Kung Fu saved legacy fight resumes without revised stat replacement');
    }finally{Math.random=random;}
  }
  if(id===760){
