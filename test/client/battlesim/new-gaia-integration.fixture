// Exercise printed BODY/SPIRIT encounters through the actual desktop/mobile loaders.
localStorage.setItem('gamebook_lang','LANGUAGE');
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const seeds=ROSTER_SEEDS,check=(value,label)=>{if(!value)throw Error(label);};
window.fetch=async(url)=>new Response(JSON.stringify(seeds[String(url).match(/\/api\/books\/(\d+)\/enemies$/)?.[1]]??{}),{headers:{'Content-Type':'application/json'}});
console.warn=(message,error)=>{if(error instanceof Error)throw error;};
const run={startedAt:1,path:[1],inventory:[{name:'Kept',qty:2}],equipment:{weapon:'Original'},sim1608:{unchanged:true}};
app.setCurrentBookId(410);app.state.playthroughs=[run];app.state.activePtIndex=0;
if('MODE'==='mobile')await mobile.openSimForBook(410);else await desktop.showBattleSimForBook(410);
const module=await import('REPO/public/js/battlesim/battlesim410.js');
const source=await import('REPO/public/js/battlesim/books/410/definition.js');
const trigger=document.getElementById('sim410-btn');if('MODE'!=='mobile')trigger.click();
const overlay=document.getElementById('sim410-overlay'),left=overlay.querySelector('.bsim-col-left');
const controls=()=>document.getElementById('sim410-controls'),data=()=>run.sim410;
const field=(root,key)=>root.querySelector('[data-field="'+key+'"]');
const button=(root,key)=>root.querySelector('[data-action="'+key+'"]');
const start=()=>button(left,'start').click();
const cancel=()=>{button(left,'cancel').click();document.getElementById('confirm-ok').click();};
const roll=(a,b)=>{field(controls(),'die1').value=a;field(controls(),'die2').value=b;button(controls(),'attack').click();};
const choose=profile=>{
  const input=left.querySelector('[role="combobox"]');input.value='';input.dispatchEvent(new FocusEvent('focus'));
  const options=[...left.querySelectorAll('[role="option"]')];check(options.length===31,'all thirty-one source encounters');
  const option=options.find(node=>node.textContent.includes('(§'+profile.section+')'));check(option,'source encounter offered');
  option.dispatchEvent(new PointerEvent('pointerdown',{bubbles:true,cancelable:true}));
};
const stats=(body,hp)=>{field(left,'currentBody').value=body;field(left,'currentSpirit').value=hp;};
const preserved=JSON.stringify([run.path,run.inventory,run.equipment,run.sim1608]);
for(const [i,profile]of source.ENCOUNTERS.entries()){
  choose(profile);stats(10,1000);
  const rows=[...left.querySelectorAll('[data-stat="body"]')];
  check(rows.length===profile.enemies.length&&rows.every((node,j)=>Number(node.value)===profile.enemies[j].body),'printed BODY and group size');
  check([...left.querySelectorAll('[data-stat="hp"]')].every((node,j)=>Number(node.value)===profile.enemies[j].hp),'printed SPIRIT');
  start();check(data().fight.phase==='player'&&data().fight.player.body===10,'player first');
  check(field(left,'currentBody').disabled&&left.querySelector('[role="combobox"]').disabled,'active setup locked');
  check(!overlay.querySelector('.bsim-col-right input'),'results have no setup');
  const active=JSON.stringify(data());module.render();check(JSON.stringify(data())===active,'render preserves active fight');
  let turns=0;while(data().fight.status==='fighting'&&turns++<30){
    if(button(controls(),'suckerTurn'))button(controls(),'suckerTurn').click();else roll(6,6);
  }
  check(data().fight.status==='win'&&data().history.length===i+1,'source victory saved once');
  const won=JSON.stringify(data());module.render();check(JSON.stringify(data())===won,'render preserves outcome');
}
const custom=()=>{button(left,'custom').click();left.querySelector('[role="combobox"]').value='Training foe';left.querySelector('[data-stat="body"]').value=4;left.querySelector('[data-stat="hp"]').value=8;stats(5,7);};
custom();start();check(data().fight.opponent.name==='Training foe','custom fight needs no preset');
roll(3,3);check(data().fight.enemies[0].hp===1,'printed player damage');
roll(3,3);check(data().fight.player.hp===2,'printed enemy damage');
field(controls(),'die1').value=1;field(controls(),'die2').value=1;const stale=button(controls(),'attack');stale.click();
check(data().fight.status==='win','custom victory');const won=JSON.stringify(data());stale.click();check(JSON.stringify(data())===won,'stale action cannot duplicate outcome');
const preset=sid=>choose(source.ENCOUNTERS.find(row=>row.section===String(sid)));
preset(71);stats(5,30);start();roll(1,1);roll(1,1);
check(data().fight.player.hp===24,'two other guards add damage');cancel();
preset(99);stats(5,30);start();roll(1,1);roll(1,1);
check(data().fight.player.hp===24,'all three assassins add damage');cancel();
preset(153);stats(5,30);start();roll(1,1);roll(1,1);
check(data().fight.player.hp===25,'three other Ildan add damage');cancel();
preset(125);stats(5,30);field(left,'weapon').value='rpg';start();roll(3,3);
check(data().fight.enemies[0].hp===2&&data().fight.enemies[1].hp===3,'RPG damages both targets');
roll(1,1);roll(6,6);check(data().fight.status==='win','RPG group victory');
preset(120);stats(5,30);field(left,'weapon').value='twins';start();roll(1,1);
check(data().fight.enemies[0].hp===9,'Pablo Twins and dim-light penalty combine');cancel();
custom();left.querySelector('[data-stat="hp"]').value=50;field(left,'weapon').value='none';
field(left,'shield').checked=true;field(left,'vest').checked=true;field(left,'healingPatch').checked=true;start();roll(1,1);
field(controls(),'vestDie').value=1;roll(3,3);
check(data().fight.player.hp===5&&data().fight.events.at(-1).vestDie===1,'shield and failed vest before patch');
roll(1,1);field(controls(),'vestDie').value=6;roll(3,3);
check(data().fight.player.hp===5,'successful vest absorbs remaining damage');cancel();
custom();left.querySelector('[data-stat="hp"]').value=50;field(left,'shield').checked=false;field(left,'vest').checked=false;start();roll(1,1);roll(3,3);
check(data().fight.player.hp===4.5&&field(left,'currentSpirit').value==='4.5','fractional SPIRIT persists in actual controls');cancel();
field(left,'healingPatch').checked=false;
custom();start();const live=JSON.stringify(data());button(left,'cancel').click();app.setCurrentBookId(9999);document.getElementById('confirm-ok').click();
check(JSON.stringify(data())===live,'delayed cancel respects book');app.setCurrentBookId(410);trigger.click();cancel();
check(data().fight.status==='cancelled'&&data().history.at(-1).outcome==='cancelled','cancel is not a victory');
const old=JSON.stringify(data());app.state.playthroughs=[{startedAt:2,path:[1]}];app.state.activePtIndex=0;start();
check(app.currentPlaythrough().sim410===undefined,'stale setup respects run');app.state.playthroughs=[run];app.state.activePtIndex=0;trigger.click();
check(JSON.stringify(data())===old,'original run retained');check(JSON.stringify([run.path,run.inventory,run.equipment,run.sim1608])===preserved,'story and unrelated simulator untouched');
for(const input of overlay.querySelectorAll('input:not([type="checkbox"])'))check(input.autocomplete==='off','browser autocomplete disabled');
for(const key of overlay.textContent.match(/battlesim410\.[\w.]+/g)??[])throw Error('Missing translation '+key);
check(overlay.querySelector('.inv-modal').scrollWidth<=overlay.querySelector('.inv-modal').clientWidth+2,'no dialog overflow');
document.body.dataset.test=JSON.stringify({mode:'MODE',language:'LANGUAGE',width:innerWidth,sourceEncounters:31,sourceOpponents:44,
  allSourceStats:true,customCombat:true,supportDamage:true,areaDamage:true,equipment:true,fractionalSpirit:true,runAndBookIsolation:true,historyOnce:true,productionWrites:0});
