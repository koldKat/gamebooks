// Verify the installed encounters and printed example through both real loaders.
localStorage.setItem('gamebook_lang','LANGUAGE');
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const seeds=ROSTER_SEEDS,check=(value,label)=>{if(!value)throw Error(label);};
window.fetch=async url=>new Response(JSON.stringify(seeds[String(url).match(/\/api\/books\/(\d+)\/enemies$/)?.[1]]??{}),{headers:{'Content-Type':'application/json'}});
console.warn=(message,error)=>{if(error instanceof Error)throw error;};
const run={startedAt:1,path:[1],inventory:[{name:'Kept'}],sim286:{unchanged:true}};
app.setCurrentBookId(8);app.state.playthroughs=[run];app.state.activePtIndex=0;
if('MODE'==='mobile')await mobile.openSimForBook(8);else await desktop.showBattleSimForBook(8);
const module=await import('REPO/public/js/battlesim/battlesim8.js');
const trigger=document.getElementById('sim8-btn');if('MODE'!=='mobile')trigger.click();
const overlay=document.getElementById('s8-overlay'),el=key=>document.getElementById('s8-'+key),data=()=>run.sim8;
for(let i=0;i<100&&!overlay.querySelector('.bsim-opponent-row');i++)await new Promise(resolve=>setTimeout(resolve,20));
check(overlay.querySelector('.bsim-opponent-row'),'setup loaded');
check(el('encounter').options.length===37,'all 36 source-backed presets');
await new Promise(resolve=>setTimeout(resolve,0));
const encounterButton=el('encounter').parentElement.querySelector('[role=combobox]');
check(encounterButton&&getComputedStyle(el('encounter')).display==='none','Andalusia uses the shared custom dropdown');
encounterButton.click();
const encounterMenu=document.getElementById(encounterButton.getAttribute('aria-controls'));
const bounds=encounterMenu.getBoundingClientRect();
check(!encounterMenu.hidden&&bounds.left>=0&&bounds.right<=innerWidth&&bounds.bottom<=innerHeight,'Andalusia dropdown fits the viewport');
encounterButton.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true,cancelable:true}));
check(encounterMenu.hidden&&overlay.classList.contains('active'),'Andalusia menu Escape does not close the simulator');
const unrelated=JSON.stringify([run.path,run.inventory,run.sim286]);
const select=section=>{const row=seeds[8].find(e=>e.stats?.encounter.section===section);el('encounter').value=row.id;el('encounter').dispatchEvent(new Event('change'));return row.stats.encounter;};
for(const row of seeds[8].filter(e=>e.stats?.encounter)){
  el('encounter').value=row.id;el('encounter').dispatchEvent(new Event('change'));
  const fields=[...overlay.querySelectorAll('.bsim-opponent-row')];
  check(fields.length===(row.stats.encounter.repeatCount?.initial||row.stats.encounter.opponents.length),'fixed preset count '+row.name);
  fields.forEach((field,i)=>{const source=row.stats.encounter.opponents[row.stats.encounter.repeatCount?0:i];check(Number(field.querySelector('[data-stat="skill"]').value)===source.skill&&Number(field.querySelector('[data-stat="lifeMax"]').value)===source.lifeMax,'printed stats '+row.name);});
  check([...overlay.querySelectorAll('.bsim-opponent-row button')].every(button=>button.hidden),'preset cannot drop opponents');
}
select('218');
check(el('soldiers').options.length===7,'one encounter with seven remaining-count choices');
for(const count of [2,8]){
  el('soldiers').value=String(count);el('soldiers').dispatchEvent(new Event('change'));
  check(overlay.querySelectorAll('.bsim-opponent-row').length===count,'remaining soldiers update the fight');
}
el('apply').click();
check(data().group.remaining.length===7&&data().enemy.skill===3&&data().enemy.lifeMax===3,'eight printed soldiers prepared');
el('reset').click();
el('encounter').value='';el('encounter').dispatchEvent(new Event('change'));
let row=overlay.querySelector('.bsim-opponent-row');row.querySelector('[role="combobox"]').value='Soldier';row.querySelector('[data-stat="skill"]').value=3;row.querySelector('[data-stat="lifeMax"]').value=6;
overlay.querySelector('.bsim-opponent-editor > button').click();
row=overlay.querySelectorAll('.bsim-opponent-row')[1];row.querySelector('[role="combobox"]').value='Captain';row.querySelector('[data-stat="skill"]').value=4;row.querySelector('[data-stat="lifeMax"]').value=4;
el('player-skill').value=4;el('player-skill').dispatchEvent(new Event('input'));el('player-life').value=12;el('player-life').dispatchEvent(new Event('input'));
el('apply').click();check(data().group.remaining.length===1,'custom group starts without preset');
el('opponent-choices').querySelector('button').click();check(data().enemy.name==='Captain','choose first opponent');
const originalRandom=Math.random,rolls=[];Math.random=()=>{check(rolls.length,'unexpected random roll');return (rolls.shift()-.5)/6;};
try{
  rolls.push(1,4,4,6);el('round').click();
  check(data().player.life===12&&data().history.length===0&&data().awaitingOpponent,'no retaliation or premature reward');
  check(el('player-skill').disabled&&el('encounter').disabled,'setup locked between duels');
  el('opponent-choices').querySelector('button').click();check(data().enemy.foeFirst,'later opponent attacks first');
  rolls.push(3,2,4,3,4,4,5);el('round').click();check(data().player.life===11&&data().enemy.life===3,'printed example first soldier round');
  rolls.push(1,4,6,2,4,6,6);el('round').click();check(data().player.life===8&&data().history.length===1,'printed example final outcome');
  el('round').click();check(data().history.length===1,'outcome once');
  select('25');el('apply').click();el('item-bow').checked=true;el('item-bow').dispatchEvent(new Event('change'));el('arrows').value=3;el('arrows').dispatchEvent(new Event('input'));
  check(el('bow-fire').style.display==='none','forbidden bow hidden');
  el('item-chainmail').checked=true;el('item-chainmail').dispatchEvent(new Event('change'));
  rolls.push(1,1,1,1,4,5,6);el('round').click();check(data().pendingAttack&&el('round').disabled,'chainmail interrupts before damage');
  const snapshot=JSON.stringify(data());module.render();check(JSON.stringify(data())===snapshot,'render does not resolve pending strike');
  rolls.push(1);el('chainmail-choice').querySelector('[data-reroll="2"]').click();check(data().chainmailUsed&&!data().pendingAttack,'selected armor die resolves');
  const before=JSON.stringify(data());module.render();check(JSON.stringify(data())===before,'active render does not reset fight');
  el('reset').click();
  data().enemy.life=1;
  const selected=select('79');
  const startingArrows=data().items.arrows;
  rolls.push(6);el('bow-fire').click();
  check(data().enemy.name===selected.opponents[0].displayName&&data().enemy.life===selected.opponents[0].lifeMax-2,'arrow attacks selected encounter rather than the previous enemy');
  check(data().group.remaining.length===2&&data().items.arrows===startingArrows-1,'arrow preserves all three selected soldiers and spends one arrow');
  const afterArrow=JSON.stringify(data());el('apply').click();
  check(el('apply').disabled&&JSON.stringify(data())===afterArrow,'prepare cannot reset an encounter after shooting');
  el('reset').click();
  el('encounter').value='';el('encounter').dispatchEvent(new Event('change'));
  let first=overlay.querySelector('.bsim-opponent-row');
  first.querySelector('[role=combobox]').value='First soldier';first.querySelector('[data-stat="skill"]').value=2;first.querySelector('[data-stat="lifeMax"]').value=1;
  overlay.querySelector('.bsim-opponent-editor > button').click();overlay.querySelector('.bsim-opponent-editor > button').click();
  [...overlay.querySelectorAll('.bsim-opponent-row')].slice(1).forEach((field,i)=>{
    field.querySelector('[role=combobox]').value='Remaining soldier '+i;
    field.querySelector('[data-stat="skill"]').value=3;
    field.querySelector('[data-stat="lifeMax"]').value=4;
  });
  const historyBefore=data().history.length;
  rolls.push(6);el('bow-fire').click();
  check(data().enemy.life===0&&data().group.remaining.length===2&&data().awaitingOpponent,'shooting one of three soldiers leaves exactly two');
  check(data().history.length===historyBefore&&el('apply').disabled,'an arrow casualty neither completes nor resets a group');
}finally{Math.random=originalRandom;}
const legacy={player:{skill:3,life:9,lifeMax:23},enemy:{name:'Капитан',skill:5,life:2,lifeMax:5,foeFirst:true},round:20,log:[],history:[{outcome:'win',ts:1}],items:{bow:false,arrows:0,chainmail:true},bowFired:false,sixWins:false};
run.sim8=structuredClone(legacy);module.render();check(JSON.stringify(run.sim8)===JSON.stringify(legacy),'legacy state retained exactly');
check(JSON.stringify([run.path,run.inventory,run.sim286])===unrelated,'story and unrelated simulator retained');
check(!/battlesim(?:8|\.editor)\./.test(overlay.textContent),'all Bulgarian labels resolved');
check(overlay.querySelector('.inv-modal').scrollWidth<=overlay.querySelector('.inv-modal').clientWidth+2,'no dialog overflow');
document.body.dataset.test=JSON.stringify({mode:'MODE',language:'LANGUAGE',width:innerWidth,presets:36,customGroup:true,printedExample:true,chainmail:true,legacyPreserved:true,productionWrites:0});
