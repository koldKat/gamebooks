localStorage.setItem('gamebook_lang','LANGUAGE');
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const seeds=ROSTER_SEEDS,check=(value,label)=>{if(!value)throw Error(label);};
let requests=0,writes=0;
window.fetch=async(url,options={})=>{
  if(options.method&&options.method!=='GET')writes++;
  const id=String(url).match(/\/api\/books\/(\d+)\/enemies$/)?.[1];
  if(id)requests++;
  return new Response(JSON.stringify(id?(seeds[id]||[]):{}),{headers:{'Content-Type':'application/json'}});
};
console.warn=(message,error)=>{if(error instanceof Error)throw error;};
app.setCurrentBookId(1534);app.state.playthroughs=[{startedAt:1,path:[1]}];app.state.activePtIndex=0;
if('MODE'==='mobile')await mobile.openSimForBook(1534);else await desktop.showBattleSimForBook(1534);
const module=await import('REPO/public/js/battlesim/battlesim1534.js');
const {getRoster}=await import('REPO/public/js/battlesim/books/1534/definition.js');
const {realLifeTurn}=await import('REPO/public/js/battlesim/engines/real-life/core.js');
const el=key=>document.getElementById('sim1534-'+key),current=()=>app.currentPlaythrough().sim1534;
const set=(key,value)=>{const input=el(key);check(input,'missing '+key);if(input.type==='checkbox')input.checked=value;else input.value=value;};
const choose=(key,value)=>{set(key,value);el(key).dispatchEvent(new Event('change',{bubbles:true}));};
const click=key=>{el(key).click();check(!document.getElementById('confirm-overlay')?.classList.contains('active'),'unexpected alert '+document.getElementById('confirm-message')?.textContent);};
const next=(a=6,b=6)=>{set('die1',a);set('die2',b);click('attack');};
function fresh(){app.state.playthroughs=[{startedAt:1,path:[1],inventory:['Story key'],sim8:{keep:true}}];module.render();}
const protectedState=()=>JSON.stringify([app.currentPlaythrough().inventory,app.currentPlaythrough().sim8,app.currentPlaythrough().path]);
const enemyFields=key=>[...el('opponents').querySelectorAll('[data-stat="'+key+'"]')];
const results=[];
check(!el('firearm')&&el('agility')&&el('luck')&&el('javelin'),'book-specific current combat fields');
check(new Set([...el('overlay').querySelectorAll('[id]')].map(e=>e.id)).size===el('overlay').querySelectorAll('[id]').length,'unique control IDs');
fresh();choose('encounter','custom');choose('manualDice',true);
enemyFields('skill')[0].value=0;enemyFields('wounds')[0].value=1;
const untouched=protectedState();click('start');
check(current().fight.status==='fighting','custom fight without roster selection');
check(el('encounter').disabled&&el('wounds').disabled&&enemyFields('skill')[0].disabled,'setup locked');
check(!el('setup').open,'setup collapses during combat');
const saved=JSON.stringify(current());module.render();check(JSON.stringify(current())===saved,'render preserves fight');
el('close').click();el('btn').click();check(current().fight.cursor===0,'reopen retains turn');
next(1,1);check(current().fight.status==='win'&&current().history.length===1,'custom win and history');
module.render();check(current().history.length===1&&protectedState()===untouched,'once-only history and unrelated state');
results.push('custom encounter, setup lock, reopen and once-only history');

fresh();choose('encounter','custom');choose('weapon','javelin');choose('manualDice',true);
choose('javelin',6);choose('sword',0);enemyFields('wounds')[0].value=4;click('start');next(3,3);
check(current().fight.opponents[0].wounds===2&&current().fight.log[0].skill===6,'custom javelin uses own skill and two Wounds');
results.push('custom javelin');

fresh();choose('encounter','custom');choose('manualDice',true);enemyFields('wounds')[0].value=10;
click('start');next();next(3,3);const wounds=current().fight.hero.wounds;el('cancel').click();
check(document.getElementById('confirm-overlay').classList.contains('active'),'cancel confirmation');
document.getElementById('confirm-ok').click();
check(current().fight.status==='cancelled'&&current().history.length===0&&current().player.wounds===wounds,'cancel retains Wounds');
fresh();choose('encounter','custom');click('start');el('cancel').click();
app.state.playthroughs=[{startedAt:2,path:[1]}];module.render();document.getElementById('confirm-ok').click();
check(!current(),'stale cancellation rejected');results.push('cancel and live run isolation');

let restored=0,opponentRows=0;
for(const entry of getRoster()){
  fresh();choose('encounter',entry.section);choose('manualDice',true);
  for(const key of ['strength','sword','javelin','agility','luck','horsemanship'])set(key,99);
  set('wounds',1000);
  for(const input of enemyFields('skill'))if(input.value===''&&!input.disabled)input.value=7;
  click('start');check(current().fight.encounter.section===entry.section,'source preset '+entry.section);
  check(current().fight.opponents.length===entry.opponents.length,'source group '+entry.section);opponentRows+=entry.opponents.length;
  check(el('encounter').disabled&&el('weapon').disabled&&el('luck').disabled,'source setup lock '+entry.section);
  for(let i=0;current().fight.status==='fighting';i++){
    check(i<100,'source fight stalled '+entry.section);
    const turn=realLifeTurn(current().fight),own=turn.attacker==='hero';next(own?1:6,own?1:6);
    if(i%2===0){app.currentPlaythrough().sim1534=JSON.parse(JSON.stringify(current()));const before=JSON.stringify(current());module.render();check(JSON.stringify(current())===before,'saved turn changed');restored++;}
  }
  check(current().fight.status==='win'&&current().history.length===1,'source fight outcome/history '+entry.section);
}
check(opponentRows===63,'complete source opponent rows');results.push('all36 source encounters with63 opponents and saved turn reloads');

for(const [section,target]of[['120','264'],['199','135']]){
  fresh();choose('encounter',section);choose('manualDice',true);click('start');
  check(el('luck-roll').disabled&&!el('luck-roll').hidden,'Luck roll button visible but unavailable before a full round');next();next();next();
  check(!el('luck-roll').disabled&&el('luck').disabled,'Luck roll available while current Luck setup remains locked');set('die1',3);set('die2',3);click('luck-roll');
  check(current().fight.status==='interrupted'&&current().fight.destination===target&&current().history.length===0,'distinct Luck route without win XP');
}
results.push('optional Luck interruptions');

fresh();choose('encounter','25');choose('manualDice',true);click('start');next();
check(el('luck-roll').hidden,'Luck roll hidden outside printed Luck encounters');
check(!current().fight.hero.mounted&&realLifeTurn(current().fight).attacker==='enemy0','pre-round horse failure skips attack');
next(3,3);check(current().fight.log.at(-1).skill===9,'mounted enemy gains one skill');
fresh();choose('encounter','242');choose('manualDice',true);click('start');next();next();next();
check(current().fight.hero.mounted&&realLifeTurn(current().fight).attacker==='hero','post-round failure does not dismount or skip');
results.push('distinct horse rules');

fresh();choose('encounter','40');choose('charge',true);choose('manualDice',true);click('start');set('target','enemy1');next(3,3);
check(current().fight.opponents[1].outOfFight&&current().fight.opponents[1].wounds===3,'charge knocks selected foe out without wounds');
fresh();choose('encounter','75');choose('manualDice',true);click('start');next();
check(realLifeTurn(current().fight).attacker==='enemy0','failed initiative Agility lets sailor attack first');
results.push('charge and initiative');

fresh();choose('encounter','251');choose('manualDice',true);click('start');choose('both',true);next(2,2);
check(current().fight.round===1&&current().fight.hero.wounds===4&&JSON.stringify(current().fight.opponents.map(e=>e.wounds))==='[1,2]','successful group attack prevents replies');
fresh();choose('encounter','260');choose('manualDice',true);
check(enemyFields('skill')[0].disabled&&enemyFields('skill')[0].value==='','deliberately no enemy skill remains disabled and blank');
click('start');check(el('defensive').disabled,'boar cannot be parried');next();next();
check(current().fight.hero.wounds===2&&current().fight.opponents[0].skill===null,'boar uses failed Agility for two Wounds');
results.push('simultaneous attack and boar avoidance');

check(!el('overlay').querySelector('.bsim-col-right input,.bsim-col-right select,.bsim-col-right button'),'results only on right');
const bounds=el('overlay').querySelector('.inv-modal').getBoundingClientRect();
check(bounds.left>=-1&&bounds.right<=innerWidth+1,'modal fits');
check(document.documentElement.scrollWidth<=innerWidth+1,'no document overflow');
check(requests===1,'roster fetched once through real lazy loader');
document.body.dataset.test=JSON.stringify({mode:'MODE',language:'LANGUAGE',width:innerWidth,cases:results,encounters:getRoster().length,opponentRows,restored,requests,writes,productionWrites:0});
