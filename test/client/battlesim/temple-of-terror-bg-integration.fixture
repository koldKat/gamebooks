const checks = [], saves = [];
const assert = (value, label) => { if (!value) throw Error(label); checks.push(label); };
window.fetch = async (url, options = {}) => {
  assert(url === '/api/books/710/state' && options.method === 'PUT', 'only intercepted state saves');
  saves.push(JSON.parse(options.body)); return new Response('{}', {status: 200});
};
const app = await import('REPO/public/js/core/state.js');
const desktop = await import('REPO/public/js/battlesim/loader.js');
const mobile = await import('REPO/public/mobile/js/battlesim-dispatch.js');
const {t} = await import('REPO/public/js/i18n.js');
const {registerTranslations} = await import('REPO/public/js/i18n/runtime.js');
const {loadBattleSimTranslations} = await import('REPO/public/js/i18n/battlesim.js');
const mode = 'MODE', language = 'LANGUAGE', el = key => document.getElementById('sim710-' + key);
assert(!el('overlay'), 'lazy mount'); assert(mobile.hasSim(710), 'mobile registry');
await loadBattleSimTranslations(710);
if (language === 'bg') registerTranslations((await import('REPO/public/js/i18n/bg/battlesim/battlesim710.js')).default);
app.setCurrentBookId(710);
const run = {startedAt: 123, path: [1], sim210: {preserved: true}};
app.state.playthroughs = [run]; app.state.activePtIndex = 0;
const open = async () => { if (mode === 'mobile') await mobile.openSimForBook(710); else { await desktop.showBattleSimForBook(710); el('btn').click(); } };
const change = (key, value) => { el(key).value = value; el(key).dispatchEvent(new Event('change')); };
const key = (target, code, name) => target.dispatchEvent(new KeyboardEvent('keydown', {code, key: name, bubbles: true}));
await open(); assert(el('overlay').classList.contains('active'), 'actual lazy loader opens');
assert(!el('overlay').textContent.includes('battlesim710.'), 'translated UI');
assert(el('title').textContent === t('battlesim710.title'), 'translated title');
assert(run.sim710.character === null && el('start').disabled, 'manual character required');
const ids = [...el('overlay').querySelectorAll('[id]')].map(node => node.id);
assert(new Set(ids).size === ids.length, 'unique controls');
assert(el('encounter').options.length === 32, 'all named encounters');
assert([...el('encounter').options].every(option => !/^(Section|Епизод)\s+\d/.test(option.textContent)), 'names before section numbers');
for (const [field, value] of Object.entries({skill: 99, skillInitial: 99, stamina: 20, staminaInitial: 24,
  luck: 0, luckInitial: 12, provisions: 10, gold: 25, attackModifier: 0})) el(field).value = value;
el('apply').click(); assert(run.sim710.character.stamina === 20, 'manual ratings saved');
change('spell', 'water'); el('cast').click(); assert(run.sim710.character.stamina === 20, 'free water costs zero');
el('eat').click(); assert(run.sim710.character.stamina === 24 && run.sim710.character.provisions === 9, 'printed provision healing');
el('stamina').value = 20; el('apply').click();
change('encounter', '274'); el('start').click();
assert(el('target').options.length === 2 && !el('target').disabled, 'simultaneous target selection');
assert(el('apply').disabled && el('encounter').disabled, 'active fight setup locked');
change('target', '1');
Math.random = () => 0.99;
for (let i = 0; i < 3; i++) el('round').click();
assert(run.sim710.fight.enemies[1].stamina === 0 && run.sim710.fight.enemies[0].stamina === 5, 'selected enemy only wounded');
assert(!run.sim710.fight.outcome && el('target').value === '0', 'remaining target selected');
for (let i = 0; i < 3; i++) el('round').click();
assert(run.sim710.fight.outcome === 'win' && run.sim710.history.length === 1, 'both enemies defeated, one reward');
el('round').click(); assert(run.sim710.history.length === 1, 'disabled round cannot duplicate result');
el('again').click(); assert(run.sim710.character.stamina === 20, 'next fight does not refill health');
change('encounter', '346'); assert(!el('unknownStatNote').hidden, 'unreadable source value disclosed');
el('manualStamina').value = '8'; el('start').click();
assert(run.sim710.fight.enemies[1].stamina === 8, 'explicit manual stamina used');
for (let i = 0; i < 7; i++) el('round').click();
assert(run.sim710.fight.outcome === 'win' && run.sim710.history.length === 2, 'sequential enemies both defeated');
el('again').click(); change('encounter', '363');
const hero = JSON.stringify(run.sim710.character); el('start').click(); el('round').click();
assert(run.sim710.fight.ally.stamina === 9 && JSON.stringify(run.sim710.character) === hero, 'eagle uses own stats, preserves player');
await app.saveState(); assert(saves.at(-1).playthroughs[0].sim710.history.length === 2, 'real persistence payload');
const original = JSON.stringify(run);
key(document.activeElement, 'Escape', 'Escape'); assert(!el('overlay').classList.contains('active'), 'Escape closes');
await open(); assert(JSON.stringify(run) === original, 'reopening preserves active fight');
if (mode === 'desktop') {
  key(document.body, 'KeyS', 's'); assert(!el('overlay').classList.contains('active'), 'shortcut closes');
  key(document.body, 'KeyS', 's'); assert(el('overlay').classList.contains('active'), 'shortcut opens');
  key(el('skill'), 'KeyS', 's'); assert(el('overlay').classList.contains('active'), 'typing shortcut safe');
}
for (const details of el('overlay').querySelectorAll('details')) details.open = true;
for (const node of el('overlay').querySelectorAll('.bsim-col')) {
  node.scrollTop = Number.MAX_SAFE_INTEGER;
  assert(Math.abs(node.scrollTop - Math.max(0, node.scrollHeight - node.clientHeight)) <= 1, 'column bottom reachable');
  node.scrollTop = 0; assert(node.scrollTop === 0, 'column top reachable');
}
assert(document.documentElement.scrollWidth <= innerWidth + 1, 'no page overflow');
assert(getComputedStyle(el('start')).fontSize === getComputedStyle(el('round')).fontSize, 'consistent action typography');
assert(JSON.stringify(run.sim210) === '{"preserved":true}', 'other simulator preserved');
app.state.playthroughs.push({startedAt: 456, path: [1]}); app.state.activePtIndex = 1;
const module = await import('REPO/public/js/battlesim/battlesim710.js'); module.render();
assert(!el('overlay').classList.contains('active'), 'run change closes stale panel');
el('apply').click(); assert(!app.currentPlaythrough().sim710, 'stale controls cannot edit another run');
await open(); assert(app.currentPlaythrough().sim710.character === null, 'fresh run isolated');
assert(JSON.stringify(run) === original, 'previous run unchanged');
document.body.dataset.test = JSON.stringify({mode, language, width: innerWidth, checks: checks.length, saves: saves.length, realModules: true, productionWrites: 0});
