const checks = [], saves = [];
const assert = (value, label) => { if (!value) throw Error(label); checks.push(label); };
window.fetch = async (url, options = {}) => {
  if(url==='/api/books/676/enemies' && !options.method) return new Response(JSON.stringify(ROSTER_SEED),{status:200,headers:{'Content-Type':'application/json'}});
  assert(url === '/api/books/676/state' && options.method === 'PUT', 'only simulator state saves');
  saves.push(JSON.parse(options.body));
  return new Response('{}', { status: 200, headers: { 'Content-Type': 'application/json' } });
};
const app = await import('REPO/public/js/core/state.js');
const desktop = await import('REPO/public/js/battlesim/loader.js');
const mobile = await import('REPO/public/mobile/js/battlesim-dispatch.js');
import { BLOOD_DARK_FIGHTS } from 'REPO/public/js/battlesim/engines/fabled-lands/blood-dark-sea.js';
assert(!document.getElementById('sim676-overlay'), 'lazy panel');
app.setCurrentBookId(676);
const run = { startedAt: 123, path: [1], sim675: { preserved: true } };
app.state.playthroughs = [run]; app.state.activePtIndex = 0;
const mode = 'MODE';
const el = key => document.getElementById('sim676-' + key);
const open = async () => {
  if (mode === 'mobile') await mobile.openSimForBook(676);
  else { await desktop.showBattleSimForBook(676); el('btn').click(); }
};
await open();
assert(el('overlay').classList.contains('active'), 'real loader opens panel');
assert(!el('overlay').textContent.includes('battlesim676.'), 'translated visible labels');
assert(run.sim676.character === null && saves.length === 0, 'opening creates no character');
assert(el('context').options.length === 16 && el('context').options[0].value === '-1' && el('seaContext').options.length === 37, 'book-specific roster and utilities');
assert(getComputedStyle(el('btn')).borderRadius === '7px', 'themed button');
el('create').click();
assert(run.sim676.character.rank === 3 && run.sim676.character.stamina === 16
  && run.sim676.character.shards === 40 && run.sim676.character.armour === 3, 'book-three defaults');
el('context').value = String(BLOOD_DARK_FIGHTS.findIndex(f => f.section === 73));
el('context').dispatchEvent(new Event('change', { bubbles: true }));
el('start').click();
assert(!el('flee').hidden && el('context').disabled, 'escape available while setup locked');
Math.random = () => .499;
el('flee').click();
assert(run.sim676.fight.status === 'fled' && run.sim676.fight.destination === 44, 'source escape destination');
assert(run.sim676.character.stamina === 10 && run.sim676.history.length === 0, 'escape wounds without XP reward');
el('seaContext').value = '142'; el('seaRoll').click();
assert(run.sim676.character.stamina === 0 && run.sim676.log.at(-1).includes('123'), 'local survival death');
assert(run.sim675.preserved === true, 'other simulator preserved');
await app.saveState();
assert(saves.at(-1).playthroughs[0].sim676.character.stamina === 0, 'actual state persistence');
el('combat').closest('details').open = true;
for (const [field, value] of Object.entries({ combat: 100, stamina: 1000, staminaInitial: 1000 })) el(field).value = String(value);
el('apply').click();
const initialHistory = run.sim676.history.length;
for (let index = 0; index < BLOOD_DARK_FIGHTS.length; index++) {
  el('context').value = String(index);
  el('context').dispatchEvent(new Event('change', { bubbles: true }));
  el('start').click();
  assert(el('apply').disabled && el('context').disabled, 'active encounter locks setup ' + index);
  let rounds = 0;
  while (run.sim676.fight.status === 'fighting' && rounds++ < 10) el('step').click();
  assert(run.sim676.fight.status === 'win' && run.sim676.fight.destination === BLOOD_DARK_FIGHTS[index].win, 'complete named encounter ' + index);
  assert(run.sim676.history.length === initialHistory + index + 1, 'one history result per encounter ' + index);
}
await app.saveState();
assert(saves.at(-1).playthroughs[0].sim676.history.length === initialHistory + 15, 'all encounter results persist');
for (const node of el('overlay').querySelectorAll('details')) node.open = true;
const body = el('overlay').querySelector('.bsim-body');
body.scrollTop = Number.MAX_SAFE_INTEGER;
assert(Math.abs(body.scrollTop - Math.max(0, body.scrollHeight - body.clientHeight)) <= 1, 'scroll reaches bottom');
assert(document.documentElement.scrollWidth <= innerWidth + 1 && body.scrollWidth <= body.clientWidth + 1, 'no overflow');
el('close').dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
assert(!el('overlay').classList.contains('active'), 'Escape closes');
const preserved = JSON.stringify(run);
app.state.playthroughs.push({ startedAt: 456, path: [1] }); app.state.activePtIndex = 1;
await open();
assert(app.currentPlaythrough().sim676.character === null && JSON.stringify(run) === preserved, 'run isolation');
document.body.setAttribute('data-test', JSON.stringify({ mode, width: innerWidth, checks: checks.length,
  saves: saves.length, encounters: 15, realModules: true, productionWrites: 0 }));
