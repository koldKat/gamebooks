const checks = [], saves = [];
const rosterSeed = ROSTER_SEEDS[718];
const assert = (value, label) => { if (!value) throw Error(label); checks.push(label); };
window.fetch = async (url, options = {}) => {
  if (url === '/api/books/718/enemies' && !options.method) return new Response(JSON.stringify(rosterSeed), {status: 200});
  assert(url === '/api/books/718/state' && options.method === 'PUT', 'only intercepted state saves');
  saves.push(JSON.parse(options.body)); return new Response('{}', {status: 200});
};
const app = await import('REPO/public/js/core/state.js');
const desktop = await import('REPO/public/js/battlesim/loader.js');
const mobile = await import('REPO/public/mobile/js/battlesim-dispatch.js');
const {t} = await import('REPO/public/js/i18n.js');
const {registerTranslations} = await import('REPO/public/js/i18n/runtime.js');
const {loadBattleSimTranslations} = await import('REPO/public/js/i18n/battlesim.js');
const mode = 'MODE', language = 'LANGUAGE', el = key => document.getElementById('sim718-' + key);
assert(!el('overlay'), 'lazy mount'); assert(mobile.hasSim(718), 'mobile registry');
await loadBattleSimTranslations(718);
if (language === 'bg') registerTranslations((await import('REPO/public/js/i18n/bg/battlesim/battlesim718.js')).default);
app.setCurrentBookId(718);
const run = {startedAt: 123, path: [1], sim215: {preserved: true}};
app.state.playthroughs = [run]; app.state.activePtIndex = 0;
const open = async () => { if (mode === 'mobile') await mobile.openSimForBook(718); else { await desktop.showBattleSimForBook(718); el('btn').click(); } };
const change = (key, value) => { el(key).value = value; el(key).dispatchEvent(new Event('change')); };
const key = (target, code, name) => target.dispatchEvent(new KeyboardEvent('keydown', {code, key: name, bubbles: true}));
await open(); assert(el('overlay').classList.contains('active'), 'actual lazy loader opens');
assert(!el('overlay').textContent.includes('battlesim718.'), 'translated UI');
assert(el('title').textContent === t('battlesim718.title'), 'translated title');
assert(run.sim718.character === null && el('start').disabled, 'manual character required');
const ids = [...el('overlay').querySelectorAll('[id]')].map(node => node.id);
assert(new Set(ids).size === ids.length, 'unique controls');
assert(el('encounter').options.length === 41, 'all named encounters');
assert([...el('encounter').options].every(option => !/^(Section|Епизод)\s+\d/.test(option.textContent)), 'names before section numbers');
for (const [field, value] of Object.entries({skill: 99, skillInitial: 99, stamina: 20, staminaInitial: 24,
  luck: 0, luckInitial: 12, provisions: 10, gold: 0, attackModifier: 0, weaponModifier: 0, nextFightModifier: 0})) el(field).value = value;
el('talisman').checked = true; el('swiftstinger').checked = true;
el('apply').click(); assert(run.sim718.character.stamina === 20, 'manual ratings saved');
el('eat').click(); assert(run.sim718.character.stamina === 24 && run.sim718.character.provisions === 9, 'printed provision healing');
el('testTalisman').click(); assert(!run.sim718.character.talisman && run.sim718.character.luck === 0, 'talisman works at zero Luck');
el('stamina').value = 20; el('apply').click();
change('encounter', '168'); el('start').click();
assert(el('target').options.length === 3 && !el('target').disabled, 'simultaneous target selection');
assert(el('apply').disabled && el('encounter').disabled && el('eat').disabled, 'active fight setup and recovery locked');
change('target', '2'); Math.random = () => 0.99; el('swiftAttack').click();
assert(run.sim718.fight.enemies[2].stamina === 0 && !run.sim718.character.swiftstinger, 'Swiftstinger consumes once and targets chosen arm');
for (let i = 0; i < 6; i++) el('round').click();
assert(run.sim718.fight.outcome === 'win' && run.sim718.history.length === 1, 'all arms defeated, one reward');
el('round').click(); assert(run.sim718.history.length === 1, 'disabled round cannot duplicate result');
el('again').click(); assert(run.sim718.character.stamina === 20, 'next fight does not refill health');
change('encounter', '13'); el('remainingBatFish').value = '2'; el('start').click();
assert(run.sim718.fight.enemies.length === 2, 'remaining Batfish option applied');
for (let i = 0; i < 4; i++) el('round').click();
assert(run.sim718.history.length === 2, 'sequential survivors all defeated');
el('again').click(); change('encounter', '109');
el('previousOgreStamina').value = '7'; el('start').click();
assert(run.sim718.fight.enemies[0].stamina === 11, 'earlier Ogre injury plus four recovery');
for (let i = 0; i < 6; i++) el('round').click();
el('again').click(); change('encounter', '253');
el('axeFish').checked = true; el('sawFish').checked = true; el('start').click();
assert(run.sim718.fight.enemies[0].stamina === 16 && run.sim718.fight.enemies[0].skill === 8, 'cumulative Kraken injuries applied');
for (let i = 0; i < 8; i++) el('round').click();
el('again').click(); change('encounter', '273'); assert(el('eat').disabled && el('sauna').disabled, 'no recovery between linked fights');
change('encounter', '218'); el('allyStamina').value = '3'; el('start').click();
assert(run.sim718.fight.ally.stamina === 3 && !el('allyStatus'), 'ally uses explicit current health');
await app.saveState(); assert(saves.at(-1).playthroughs[0].sim718.history.length === 4, 'real persistence payload');
const original = JSON.stringify(run);
key(document.activeElement, 'Escape', 'Escape'); assert(!el('overlay').classList.contains('active'), 'Escape closes');
await open(); assert(JSON.stringify(run) === original, 'reopening preserves active fight');
if (mode === 'desktop') {
  key(document.body, 'KeyS', 's'); assert(!el('overlay').classList.contains('active'), 'shortcut closes');
  key(document.body, 'KeyS', 's'); assert(el('overlay').classList.contains('active'), 'shortcut opens');
  key(el('skill'), 'KeyS', 's'); assert(el('overlay').classList.contains('active'), 'typing shortcut safe');
}
for (const details of el('overlay').querySelectorAll('details')) details.open = true;
for (const node of el('overlay').querySelectorAll('.bsim-col')) {
  node.scrollTop = Number.MAX_SAFE_INTEGER;
  assert(Math.abs(node.scrollTop - Math.max(0, node.scrollHeight - node.clientHeight)) <= 1, 'column bottom reachable');
  node.scrollTop = 0; assert(node.scrollTop === 0, 'column top reachable');
  assert(node.scrollWidth <= node.clientWidth + 1, 'no horizontal column overflow');
}
assert(document.documentElement.scrollWidth <= innerWidth + 1, 'no page overflow');
assert(getComputedStyle(el('start')).fontSize === getComputedStyle(el('round')).fontSize, 'consistent action typography');
assert(JSON.stringify(run.sim215) === '{"preserved":true}', 'other simulator preserved');
app.state.playthroughs.push({startedAt: 456, path: [1]}); app.state.activePtIndex = 1;
const module = await import('REPO/public/js/battlesim/battlesim718.js'); module.render();
assert(!el('overlay').classList.contains('active'), 'run change closes stale panel');
el('apply').click(); assert(!app.currentPlaythrough().sim718, 'stale controls cannot edit another run');
await open(); assert(app.currentPlaythrough().sim718.character === null, 'fresh run isolated');
assert(JSON.stringify(run) === original, 'previous run unchanged');
document.body.dataset.test = JSON.stringify({mode, language, width: innerWidth, checks: checks.length, saves: saves.length, realModules: true, productionWrites: 0});
