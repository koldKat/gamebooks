const checks=[],saves=[];
const assert=(value,label)=>{if(!value)throw Error(label);checks.push(label);};
window.fetch=async(url,options={})=>{
  assert(url==='/api/books/678/state'&&options.method==='PUT','only simulator saves');
  saves.push(JSON.parse(options.body));
  return new Response('{}',{status:200,headers:{'Content-Type':'application/json'}});
};
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const {HIDDEN_FIGHTS}=await import('REPO/public/js/battlesim/engines/fabled-lands/hidden-faces.js');
app.setCurrentBookId(678);
const run={startedAt:123,path:[1],sim677:{preserved:true}};
app.state.playthroughs=[run];app.state.activePtIndex=0;
const mode='MODE',el=key=>document.getElementById('sim678-'+key);
const open=async()=>{if(mode==='mobile')await mobile.openSimForBook(678);else{await desktop.showBattleSimForBook(678);el('btn').click();}};
await open();
assert(el('overlay').classList.contains('active'),'real loader opens');
assert(!el('overlay').textContent.includes('battlesim678.'),'translated labels');
assert(el('context').options.length===27&&el('seaContext').options.length===11,'complete source encounters and ship checks');
assert(getComputedStyle(el('btn')).borderRadius==='7px','themed button');
assert(run.sim678.character===null&&saves.length===0,'open creates no character');
el('profession').value='warrior';el('create').click();
assert(run.sim678.character.rank===5&&run.sim678.character.stamina===23&&run.sim678.character.combat===8,'book-five defaults');
el('defenceThroughFaith').checked=true;el('apply').click();
el('context').value=String(HIDDEN_FIGHTS.findIndex(f=>f.section===203));
el('context').dispatchEvent(new Event('change',{bubbles:true}));el('start').click();
assert(run.sim678.fight.defence===19&&!run.sim678.character.defenceThroughFaith,'one-fight defence blessing');
let dice=[0,0,.999,.999];Math.random=()=>dice.shift();el('step').click();
assert(run.sim678.character.combat===7&&run.sim678.fight.defence===18,'vampire COMBAT and Defence drain');
run.sim678.fight.enemies[0].stamina=1;Math.random=()=>.999;el('step').click();
assert(run.sim678.fight.status==='win'&&run.sim678.character.combat===8&&run.sim678.fight.destination===412,'temporary drain restored');
assert(run.sim678.history.length===1&&run.sim677.preserved,'result recorded and other sim preserved');
await app.saveState();assert(saves.at(-1).playthroughs[0].sim678.character.combat===8,'state persistence');
for(const node of el('overlay').querySelectorAll('details'))node.open=true;
const body=el('overlay').querySelector('.bsim-body');body.scrollTop=Number.MAX_SAFE_INTEGER;
assert(Math.abs(body.scrollTop-Math.max(0,body.scrollHeight-body.clientHeight))<=1,'scroll reaches bottom');
assert(document.documentElement.scrollWidth<=innerWidth+1&&body.scrollWidth<=body.clientWidth+1,'no overflow');
el('close').dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
assert(!el('overlay').classList.contains('active'),'Escape closes');
const preserved=JSON.stringify(run);
app.state.playthroughs.push({startedAt:456,path:[1]});app.state.activePtIndex=1;await open();
assert(app.currentPlaythrough().sim678.character===null&&JSON.stringify(run)===preserved,'run isolation');
document.body.setAttribute('data-test',JSON.stringify({mode,width:innerWidth,checks:checks.length,saves:saves.length,encounters:27,realModules:true,productionWrites:0}));
