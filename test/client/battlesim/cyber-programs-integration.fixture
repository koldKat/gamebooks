const checks=[],saves=[];
const assert=(value,label)=>{if(!value)throw Error(label);checks.push(label);};
window.fetch=async(url,options={})=>{
  assert(url==='/api/books/758/state'&&options.method==='PUT','only intercepted state saves');
  saves.push(JSON.parse(options.body));return new Response('{}',{status:200,headers:{'Content-Type':'application/json'}});
};
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const {registerTranslations}=await import('REPO/public/js/i18n/runtime.js');
const {loadBattleSimTranslations}=await import('REPO/public/js/i18n/battlesim.js');
const mode='MODE',language='LANGUAGE',el=key=>document.getElementById('sim758-'+key);
assert(!el('overlay')&&mobile.hasSim(758),'lazy mount and mobile registry');
await loadBattleSimTranslations(758);
if(language==='bg')registerTranslations((await import('REPO/public/js/i18n/bg/battlesim/battlesim758.js')).default);
app.setCurrentBookId(758);
const run={startedAt:123,path:[1],sim757:{preserved:true}};
app.state.playthroughs=[run];app.state.activePtIndex=0;
const open=async()=>{if(mode==='mobile')await mobile.openSimForBook(758);else{await desktop.showBattleSimForBook(758);el('btn').click();}};
const change=(key,value)=>{el(key).value=value;el(key).dispatchEvent(new Event('change'));};
const key=(target,code,name=code.slice(3))=>target.dispatchEvent(new KeyboardEvent('keydown',{code,key:name,bubbles:true}));
const own=(type,index,uses=3)=>{el('owned-'+type+index).checked=true;el('uses-'+type+index).value=uses;};
await open();
assert(el('overlay').classList.contains('active'),'actual lazy loader opens');
assert(!el('overlay').textContent.includes('battlesim758.'),'translated labels');
assert(Object.values(run.sim758.ledger.programs).every(p=>!p.owned&&p.remaining===0),'no programs invented');
const ids=[...el('overlay').querySelectorAll('[id]')].map(node=>node.id);
assert(new Set(ids).size===ids.length,'unique controls');
assert(getComputedStyle(el('btn')).borderTopStyle==='solid','themed simulator button');
own('antivirus',0);own('key',0);own('virus',1);el('safety').checked=true;el('apply').click();
el('resolve').click();
assert(run.sim758.fight.section==='A19'&&run.sim758.fight.outcome==='win','Alpha Ivy counter');
assert(run.sim758.ledger.programs.antivirus0.remaining===2&&run.sim758.history.length===1,'activation and single reward');
assert(el('apply').disabled&&el('recharge').disabled&&el('resolve').disabled,'completed encounter locked');
el('resolve').click();assert(run.sim758.history.length===1,'duplicate click no repeat');
el('again').click();change('encounter','8');change('program','key0');el('resolve').click();
assert(run.sim758.fight.outcome==='blocked'&&run.sim758.ledger.programs.key0.remaining===2,'wrong key spent but nonfatal');
assert(run.sim758.history.length===1,'blocked door no win reward');
el('again').click();change('program','virus1');el('resolve').click();
assert(run.sim758.fight.section==='A80'&&run.sim758.fight.outcome==='win','door retry with virus');
el('again').click();change('encounter','18');el('rescue').click();
assert(run.sim758.fight.outcome==='escape'&&!run.sim758.ledger.safety,'single-use manual rescue');
assert(run.sim758.ledger.programs.virus1.remaining===2&&run.sim758.history.length===2,'rescue spends no program or reward');
el('again').click();assert(el('rescue').disabled,'spent safety unavailable');
el('recharge').click();assert(run.sim758.ledger.programs.virus1.remaining===3&&!run.sim758.ledger.programs.virus2.owned,'reentry recharges only owned');
change('clan','O');
assert(!el('owned-virus1').checked&&el('uses-virus1').value==='0','clan change does not silently grant counterparts');
own('virus',0);el('apply').click();change('encounter','13');change('program','virus0');el('resolve').click();
assert(run.sim758.fight.section==='O31'&&run.sim758.fight.outcome==='win','Omega distinct guard counter');
el('again').click();change('encounter','15');el('resolve').click();
assert(run.sim758.fight.section==='O33'&&run.sim758.fight.outcome==='loss','wrong virus fatal');
assert(run.sim758.history.length===4,'exact terminal outcome count');
await app.saveState();assert(saves.at(-1).playthroughs[0].sim758.history.length===4,'actual save payload');
const original=JSON.stringify(run);
key(document.activeElement,'Escape','Escape');assert(!el('overlay').classList.contains('active'),'Escape closes');
await open();assert(JSON.stringify(run)===original,'reopen preserves saved state');
if(mode==='desktop'){
  key(document.body,'KeyS','s');assert(!el('overlay').classList.contains('active'),'shortcut closes');
  key(document.body,'KeyS','s');assert(el('overlay').classList.contains('active'),'shortcut opens');
  key(el('uses-virus0'),'KeyS','s');assert(el('overlay').classList.contains('active'),'typing safe');
}
for(const details of el('overlay').querySelectorAll('details'))details.open=true;
for(const node of el('overlay').querySelectorAll('.bsim-col')){
  node.scrollTop=Number.MAX_SAFE_INTEGER;
  assert(Math.abs(node.scrollTop-Math.max(0,node.scrollHeight-node.clientHeight))<=1,'bottom reachable');
  node.scrollTop=0;assert(node.scrollTop===0,'top reachable');
}
assert(document.documentElement.scrollWidth<=innerWidth+1,'no horizontal overflow');
assert(JSON.stringify(run.sim757)==='{"preserved":true}','other simulator preserved');
app.state.playthroughs.push({startedAt:456,path:[1]});app.state.activePtIndex=1;
const module=await import('REPO/public/js/battlesim/battlesim758.js');module.render();
assert(!el('overlay').classList.contains('active'),'run switch closes stale panel');
el('apply').click();assert(!app.currentPlaythrough().sim758,'stale controls cannot mutate new run');
await open();assert(app.currentPlaythrough().sim758.history.length===0,'new run isolated');
assert(JSON.stringify(run)===original,'original run preserved');
document.body.dataset.test=JSON.stringify({mode,language,width:innerWidth,checks:checks.length,saves:saves.length,realModules:true,productionWrites:0});
