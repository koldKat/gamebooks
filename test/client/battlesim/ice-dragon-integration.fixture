localStorage.setItem('gamebook_lang','LANGUAGE');
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const seeds=ROSTER_SEEDS,check=(value,label)=>{if(!value)throw Error(label);};
let requests=0,writes=0;
window.fetch=async(url,options={})=>{
  if(options.method&&options.method!=='GET')writes++;
  const id=String(url).match(/\/api\/books\/(\d+)\/enemies$/)?.[1];if(id)requests++;
  return new Response(JSON.stringify(id?(seeds[id]||[]):{}),{headers:{'Content-Type':'application/json'}});
};
console.warn=(message,error)=>{if(error instanceof Error)throw error;};
app.setCurrentBookId(1541);app.state.playthroughs=[{startedAt:1,path:[1]}];app.state.activePtIndex=0;
if('MODE'==='mobile')await mobile.openSimForBook(1541);else await desktop.showBattleSimForBook(1541);
const module=await import('REPO/public/js/battlesim/battlesim1541.js');
const {getRoster}=await import('REPO/public/js/battlesim/books/1541/definition.js');
const {sagardTurn}=await import('REPO/public/js/battlesim/engines/sagard/core.js');
const el=key=>document.getElementById('sim1541-'+key),current=()=>app.currentPlaythrough().sim1541;
const set=(key,value)=>{const input=el(key);check(input,'missing '+key);if(input.type==='checkbox')input.checked=value;else input.value=value;};
const choose=(key,value)=>{set(key,value);el(key).dispatchEvent(new Event('change',{bubbles:true}));};
const alert=()=>document.getElementById('confirm-overlay')?.classList.contains('active');
const click=key=>{el(key).click();check(!alert(),'unexpected alert '+document.getElementById('confirm-message')?.textContent);};
const fields=key=>[...el('opponents').querySelectorAll('[data-stat="'+key+'"]')];
const next=(die=1)=>{const turn=sagardTurn(current().fight);if(turn.targets.length>1)set('target',turn.targets[0]);set('die',die);click('attack');};
function fresh(){app.state.playthroughs=[{startedAt:1,path:[1],inventory:['Story key'],trophies:['Keep'],experienceMarks:7,sim8:{keep:true}}];module.render();}
const protectedState=()=>JSON.stringify([app.currentPlaythrough().inventory,app.currentPlaythrough().trophies,app.currentPlaythrough().experienceMarks,app.currentPlaythrough().sim8,app.currentPlaythrough().path]);
if(!el('overlay').classList.contains('active'))el('btn').click();
check(el('overlay').classList.contains('active'),'real loader opens simulator');
const triggerStyle=getComputedStyle(el('btn'));
check(triggerStyle.backgroundColor==='rgba(31, 41, 55, 0.88)'&&triggerStyle.textTransform==='uppercase','shared launcher theme');
const {ALL_PANEL_OVERLAY_IDS,registerPanelShortcut}=await import('REPO/public/js/core/util.js');
for(const id of [1539,1540,1541])check(ALL_PANEL_OVERLAY_IDS.includes('sim'+id+'-overlay'),'registered overlay '+id);
const inventoryOverlay=document.getElementById('inv-overlay'),inventoryTrigger=document.createElement('button');document.body.append(inventoryTrigger);
for(const id of [1539,1540]){const overlay=document.createElement('div');overlay.id='sim'+id+'-overlay';overlay.classList.add('active');document.body.append(overlay);}
registerPanelShortcut('KeyI',{getButton:()=>inventoryTrigger,getOverlay:()=>inventoryOverlay,
  otherOverlayIds:ALL_PANEL_OVERLAY_IDS.filter(id=>id!=='inv-overlay'),open:()=>inventoryOverlay.classList.add('active'),close:()=>inventoryOverlay.classList.remove('active')});
document.body.dispatchEvent(new KeyboardEvent('keydown',{code:'KeyI',bubbles:true}));
check(inventoryOverlay.classList.contains('active')&&[1539,1540,1541].every(id=>!document.getElementById('sim'+id+'-overlay').classList.contains('active')),'inventory shortcut closes all recent simulators');
if('MODE'==='desktop'){
  document.body.dispatchEvent(new KeyboardEvent('keydown',{code:'KeyS',bubbles:true}));
  check(el('overlay').classList.contains('active')&&!inventoryOverlay.classList.contains('active'),'simulator shortcut closes inventory');
}else{
  inventoryOverlay.classList.remove('active');await mobile.openSimForBook(1541);
  check(el('overlay').classList.contains('active'),'mobile tap entry reopens simulator');
}
const cases=[];let restored=0,opponentRows=0,manualPresets=0;

fresh();choose('manualDice',true);fields('hp')[0].value='1';fields('hp')[0].dispatchEvent(new Event('change',{bubbles:true}));
const untouched=protectedState();click('start');
check(el('hp').disabled&&el('level').disabled&&el('encounter').disabled&&fields('hp')[0].disabled,'setup locked');
check(!el('setup').open,'setup collapsed');
const saved=JSON.stringify(current());module.render();check(JSON.stringify(current())===saved,'render preserves fight');
el('close').click();el('btn').click();check(current().fight.log.length===0,'reopen preserves fight');
next(4);check(current().fight.status==='win'&&current().history.length===1,'custom win');
module.render();check(current().history.length===1&&protectedState()===untouched,'once-only history and story preserved');
cases.push('custom opponent, setup lock, reopening, history and story isolation');

for(const entry of getRoster()){
  fresh();choose('encounter',entry.section);choose('manualDice',true);opponentRows+=entry.opponents.length;
  if(entry.mode==='manual'){
    check(el('start').disabled&&el('note').textContent.includes('no value has been guessed'),'manual source gap explained');
    check(fields('hp')[0].value===''&&fields('hp')[0].disabled,'Yeti HP is not invented');
    el('start').click();check(!current().fight&&current().history.length===0,'manual preset awards nothing');manualPresets++;continue;
  }
  if(entry.openings)choose('opening',entry.openings[0].id);
  choose('level',5);choose('weapon',true);choose('armor',true);click('start');
  check(current().fight.opponents.length===entry.opponents.length,'source opponents '+entry.section);
  check(current().fight.allies.length===entry.allies.length,'source companions '+entry.section);
  check(el('opponents').querySelector('details>button').hidden,'preset count fixed');
  for(let i=0;current().fight.status==='fighting';i++){
    check(i<1000,'stalled '+entry.section);const turn=sagardTurn(current().fight);
    if(turn.kind==='breakOff')click('continue');else next(turn.attackerId?.startsWith('enemy')?1:4);
    app.currentPlaythrough().sim1541=JSON.parse(JSON.stringify(current()));const before=JSON.stringify(current());module.render();
    check(JSON.stringify(current())===before,'saved action changed');restored++;
  }
  check(current().fight.status==='win'&&current().history.length===1,'source outcome '+entry.section);
}
check(opponentRows===62&&manualPresets===1,'all source rows covered');
cases.push('twenty-five automatic encounters and one manual source gap, every action save/reloaded');

fresh();choose('encounter','28');choose('manualDice',true);el('start').click();
check(alert()&&!current().fight,'missing printed approach rejected');document.getElementById('confirm-ok').click();
choose('opening','29');click('start');
for(let i=0;i<5;i++){check(sagardTurn(current().fight).attackerId==='hero','four free plus normal attack');next(1);}
check(sagardTurn(current().fight).attackerId==='enemy0','reply follows surprise block');
fresh();choose('encounter','28');choose('opening','26-27');choose('manualDice',true);click('start');
check(sagardTurn(current().fight).attackerId==='enemy0','first free trader');next();
check(sagardTurn(current().fight).attackerId==='enemy1','second free trader');next();
check(sagardTurn(current().fight).attackerId==='hero','hero after free trader attacks');
cases.push('both printed trader approaches and missing-choice protection');

fresh();choose('encounter','13');choose('manualDice',true);click('start');next();next();next();
check(sagardTurn(current().fight).kind==='breakOff'&&!el('break-actions').hidden,'break-off after first reply');
const exchange=JSON.stringify(current());module.render();check(JSON.stringify(current())===exchange,'break-off prompt survives render');
click('withdraw');check(current().fight.status==='withdrawn'&&current().fight.destination==='16'&&current().history.length===0,'withdrawal has no reward');
cases.push('initial double strike, reply and persisted no-roll withdrawal');

fresh();choose('manualDice',true);click('start');set('die',1);click('flee');
check(sagardTurn(current().fight).attackerId==='hero'&&el('flee').disabled,'failed escape leaves ordinary attack');
next();next();check(!el('flee').disabled,'next-round escape available');set('die',2);click('flee');
check(current().fight.status==='fled'&&current().history.length===0,'escape has no win/loss');
fresh();choose('encounter','96');choose('manualDice',true);click('start');set('die',2);click('flee');
check(current().fight.status==='fighting'&&sagardTurn(current().fight).attackerId==='hero','four-only escape rejects even two');
next();next();set('die',4);click('flee');check(current().fight.status==='fled'&&current().fight.destination==='97','four-only source escape');
cases.push('ordinary and quarter-chance escape, failed-turn semantics and no escape XP');

fresh();choose('hp',10);choose('fang',true);choose('moss',true);choose('manualDice',true);click('start');
const beforeHealing=protectedState(),cursor=current().fight.cursor;click('heal-fang');
check(current().fight.hero.hp===20&&!current().fight.healing.fang&&current().fight.healing.moss,'instant healing consumes only selected item');
check(current().fight.cursor===cursor&&protectedState()===beforeHealing,'healing leaves turn and campaign intact');
cases.push('instant healing, separate item availability and turn preservation');

fresh();choose('armor',true);choose('shield',2);choose('opponentFirst',true);choose('manualDice',true);
fields('level')[0].value='5';fields('level')[0].dispatchEvent(new Event('change',{bubbles:true}));click('start');next(4);
check(current().fight.hero.hp===19&&current().fight.hero.shield===0,'armor then finite shield');
fresh();choose('encounter','63');check(!el('weapon').checked,'sage takes hero sword');click('start');
check(current().fight.opponents[0].damageBonus===1&&current().fight.hero.damageBonus===0,'sage sword source bonus retained');
cases.push('finite shield, armor and enemy weapon bonus');

fresh();choose('encounter','105');fields('hp')[0].value='2';fields('hp')[0].dispatchEvent(new Event('change',{bubbles:true}));
let randomCalls=0;const originalRandom=Math.random;Math.random=()=>{randomCalls++;return 0;};
click('start');click('attack');check(sagardTurn(current().fight).kind==='melt','melting before enemy attack');click('attack');
Math.random=originalRandom;check(current().fight.status==='win'&&randomCalls===1,'melting death consumes no attack die');
cases.push('melting precedes enemy dice and needs no roll if lethal');

fresh();choose('encounter','55');choose('manualDice',true);click('start');const beforeTarget=JSON.stringify(current());
el('attack').click();check(alert(),'multi-target attack needs choice');document.getElementById('confirm-ok').click();
check(JSON.stringify(current())===beforeTarget,'invalid target action read-only');
fresh();choose('hp',1);choose('opponentFirst',true);choose('manualDice',true);click('start');next(4);
check(current().fight.status==='loss'&&current().history.length===1,'loss recorded once');
fresh();click('start');el('cancel').click();check(alert(),'cancellation confirmed');document.getElementById('confirm-ok').click();
check(current().fight.status==='cancelled'&&current().history.length===0,'cancel has no reward');
fresh();click('start');el('cancel').click();app.state.playthroughs=[{startedAt:2,path:[1]}];module.render();document.getElementById('confirm-ok').click();
check(!current(),'stale cancellation cannot modify another run');
cases.push('target validation, loss history, cancellation and stale run isolation');

check(!el('overlay').querySelector('.bsim-col-right input,.bsim-col-right select,.bsim-col-right button'),'results only on right');
el('btn').click();const bounds=el('overlay').querySelector('.inv-modal').getBoundingClientRect();
check(bounds.left>=-1&&bounds.right<=innerWidth+1,'modal fits');
check(document.documentElement.scrollWidth<=innerWidth+1,'no document overflow');
check(requests===1,'catalog fetched once through real loader');
document.body.dataset.test=JSON.stringify({mode:'MODE',language:'LANGUAGE',width:innerWidth,cases,encounters:getRoster().length,automatedEncounters:25,opponentRows,manualPresets,restored,requests,writes,productionWrites:0});
