localStorage.setItem('gamebook_lang','en');
const app=await import('REPO/public/js/core/state.js');
const {t}=await import('REPO/public/js/i18n.js');
const {loadBattleSimTranslations}=await import('REPO/public/js/i18n/battlesim.js');
const {prepareBattleSimLayout}=await import('REPO/public/js/battlesim/layout.js');
const {definition:base}=await import('REPO/public/js/battlesim/books/1286/definition.js');
const {createDestinyState}=await import('REPO/public/js/battlesim/engines/destinyquest/state.js');
const {createDestinyPanel}=await import('REPO/public/js/battlesim/engines/destinyquest/panel.js');
const {createDestinySession,applyDestinySessionAction}=await import('REPO/public/js/battlesim/engines/destinyquest/session.js');
const {createHeartFight}=await import('REPO/public/js/battlesim/engines/destinyquest/heart.js');
const {HEART_ABILITIES}=await import('REPO/public/js/battlesim/engines/destinyquest/heart-abilities.js');
const {decodeDestinyRoster}=await import('REPO/public/js/battlesim/engines/destinyquest/winters-fury-roster.js');
const {captureDestinyAbsorbedAbility}=await import('REPO/public/js/battlesim/engines/destinyquest/enemy-absorption.js');
const roster=decodeDestinyRoster(HEART_ENEMIES);
await loadBattleSimTranslations(1286);app.setCurrentBookId(1287);
const run={startedAt:1,path:[1],notebook:'preserve',inventory:[{itemId:8,qty:2,label:'Rope',note:'keep'}],equipment:{head:{itemId:9,qty:1,label:'Hat'}},sim1286:{keep:true}};
app.state.playthroughs=[run];app.state.activePtIndex=0;
let writes=0,lastAlert='',scenarios=0;
const definition={...base,id:1287,stateKey:'sim1287',abilityCatalog:HEART_ABILITIES};
const state=createDestinyState(definition,()=>({getRun:app.currentPlaythrough,getBookId:()=>1287,saveState:()=>writes++}));
const panel=createDestinyPanel({document,definition,state,getRoster:()=>roster,t,createFight:createHeartFight,
  showAlert:message=>{lastAlert=message;},showConfirm:(_text,fn)=>fn(),getButtonRow:()=>document.getElementById('m-sim-btn-row')||document.getElementById('main-screen')});
const el=key=>document.getElementById('sim1287-'+key),data=()=>run.sim1287;
const check=(value,message)=>{if(!value)throw Error(message);scenarios++;};
const click=key=>{if(!el(key))throw Error('Missing control '+key);el(key).click();if(lastAlert)throw Error(lastAlert);};
const ability=name=>{check([...el('useAbility').options].some(o=>o.value===name),'response available: '+name);el('useAbility').value=name;el('useAbility').dispatchEvent(new Event('change',{bubbles:true}));};
const action=(s,name,payload={},values=[])=>applyDestinySessionAction(s,name,payload,{roster,roll:()=>{if(!values.length)throw Error('Unexpected die');return values.shift();}});
let fight=createHeartFight({speed:20,brawn:0,magic:0,armour:20,health:30,maxHealth:60},774,{roster,abilities:{heal:1,'thorn-armour':1,charm:1}});
fight.round=1;captureDestinyAbsorbedAbility(fight,'cleave',HEART_ABILITIES.cleave);
let s=createDestinySession({fight,fightId:'panel-daala',setup:{section:'774',hero:fight.hero}});
s=action(s,'start-round',{target:0});s=action(s,'roll-speed',{},[1,2,6,6]);s=action(s,'resolve-speed',{},[3]);run.sim1287=s;
panel.init();panel.setVisible(true);click('btn');prepareBattleSimLayout(el('overlay'));
check(el('next')?.textContent===t('battlesim1286.resolve-ability'),'foreign roll has its resolve control');
check(el('result').textContent.includes('Cleave: 3'),'foreign dice shown separately');
check(![...el('useAbility').options].some(o=>o.value==='charm'),'hero-only dice modifier is hidden for foreign dice');
check(el('rules').textContent.includes('First-round-only'),'source clarifications are visible');
ability('heal');click('ability');check(data().fight.hero.health===34,'heal response is saved');
ability('thorn-armour');el('manualDice').value='4';click('ability');
check(data().fight.phase==='ability-rolled','player counter has its own pending roll');
ability('charm');el('manualDice').value='6';click('ability');click('next');
check(data().fight.phase==='enemy-ability'&&data().fight.opponents[0].health===94,'nested player roll resumes enemy roll');
run.sim1287=JSON.parse(JSON.stringify(data()));panel.render();click('next');
check(data().fight.hero.health===31&&data().fight.used.heal===1,'saved enemy resolution preserves response');
check(run.inventory[0].qty===2&&run.equipment.head.itemId===9,'normal responses do not touch shared items');

fight=createHeartFight({speed:0,brawn:0,magic:0,armour:100,health:20,maxHealth:20},66,{roster});
s=createDestinySession({fight,fightId:'panel-zombie',setup:{section:'66',hero:fight.hero}});
for(const [name,values]of [['start-round',[]],['roll-speed',[1,2,6,5]],['resolve-speed',[]],['roll-damage',[6]],['resolve-damage',[]]])s=action(s,name,{target:0},values);
run.sim1287=s;panel.render();
check(el('sharedItem')?.options.length===2,'shared inventory and equipment are selectable');
check(el('sharedItem').options[0].textContent.includes('Rope'),'shared label is shown');
let before=writes;click('shared-item-loss');
check(writes===before+1&&run.inventory[0].qty===1,'item and fight are saved atomically once');
check(data().fight.phase==='end'&&run.equipment.head.itemId===9,'only selected shared unit is removed');
check(!el('shared-item-loss'),'resolved destruction cannot be repeated');
check(run.notebook==='preserve'&&run.sim1286.keep,'unrelated state is preserved');

fight=createHeartFight({speed:30,brawn:4,magic:0,armour:20,health:30,maxHealth:60},774,{roster,abilities:{hexed:1,faith:1,'blood-sworn-set':1,cunning:1}});
run.sim1287=createDestinySession({fight,fightId:'panel-quota',setup:{section:'774',hero:fight.hero}});panel.render();
el('quotaPassive').value='faith';click('enable-passive');
check(data().fight.abilityQuota.activePassives.includes('faith'),'passive activation is saved');
check(el('quotaPassive').selectedOptions[0].textContent.includes('Active'),'active passive status is shown');
click('disable-passive');check(!data().fight.abilityQuota.activePassives.includes('faith')&&data().fight.abilityQuota.used.includes('faith'),'deactivation preserves the spent quota slot');
click('next');ability('blood-sworn-set');el('quotaAbility').value='cunning';click('ability');
check(data().fight.hero.health===26&&data().fight.abilityQuota.paidExempt.includes('cunning'),'funding choice spends Health and funds the selected ability');

fight=createHeartFight({speed:30,brawn:4,magic:0,armour:20,health:30,maxHealth:60},774,{roster,abilities:{'gorilla-rage':1,'deep-wound':1}});
s=createDestinySession({fight,fightId:'panel-automatic',setup:{section:'774',hero:fight.hero}});
s=action(s,'start-round',{target:0});s=action(s,'roll-speed',{},[6,5,1,2]);s=action(s,'resolve-speed');
s=action(s,'ability',{name:'deep-wound'},[6]);run.sim1287=s;panel.render();click('next');
check(el('automaticAttribute')?.options.length===3,'automatic modifier offers the printed attributes and skip');
el('automaticAttribute').value='brawn';click('automatic-choice');
check(data().fight.effects.some(e=>e.source==='gorilla-rage'&&e.attribute==='brawn'&&e.amount===1),'automatic choice applies the selected bonus');

fight=createHeartFight({speed:30,brawn:4,magic:0,armour:20,health:30,maxHealth:60},774,{roster,abilities:{'stone-rain':1}});
s=createDestinySession({fight,fightId:'panel-repeat',setup:{section:'774',hero:fight.hero}});
s=action(s,'start-round',{target:0});s=action(s,'roll-speed',{},[6,5,1,2]);s=action(s,'resolve-speed');
s=action(s,'ability',{name:'stone-rain',options:{deferDamage:true}},[2]);run.sim1287=s;panel.render();click('next');click('next');click('next');
el('manualDice').value='6 5 1 2';click('next');click('next');
check(el('continue-ability')?.textContent.includes('Stone Rain'),'consecutive attack control appears on the next win');
el('manualDice').value='2 3';click('continue-ability');
check(data().fight.turn.pendingAbility.groups[0].dice.join(',')==='2,3','continued attack pauses with its two dice');
click('next');check(data().fight.opponents[0].health===93,'continued damage resolves without another use charge');

fight=createHeartFight({speed:30,brawn:4,magic:0,armour:20,health:30,maxHealth:60},774,{roster,abilities:{'bright-spark':1}});
s=createDestinySession({fight,fightId:'panel-score-reroll',setup:{section:'774',hero:fight.hero}});
run.sim1287=action(s,'start-round',{target:0});panel.render();ability('bright-spark');click('ability');
el('manualDice').value='6 5 1 2';click('next');click('next');el('manualDice').value='1';click('next');
check(el('scoreRerollDice')?.querySelectorAll('input').length===1,'score reroll exposes an unlocked die');
el('scoreRerollDice').querySelector('input').checked=true;el('manualDice').value='6';click('score-reroll');
check(data().fight.turn.damageDice[0]===6&&!el('score-reroll'),'accepted score dice cannot be rerolled again');

fight=createHeartFight({speed:30,brawn:4,magic:0,armour:20,health:30,maxHealth:60},774,{roster,abilities:{'stone-skin':1}});
s=createDestinySession({fight,fightId:'panel-stance',setup:{section:'774',hero:fight.hero}});
s=action(s,'start-round',{target:0});s=action(s,'roll-speed',{},[6,5,1,2]);s=action(s,'resolve-speed');s=action(s,'ability',{name:'stone-skin'});
s=action(s,'end-round');s=action(s,'start-round',{target:0});s=action(s,'roll-speed',{},[6,5,1,2]);s=action(s,'resolve-speed');run.sim1287=s;panel.render();
check(el('remove-stance')?.textContent.includes('Stone Skin'),'stance exit is offered after a winning round');
click('remove-stance');check(!data().fight.combatStance&&data().fight.phase==='end'&&data().fight.opponents[0].health===100,'ending stance forgoes the normal attack');
check(el('controls').closest('.bsim-col-left')&&el('result').closest('.bsim-col-right'),'controls and results retain standard columns');
check(document.documentElement.scrollWidth<=innerWidth,'no viewport overflow');
document.body.dataset.test=JSON.stringify({width:innerWidth,scenarios,writes,panelOnly:true,playerDatabaseWrites:0});
