const checks = [], saves = [];
const assert = (value,label) => {if (!value) throw Error(label);checks.push(label);};
window.fetch = async (url,options = {}) => {
  assert(url === '/api/books/857/state' && options.method === 'PUT','only intercepted state saves');
  saves.push(JSON.parse(options.body));return new Response('{}',{headers:{'Content-Type':'application/json'}});
};
const app = await import('REPO/public/js/core/state.js');
const desktop = await import('REPO/public/js/battlesim/loader.js');
const mobile = await import('REPO/public/mobile/js/battlesim-dispatch.js');
await import('REPO/public/js/ui-helpers/dialog-escape.js');
const el = key => document.getElementById('sim857-' + key);
const run = {startedAt:123,path:[1],sim856:{preserved:true}};
app.setCurrentBookId(857);app.state.playthroughs = [run];app.state.activePtIndex = 0;
assert(!el('overlay') && mobile.hasSim(857),'registered and lazy');
const sim = await import('REPO/public/js/battlesim/battlesim857.js');
if ('MODE' === 'mobile') await mobile.openSimForBook(857);
else {await desktop.showBattleSimForBook(857);el('btn').click();}
assert(el('overlay').classList.contains('active'),'real loader opens');
assert(el('title').textContent === 'Изумрудената планина','Bulgarian source has Bulgarian labels without injection');
assert(!el('overlay').textContent.includes('battlesim857.'),'translated initial labels');
const choose = value => {el('encounter').value = value;el('encounter').dispatchEvent(new Event('change'));};
choose('16');
assert(Number(run.sim857.opponents[0].hp) === 12 && Number(run.sim857.opponents[0].damage) === 0,'monster equipment bonus is editable zero');
let name = el('editor').querySelector('[role="combobox"]');
name.value = 'Разбойник';name.dispatchEvent(new Event('input',{bubbles:true}));
assert(run.sim857.encounter === '','typing detaches old encounter route');
name.dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowDown',bubbles:true,cancelable:true}));
name.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',bubbles:true,cancelable:true}));
assert(run.sim857.encounter === '8' && Number(run.sim857.opponents[0].hp) === 8,'autocomplete applies selected encounter');
name.focus();name.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true,cancelable:true}));
assert(el('overlay').classList.contains('active') && name.getAttribute('aria-expanded') === 'false','Escape dismisses suggestions only');
el('manual').click();el('die-one').value = 1;el('die-two').value = 1;el('start').click();
assert(!el('initiative').hidden && el('attack').disabled,'initiative tie waits for player choice');
assert(el('encounter').disabled && el('life').disabled,'fight locks setup');
el('playerFirst').click();
el('die-one').value = 2;el('die-two').value = 3;el('attack').click();
assert(run.sim857.fight.pendingTie && !el('tie').hidden && el('attack').disabled,'attack tie waits for explicit outcome');
el('resolveTie').click();
assert(!run.sim857.fight.pendingTie && run.sim857.fight.actor === 'enemy' && run.sim857.character.life === 10,'explicit harmless tie advances once');
el('die-one').value = 6;el('die-two').value = 1;el('attack').click();
assert(run.sim857.fight.outcome === 'win' && run.sim857.fight.destination === '23','counterattack victory keeps source route');
assert(run.sim857.history.length === 1,'one outcome recorded');
const before = JSON.stringify(run);sim.render();sim.render();
assert(JSON.stringify(run) === before,'render preserves state');
assert(!el('overlay').textContent.includes('battlesim857.'),'translated dynamic results');
assert(run.sim856.preserved,'unrelated simulator preserved');
assert(!el('overlay').querySelector('.bsim-col-right input,.bsim-col-right select'),'all setup stays left');
assert(el('overlay').querySelector('.bsim-modal').getBoundingClientRect().width <= innerWidth,'dialog fits');
assert(document.documentElement.scrollWidth <= innerWidth,'no horizontal overflow');
el('die-one').value = 6;el('die-two').value = 1;el('start').click();el('abandon').click();
assert(document.getElementById('confirm-overlay').classList.contains('active'),'ending fight confirms');
const saved = JSON.stringify(run);app.state.playthroughs = [{startedAt:456,path:[1]}];
document.getElementById('confirm-ok').click();sim.render();
assert(!el('overlay').classList.contains('active'),'run change closes stale panel');
assert(JSON.stringify(run) === saved && !app.currentPlaythrough().sim857,'stale confirmation preserves both runs');
await app.saveState();await new Promise(resolve => setTimeout(resolve,0));
document.body.dataset.test = JSON.stringify({mode:'MODE',language:'LANGUAGE',width:innerWidth,checks:checks.length,saves:saves.length,productionWrites:0});
