const checks=[],saves=[];
const assert=(value,label)=>{if(!value)throw Error(label);checks.push(label);};
window.fetch=async(url,options={})=>{
  if(url==='/api/books/679/enemies'&&!options.method)return new Response(JSON.stringify(ROSTER_SEED),{status:200,headers:{'Content-Type':'application/json'}});
  assert(url==='/api/books/679/state'&&options.method==='PUT','only simulator saves');
  saves.push(JSON.parse(options.body));
  return new Response('{}',{status:200,headers:{'Content-Type':'application/json'}});
};
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
import {RISING_FIGHTS} from 'REPO/public/js/battlesim/engines/fabled-lands/rising-sun.js';
app.setCurrentBookId(679);
const run={startedAt:123,path:[1],sim678:{preserved:true}};
app.state.playthroughs=[run];app.state.activePtIndex=0;
const mode='MODE',el=key=>document.getElementById('sim679-'+key);
const open=async()=>{if(mode==='mobile')await mobile.openSimForBook(679);else{await desktop.showBattleSimForBook(679);el('btn').click();}};
await open();
assert(el('overlay').classList.contains('active'),'real loader opens');
assert(!el('overlay').textContent.includes('battlesim679.'),'translated labels');
assert(el('context').options.length===30&&el('context').options[0].value==='-1'&&el('seaContext').options.length===4,'complete source encounters and ship checks');
assert(getComputedStyle(el('btn')).borderRadius==='7px','themed button');
assert(run.sim679.character===null&&saves.length===0,'open creates no character');
el('profession').value='warrior';el('create').click();
assert(run.sim679.character.rank===6&&run.sim679.character.stamina===27&&run.sim679.character.armour===0,'book-six defaults');
el('context').value=String(RISING_FIGHTS.findIndex(f=>f.section===192));
el('context').dispatchEvent(new Event('change',{bubbles:true}));el('start').click();
assert(!el('target-row').hidden&&el('target').options.length===3,'simultaneous target selector');
el('target').value='2';let dice=[0,0,0,0,0,0,0,0];Math.random=()=>dice.shift();el('step').click();
assert(run.sim679.fight.target===2&&run.sim679.fight.events.filter(e=>e.direction==='enemy').length===3,'three distinct counterattacks');
assert(run.sim679.log.some(line=>line.includes('Third Spider')),'named counterattack log');
run.sim679.fight.enemies.forEach(e=>e.stamina=1);
for(const target of [2,0,1]){
  el('target').value=String(target);Math.random=()=>.999;el('step').click();
}
assert(run.sim679.fight.status==='win'&&run.sim679.history.length===1&&run.sim678.preserved,'all enemies defeated once and old sim preserved');
el('context').value=String(RISING_FIGHTS.findIndex(f=>f.section===656));
el('context').dispatchEvent(new Event('change',{bubbles:true}));el('exchangedWeaponBonus').value='3';el('start').click();
assert(run.sim679.fight.enemies[0].combat===11&&run.sim679.fight.enemies[0].defence===19,'encounter options wired');
await app.saveState();assert(saves.at(-1).playthroughs[0].sim679.fight.enemies[0].combat===11,'state persistence');
el('surrender').click();assert(run.sim679.fight.status==='surrender'&&run.sim679.fight.destination===36,'source surrender destination');
el('combat').closest('details').open=true;
for(const[field,value]of Object.entries({combat:100,magic:100,sanctity:100,stamina:1000,staminaInitial:1000}))el(field).value=String(value);
el('apply').click();Math.random=()=>.999;
const initialHistory=run.sim679.history.length;
for(let index=0;index<RISING_FIGHTS.length;index++){
  el('context').value=String(index);el('context').dispatchEvent(new Event('change',{bubbles:true}));el('start').click();
  assert(el('apply').disabled&&el('context').disabled,'active encounter locks setup '+index);
  let rounds=0;
  while(run.sim679.fight.status==='fighting'&&rounds++<10){
    if(run.sim679.fight.config.simultaneous)el('target').value=String(run.sim679.fight.enemies.findIndex(e=>e.stamina>0));
    el('step').click();
  }
  assert(run.sim679.fight.status==='win'&&run.sim679.fight.destination===RISING_FIGHTS[index].win,'complete named encounter '+index);
  assert(run.sim679.history.length===initialHistory+index+1,'one result per encounter '+index);
}
await app.saveState();assert(saves.at(-1).playthroughs[0].sim679.history.length===initialHistory+29,'all encounter results persist');
for(const node of el('overlay').querySelectorAll('details'))node.open=true;
const body=el('overlay').querySelector('.bsim-body');body.scrollTop=Number.MAX_SAFE_INTEGER;
assert(Math.abs(body.scrollTop-Math.max(0,body.scrollHeight-body.clientHeight))<=1,'scroll reaches bottom');
assert(document.documentElement.scrollWidth<=innerWidth+1&&body.scrollWidth<=body.clientWidth+1,'no overflow');
el('close').dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
assert(!el('overlay').classList.contains('active'),'Escape closes');
const preserved=JSON.stringify(run);
app.state.playthroughs.push({startedAt:456,path:[1]});app.state.activePtIndex=1;await open();
assert(app.currentPlaythrough().sim679.character===null&&JSON.stringify(run)===preserved,'run isolation');
document.body.setAttribute('data-test',JSON.stringify({mode,width:innerWidth,checks:checks.length,saves:saves.length,encounters:29,realModules:true,productionWrites:0}));
