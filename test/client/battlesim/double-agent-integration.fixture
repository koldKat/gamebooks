const checks = [], saves = [];
const assert = (value, label) => {if (!value) throw Error(label); checks.push(label);};
window.fetch = async (url, options = {}) => {
  assert(url === '/api/books/873/state' && options.method === 'PUT', 'only intercepted simulator saves');
  saves.push(JSON.parse(options.body)); return new Response('{}', {headers: {'Content-Type': 'application/json'}});
};
const app = await import('REPO/public/js/core/state.js');
const desktop = await import('REPO/public/js/battlesim/loader.js');
const mobile = await import('REPO/public/mobile/js/battlesim-dispatch.js');
await import('REPO/public/js/ui-helpers/dialog-escape.js');
const el = key => document.getElementById('sim873-' + key);
const run = {startedAt: 123, path: [1], sim860: {preserved: true}};
app.setCurrentBookId(873); app.state.playthroughs = [run]; app.state.activePtIndex = 0;
assert(!el('overlay') && mobile.hasSim(873), 'registered and lazy');
const sim = await import('REPO/public/js/battlesim/battlesim873.js');
if ('MODE' === 'mobile') await mobile.openSimForBook(873);
else {await desktop.showBattleSimForBook(873); el('btn').click();}
assert(el('title').textContent === 'Двоен агент', 'Bulgarian book title');
assert(!el('overlay').textContent.includes('battlesim873.'), 'all labels translated');
const choose = query => {
  const name = el('editor').querySelector('[role="combobox"]');
  name.value = query; name.dispatchEvent(new Event('input', {bubbles: true}));
  name.dispatchEvent(new KeyboardEvent('keydown', {key: 'ArrowDown', bubbles: true, cancelable: true}));
  name.dispatchEvent(new KeyboardEvent('keydown', {key: 'Enter', bubbles: true, cancelable: true}));
  return name;
};
Math.random = () => 0.99;
let name = choose('Младият войник');
name.focus(); name.dispatchEvent(new KeyboardEvent('keydown', {key: 'Escape', bubbles: true, cancelable: true}));
assert(el('overlay').classList.contains('active') && name.getAttribute('aria-expanded') === 'false', 'Escape closes autocomplete first');
el('start').click();
assert(run.sim873.fight.encounter.id === '63' && name.disabled, 'selected encounter starts and locks setup');
el('attack').click();
assert(run.sim873.fight.outcome === 'win' && run.sim873.result.destination === '32', 'one hit wins the soldier encounter');
assert(run.sim873.history.at(-1).ts > 0, 'fight history has an XP-deduplication timestamp');
const afterWin = JSON.stringify(run); el('attack').click();
assert(JSON.stringify(run) === afterWin, 'finished fight cannot resolve twice');
choose('Шпионинът стреля пръв'); el('start').click();
assert(run.sim873.result.outcome === 'hurt' && run.sim873.result.destination === '38', 'single exchange uses printed hurt precedence');
assert(run.sim873.character.health === 1 && run.sim873.history.at(-1).outcome !== 'win', 'single exchange wounds without a fake win');
choose('Двата преследващи'); el('aircraftHits').value = 3; el('saveCharacter').click();
el('start').click();
assert(el('weapon').disabled && el('weapon').value === '0', 'personal weapons disabled for aircraft');
el('attack').click();
assert(run.sim873.character.aircraftHits === 4 && run.sim873.character.health === 1, 'carried aircraft damage is separate from personal health');
assert(run.sim873.result.destination === '12', 'aircraft defeat follows crash story');
assert(run.sim860.preserved, 'other simulator preserved');
assert(!el('overlay').querySelector('.bsim-col-right input,.bsim-col-right select'), 'setup remains on the left');
assert(el('destination').closest('.bsim-col-right'), 'results remain on the right');
assert(document.documentElement.scrollWidth <= innerWidth, 'no horizontal overflow');
assert(el('overlay').querySelector('.bsim-modal').getBoundingClientRect().width <= innerWidth, 'dialog fits viewport');
assert(getComputedStyle(el('start')).backgroundColor !== 'rgb(239, 239, 239)', 'themed buttons');
assert(getComputedStyle(el('tracer')).appearance === 'none', 'themed checkbox');
const beforeRender = JSON.stringify(run); sim.render(); sim.render();
assert(JSON.stringify(run) === beforeRender, 'render is read-only');
el('newCharacter').click();
assert(document.getElementById('confirm-overlay').classList.contains('active'), 'character replacement confirms');
const saved = JSON.stringify(run); app.state.playthroughs = [{startedAt: 456, path: [1]}];
document.getElementById('confirm-ok').click(); sim.render();
assert(!el('overlay').classList.contains('active'), 'stale run closes panel');
assert(JSON.stringify(run) === saved && !app.currentPlaythrough().sim873, 'stale confirmation preserves both runs');
await app.saveState(); await new Promise(resolve => setTimeout(resolve, 0));
document.body.dataset.test = JSON.stringify({mode: 'MODE', language: 'LANGUAGE', width: innerWidth, checks: checks.length, saves: saves.length, productionWrites: 0});
