const checks = [], saves = [];
const assert = (value, label) => { if (!value) throw Error(label); checks.push(label); };
const rosterSeed = ROSTER_SEED;
window.fetch = async (url, options = {}) => {
  if (url === '/api/books/674/enemies' && (!options.method || options.method === 'GET')) return new Response(JSON.stringify(rosterSeed), {status:200,headers:{'Content-Type':'application/json'}});
  assert(url === '/api/books/674/state' && options.method === 'PUT', 'only intercepted simulator state saves');
  saves.push(JSON.parse(options.body));
  return new Response('{}', { status: 200, headers: { 'Content-Type': 'application/json' } });
};
const app = await import('REPO/public/js/core/state.js');
const desktop = await import('REPO/public/js/battlesim/loader.js');
const mobile = await import('REPO/public/mobile/js/battlesim-dispatch.js');
const { t } = await import('REPO/public/js/i18n.js');
import { WAR_TORN_FIGHTS } from 'REPO/public/js/battlesim/engines/fabled-lands/roster.js';
assert(!document.getElementById('sim674-overlay'), 'loader remains lazy');
assert(t('battlesim674.title') === 'battlesim674.title', 'translations remain lazy');
app.setCurrentBookId(674);
const run = { startedAt: 123, path: [1], sim672: { preserved: 'other book' } };
app.state.playthroughs = [run]; app.state.activePtIndex = 0;
const mode = 'MODE';
const open = async () => {
  if (mode === 'mobile') await mobile.openSimForBook(674);
  else { await desktop.showBattleSimForBook(674); document.getElementById('sim674-btn').click(); }
};
const el = key => document.getElementById('sim674-' + key);
const click = key => el(key).click();
const key = (target, code, name = code.slice(3)) => target.dispatchEvent(new KeyboardEvent('keydown', { code, key: name, bubbles: true }));
const select = index => { el('context').value = String(index); el('context').dispatchEvent(new Event('change', { bubbles: true })); };
await open();
assert(el('overlay').classList.contains('active'), 'real loader opens panel');
assert(el('btn').parentElement.parentElement.id === (mode === 'mobile' ? 'm-sim-btn-row' : 'main-screen'), 'correct button surface');
assert(!el('overlay').textContent.includes('battlesim674.'), 'all visible labels translated');
assert(run.sim674.character === null && saves.length === 0, 'opening does not create character or save');
assert(document.activeElement === el('close'), 'close receives focus');
key(el('close'), 'Escape', 'Escape'); assert(!el('overlay').classList.contains('active'), 'Escape closes');
await open(); assert(document.querySelectorAll('#sim674-overlay').length === 1, 'panel initialized once');
if (mode === 'desktop') {
  key(document.body, 'KeyS', 's'); assert(!el('overlay').classList.contains('active'), 'shortcut closes');
  document.getElementById('inv-overlay').classList.add('active'); key(document.body, 'KeyS', 's');
  assert(el('overlay').classList.contains('active') && !document.getElementById('inv-overlay').classList.contains('active'), 'shortcut coordinates overlays');
  key(el('combat'), 'KeyS', 's'); assert(el('overlay').classList.contains('active'), 'typing does not invoke shortcut');
}
Math.random = () => .999;
el('profession').value = 'warrior'; click('create');
assert(run.sim674.character.combat === 6 && run.sim674.character.stamina === 9 && run.sim674.character.rank === 1, 'book-one initial stats');
assert(run.sim674.character.shards === 16 && run.sim674.character.armour === 1, 'book-one supplies');
el('combat').closest('details').open = true;
for (const [field, value] of Object.entries({ combat: 100, stamina: 1000, staminaInitial: 1000 })) el(field).value = String(value);
click('apply');
for (let index = 0; index < WAR_TORN_FIGHTS.length; index++) {
  select(index); click('start');
  assert(el('apply').disabled && el('create').disabled && el('context').disabled, 'active fight locks character and setup');
  let attempts = 0;
  while (run.sim674.fight.status === 'fighting' && attempts++ < 10) click('step');
  assert(run.sim674.fight.status === 'win' && run.sim674.fight.destination === WAR_TORN_FIGHTS[index].win, 'complete named encounter ' + index);
  assert(run.sim674.history.length === index + 1, 'exactly one history entry ' + index);
  if (index === 0) {
    const logLength = run.sim674.log.length; click('step');
    assert(run.sim674.log.length === logLength && run.sim674.history.length === 1, 'finished fight cannot grant another result');
  }
}
await app.saveState();
assert(saves.at(-1).playthroughs[0].sim674.history.length === 39, 'all results persist via actual state module');
assert(el('history').children.length === 30 && run.sim674.history.length === 39, 'display limit preserves complete XP history');
assert(JSON.stringify(run.sim672) === '{"preserved":"other book"}', 'other simulator untouched');
select(WAR_TORN_FIGHTS.findIndex(f => f.section === 96)); click('start'); click('surrender');
assert(run.sim674.fight.status === 'surrender' && run.sim674.fight.destination === 218, 'source surrender destination');
assert(run.sim674.history.length === 39, 'surrender has no battle reward');
select(WAR_TORN_FIGHTS.findIndex(f => f.section === 121));
assert(el('contextNote').textContent.includes('already includes'), 'underwater penalty not charged twice');
select(WAR_TORN_FIGHTS.findIndex(f => f.section === 238));
assert(el('contextNote').textContent.includes('-2'), 'distinct printed underwater modifier');
el('seaContext').value = '51'; click('seaRoll');
assert(run.sim674.log.at(-1).includes('62') && run.sim674.history.length === 40, 'compact naval battle resolves source outcome');
assert(getComputedStyle(el('btn')).borderRadius === '7px', 'simulator button is themed');
for (const node of el('overlay').querySelectorAll('details')) node.open = true;
const body = el('overlay').querySelector('.bsim-body');
body.scrollTop = Number.MAX_SAFE_INTEGER;
assert(Math.abs(body.scrollTop - Math.max(0, body.scrollHeight - body.clientHeight)) <= 1, 'scroll reaches bottom');
body.scrollTop = 0; assert(body.scrollTop === 0, 'scroll reaches top');
assert(document.documentElement.scrollWidth <= innerWidth + 1, 'no page overflow');
assert(body.scrollWidth <= body.clientWidth + 1, 'no modal overflow');
const preserved = JSON.stringify(run);
app.state.playthroughs.push({ startedAt: 456, path: [1] }); app.state.activePtIndex = 1;
if (mode === 'desktop') desktop.renderActiveBattleSim(); else { click('close'); await open(); }
assert(app.currentPlaythrough().sim674.character === null && JSON.stringify(run) === preserved, 'run isolation');
if (mode === 'desktop') {
  assert(!el('overlay').classList.contains('active'), 'run switch closes panel');
  app.setCurrentBookId(999); await desktop.showBattleSimForBook(999);
  key(document.body, 'KeyS', 's'); assert(el('btn').style.display === 'none' && !el('overlay').classList.contains('active'), 'unsupported book cannot reopen');
}
document.body.setAttribute('data-test', JSON.stringify({ mode, width: innerWidth, checks: checks.length, saves: saves.length, encounters: 39, realModules: true, productionWrites: 0 }));
