// Exercise source presets and combat exceptions through both actual lazy loaders.
localStorage.setItem('gamebook_lang','LANGUAGE');
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const seeds=ROSTER_SEEDS,check=(value,label)=>{if(!value)throw Error(label);};
window.fetch=async(url)=>new Response(JSON.stringify(seeds[String(url).match(/\/api\/books\/(\d+)\/enemies$/)?.[1]]??{}),{headers:{'Content-Type':'application/json'}});
console.warn=(message,error)=>{if(error instanceof Error)throw error;};
const run={startedAt:1,path:[1],inventory:[{name:'Kept',qty:2}],equipment:{weapon:'Original'},sim1608:{unchanged:true}};
app.setCurrentBookId(391);app.state.playthroughs=[run];app.state.activePtIndex=0;
if('MODE'==='mobile')await mobile.openSimForBook(391);else await desktop.showBattleSimForBook(391);
const module=await import('REPO/public/js/battlesim/battlesim391.js');
const source=await import('REPO/public/js/battlesim/books/391/definition.js');
const trigger=document.getElementById('sim391-btn');if('MODE'!=='mobile')trigger.click();
const overlay=document.getElementById('sim391-overlay'),left=overlay.querySelector('.bsim-col-left');
const controls=()=>document.getElementById('sim391-controls'),data=()=>run.sim391;
const field=(root,key)=>root.querySelector('[data-field="'+key+'"]');
const button=(root,key)=>root.querySelector('[data-action="'+key+'"]');
const start=()=>button(left,'start').click();
const cancel=()=>{button(left,'cancel').click();document.getElementById('confirm-ok').click();};
const stats=()=>{field(left,'currentVigour').value=100;field(left,'currentPsi').value=10;field(left,'currentAgility').value=10;field(left,'netRollModifier').value=0;field(left,'woundDamage').value=3;};
const dice=(a,b)=>{field(controls(),'die1').value=a;field(controls(),'die2').value=b;};
const roll=(a,b)=>{dice(a,b);button(controls(),'roll').click();};
const savePsi=(a,b)=>{dice(a,b);button(controls(),'psiSave').click();};
const choose=entry=>{
  const input=left.querySelector('[role="combobox"]');input.value='§'+entry.section+')';input.dispatchEvent(new FocusEvent('focus'));input.dispatchEvent(new Event('input',{bubbles:true}));
  const option=[...left.querySelectorAll('[role="option"]')].find(node=>node.textContent.includes('(§'+entry.section+')'));
  check(option,'source encounter searchable '+entry.section);option.dispatchEvent(new PointerEvent('pointerdown',{bubbles:true,cancelable:true}));
};
const select=section=>{choose(source.ENCOUNTERS.find(entry=>entry.section===String(section)));stats();};
const health=values=>[...left.querySelectorAll('[data-stat="hp"]')].forEach((input,i)=>{input.value=values[i];});
const preset=section=>{select(section);if(source.ENCOUNTERS.find(entry=>entry.section===String(section)).requiresCurrentHp)health([...left.querySelectorAll('[data-stat="hp"]')].map(()=>9));start();};
const preserved=JSON.stringify([run.path,run.inventory,run.equipment,run.sim1608]);
check(source.ENCOUNTERS.length===32,'complete source roster');
for(const entry of source.ENCOUNTERS){
  choose(entry);stats();const inputs=[...left.querySelectorAll('[data-stat="hp"]')];
  check(inputs.length===entry.profiles.length,'source group size');
  for(const [i,input]of inputs.entries()){
    check(entry.requiresCurrentHp?input.value==='':Number(input.value)===entry.profiles[i].hp,'printed or explicit current health');
    if(entry.requiresCurrentHp)input.value=3;
  }
  start();check(data().fight.status==='fighting'&&data().fight.opponent.key===entry.key,'source fight starts');
  check(field(left,'currentVigour').disabled&&left.querySelector('[role="combobox"]').disabled,'setup locked');
  check(!overlay.querySelector('.bsim-col-right input,.bsim-col-right button'),'read-only results');
  const active=JSON.stringify(data());module.render();check(JSON.stringify(data())===active,'render preserves fight');
  cancel();check(data().fight.status==='cancelled','cancellation recorded');
}
select(33);field(left,'currentPsi').value=6;start();roll(1,2);
check(data().fight.pendingPsiSave&&data().fight.player.psi===6,'Undine needs additional dice');
const pending=JSON.stringify(data());module.render();check(JSON.stringify(data())===pending,'pending save retained');
savePsi(3,3);check(data().fight.player.psi===6&&data().fight.round===1,'PSI equality succeeds');
roll(1,2);savePsi(6,6);check(data().fight.player.psi===5&&data().fight.round===2,'failed PSI save loses one');cancel();
select(33);field(left,'currentPsi').value=1;start();roll(1,1);savePsi(1,1);check(data().fight.status==='loss','PSI zero is defeat');
preset(84);for(let i=0;i<6;i++)roll(6,6);check(data().fight.status==='win'&&data().fight.round===6,'sequential victory before seven rounds');
preset(84);for(let i=0;i<7;i++)roll(1,1);check(data().fight.status==='paused'&&data().fight.round===7,'seven-round stage pause');
select(283);health([0,3,3]);start();check(field(controls(),'target').value==='1','fallen opponent skipped');
roll(6,6);check(field(controls(),'target').value==='2','next living target only');roll(6,6);check(data().fight.status==='win'&&data().fight.round===2,'continuation retains casualties');
select(96);field(left,'progressiveBonus').checked=true;start();roll(3,3);roll(3,3);roll(6,6);
check(data().fight.unresolved.total===14,'progressive total is not clamped');field(controls(),'printedTotal').value=12;button(controls(),'adjudicate').click();
for(let i=0;i<3;i++)roll(1,1);check(data().fight.status==='paused'&&data().fight.round===6,'automaton sixth round pause');
select(28);health([9,9,9]);field(left,'currentAgility').value=6;start();dice(6,6);button(controls(),'flee').click();
check(data().fight.status==='fled'&&data().fight.player.hp===91,'printed nine-point escape');
select(161);health([3,9,9]);start();roll(6,6);check(data().fight.status==='win'&&data().fight.enemies[1].hp===9,'inn survivors flee after next defeat');
for(const section of [162,259,270]){preset(section);while(data().fight.status==='fighting')roll(6,6);check(data().fight.status==='paused','first defeat is only a stage');}
select(81);field(left,'firstRoundPenalty').checked=true;start();roll(4,4);check(data().fight.events.at(-1).total===6,'first round surprise');roll(4,4);check(data().fight.events.at(-1).total===8,'surprise expires');cancel();
select(122);field(left,'woundDamage').value=4;start();roll(6,6);check(data().fight.enemies[0].hp===8,'enhanced wound replaces ordinary wound');cancel();
preset(298);roll(1,1);check(data().fight.status==='paused'&&data().fight.player.hp===100,'Cobra PSI story test stays in reader');
check(field(left,'gauntlet').closest('label').hidden,'unrelated gauntlet hidden');
button(left,'custom').click();stats();left.querySelector('[role="combobox"]').value='Training foe';health([4]);field(left,'enemyDamage').value=4;start();
const before=JSON.stringify(data());field(controls(),'die1').value=6;button(controls(),'roll').click();
check(JSON.stringify(data())===before,'partial manual dice rejected');document.getElementById('confirm-ok')?.click();roll(6,6);check(data().fight.status==='win','custom fight without preset');
stats();start();const live=JSON.stringify(data());button(left,'cancel').click();app.setCurrentBookId(9999);document.getElementById('confirm-ok').click();
check(JSON.stringify(data())===live,'delayed cancel respects book');app.setCurrentBookId(391);trigger.click();cancel();
const old=JSON.stringify(data());app.state.playthroughs=[{startedAt:2,path:[1]}];app.state.activePtIndex=0;start();
check(app.currentPlaythrough().sim391===undefined,'stale setup respects run');app.state.playthroughs=[run];app.state.activePtIndex=0;trigger.click();
check(JSON.stringify(data())===old,'original run retained');check(JSON.stringify([run.path,run.inventory,run.equipment,run.sim1608])===preserved,'unrelated state preserved');
for(const input of overlay.querySelectorAll('input:not([type="checkbox"])'))check(input.autocomplete==='off','browser autocomplete disabled');
check(!/battlesim391\.[\w.]+/.test(overlay.textContent),'translated labels');
check(overlay.querySelector('.inv-modal').scrollWidth<=overlay.querySelector('.inv-modal').clientWidth+2,'no dialog overflow');
document.body.dataset.test=JSON.stringify({mode:'MODE',language:'LANGUAGE',width:innerWidth,sourceEncounters:32,additionalPsiSave:true,sequentialContinuations:true,printedModifiers:true,groupPauses:true,runAndBookIsolation:true,productionWrites:0});
