const checks = [], saves = [];
const assert = (value, label) => {if (!value) throw Error(label); checks.push(label);};
window.fetch = async (url, options = {}) => {
  assert(url === '/api/books/2116/state' && options.method === 'PUT', 'only intercepted state saves');
  saves.push(JSON.parse(options.body)); return new Response('{}', {status: 200, headers: {'Content-Type': 'application/json'}});
};
const app = await import('REPO/public/js/core/state.js');
const desktop = await import('REPO/public/js/battlesim/loader.js');
const mobile = await import('REPO/public/mobile/js/battlesim-dispatch.js');
const {t} = await import('REPO/public/js/i18n.js');
const {registerTranslations} = await import('REPO/public/js/i18n/runtime.js');
const {loadBattleSimTranslations} = await import('REPO/public/js/i18n/battlesim.js');
const mode = 'MODE', language = 'LANGUAGE', el = key => document.getElementById('sim2116-' + key);
assert(!el('overlay'), 'lazy mount'); assert(mobile.hasSim(2116), 'mobile registry');
await loadBattleSimTranslations(2116);
if (language === 'bg') registerTranslations((await import('REPO/public/js/i18n/bg/battlesim/battlesim2116.js')).default);
app.setCurrentBookId(2116);
const run = {startedAt: 123, path: [1], sim706: {preserved: true}};
app.state.playthroughs = [run]; app.state.activePtIndex = 0;
const open = async () => {if (mode === 'mobile') await mobile.openSimForBook(2116); else {await desktop.showBattleSimForBook(2116); el('btn').click();}};
const change = (key, value) => {el(key).value = value; el(key).dispatchEvent(new Event('change'));};
const key = (target, code, name = code.slice(3)) => target.dispatchEvent(new KeyboardEvent('keydown', {code, key: name, bubbles: true}));
await open(); assert(el('overlay').classList.contains('active'), 'actual lazy loader opens');
assert(!el('overlay').textContent.includes('battlesim2116.'), 'translated UI');
assert(el('title').textContent === t('battlesim2116.title'), 'translated title');
assert(run.sim2116.character === null && Object.keys(run.sim2116.items).length === 0, 'no invented qualities or equipment');
assert(el('resolve').disabled, 'cannot fight without character');
const ids = [...el('overlay').querySelectorAll('[id]')].map(node => node.id);
assert(new Set(ids).size === ids.length, 'unique quality/equipment controls');
for (const [field, value] of Object.entries({intuition: 7, reflex: 4, speed: 4, strength: 4, punch: 5, kick: 5, knife: 5, stick: 6, evilKnowledge: 5})) el(field).value = value;
for (const item of ['pipe', 'knife', 'spray', 'stake', 'holyWater']) el('owned-' + item).checked = true;
el('apply').click(); assert(run.sim2116.character.score === 100, 'manual source setup saved');
el('resolve').click(); el('resolve').click();
assert(run.sim2116.history.length === 1 && run.sim2116.fight.outcome === 'win', 'victory recorded once');
assert(!run.sim2116.items.pipe && !el('owned-pipe').checked, 'lost pipe removed');
assert(el('resolve').disabled && el('encounter').disabled, 'completed result locked until next encounter');
el('again').click(); change('encounter', 'goblins'); change('method', '113'); el('resolve').click();
assert(run.sim2116.history.length === 2 && run.sim2116.character.score === 95, 'printed defeat penalty applied once');
el('again').click(); change('encounter', 'collie'); change('method', '135');
el('owned-pipe').checked = true; el('apply').click(); el('resolve').click();
assert(run.sim2116.fight.outcome === 'escape' && run.sim2116.fight.section === 139, 'complete collie escape');
assert(run.sim2116.history.length === 2 && run.sim2116.character.score === 95, 'escape gives no victory reward');
el('again').click(); change('method', '146'); el('resolve').click();
assert(run.sim2116.character.score === 96 && !run.sim2116.items.holyWater, 'holy water victory and consumption');
assert(run.sim2116.history.length === 3, 'third combat reward');
await app.saveState(); assert(saves.at(-1).playthroughs[0].sim2116.history.length === 3, 'real persistence payload');
const original = JSON.stringify(run);
key(document.activeElement, 'Escape', 'Escape'); assert(!el('overlay').classList.contains('active'), 'Escape closes');
await open(); assert(JSON.stringify(run) === original, 'reopening preserves state');
if (mode === 'desktop') {
  key(document.body, 'KeyS', 's'); assert(!el('overlay').classList.contains('active'), 'shortcut closes');
  key(document.body, 'KeyS', 's'); assert(el('overlay').classList.contains('active'), 'shortcut opens');
  key(el('speed'), 'KeyS', 's'); assert(el('overlay').classList.contains('active'), 'typing is safe');
}
for (const details of el('overlay').querySelectorAll('details')) details.open = true;
for (const node of [el('overlay').querySelector('.bsim-col-left'), el('overlay').querySelector('.bsim-col-right')]) {
  node.scrollTop = Number.MAX_SAFE_INTEGER;
  assert(Math.abs(node.scrollTop - Math.max(0, node.scrollHeight - node.clientHeight)) <= 1, 'bottom reachable');
  node.scrollTop = 0; assert(node.scrollTop === 0, 'top reachable');
}
assert(document.documentElement.scrollWidth <= innerWidth + 1, 'no horizontal overflow');
assert(JSON.stringify(run.sim706) === '{"preserved":true}', 'other simulator preserved');
app.state.playthroughs.push({startedAt: 456, path: [1]}); app.state.activePtIndex = 1;
const module = await import('REPO/public/js/battlesim/battlesim2116.js'); module.render();
assert(!el('overlay').classList.contains('active'), 'run change closes stale panel');
el('apply').click(); assert(!app.currentPlaythrough().sim2116, 'stale controls cannot modify another run');
await open(); assert(app.currentPlaythrough().sim2116.character === null, 'fresh run isolated');
assert(JSON.stringify(run) === original, 'previous run unchanged');
document.body.dataset.test = JSON.stringify({mode, language, width: innerWidth, checks: checks.length, saves: saves.length, realModules: true, productionWrites: 0});
