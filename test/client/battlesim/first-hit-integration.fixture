// Exercise first-hit source and custom encounters through the real lazy loaders.
localStorage.setItem('gamebook_lang','LANGUAGE');
const app=await import('REPO/public/js/core/state.js');
const desktop=await import('REPO/public/js/battlesim/loader.js');
const mobile=await import('REPO/public/mobile/js/battlesim-dispatch.js');
const seeds=ROSTER_SEEDS,check=(value,label)=>{if(!value)throw Error(label);};
window.fetch=async(url)=>new Response(JSON.stringify(seeds[String(url).match(/\/api\/books\/(\d+)\/enemies$/)?.[1]]??{}),{headers:{'Content-Type':'application/json'}});
console.warn=(message,error)=>{if(error instanceof Error)throw error;};
const run={startedAt:1,path:[1],inventory:[{name:'Kept',qty:2}],equipment:{weapon:'Original'},sim1608:{unchanged:true}};
app.setCurrentBookId(1622);app.state.playthroughs=[run];app.state.activePtIndex=0;
if('MODE'==='mobile')await mobile.openSimForBook(1622);else await desktop.showBattleSimForBook(1622);
const module=await import('REPO/public/js/battlesim/battlesim1622.js');
const source=await import('REPO/public/js/battlesim/books/1622/definition.js');
const trigger=document.getElementById('sim1622-btn');if('MODE'!=='mobile')trigger.click();
const overlay=document.getElementById('sim1622-overlay'),left=overlay.querySelector('.bsim-col-left');
const controls=()=>document.getElementById('sim1622-controls'),data=()=>run.sim1622;
const field=(root,key)=>root.querySelector('[data-field="'+key+'"]');
const button=(root,key)=>root.querySelector('[data-action="'+key+'"]');
const start=()=>button(left,'start').click();
const cancel=()=>{button(left,'cancel').click();document.getElementById('confirm-ok').click();};
const roll=(a,b)=>{field(controls(),'die1').value=a;field(controls(),'die2').value=b;button(controls(),'attack').click();};
const choose=profile=>{
  const input=left.querySelector('[role="combobox"]');input.value='';input.dispatchEvent(new FocusEvent('focus'));
  const options=[...left.querySelectorAll('[role="option"]')];check(options.length===8,'all eight source opponents');
  const option=options.find(node=>node.textContent.includes(profile.name));check(option,'source opponent offered');
  option.dispatchEvent(new PointerEvent('pointerdown',{bubbles:true,cancelable:true}));
};
const preserved=JSON.stringify([run.path,run.inventory,run.equipment,run.sim1608]);
for(const [i,profile]of source.OPPONENTS.entries()){
  choose(profile);field(left,'playerSkill').value=8;check(Number(left.querySelector('[data-stat="skill"]').value)===profile.skill,'printed SKILL');start();
  check(data().fight.phase==='player'&&data().fight.player.skill===8&&data().fight.opponent.skill===profile.skill,'source fight starts player first');
  check(field(left,'playerSkill').disabled&&left.querySelector('[role="combobox"]').disabled,'active setup locked');
  check(!overlay.querySelector('.bsim-col-right input'),'results have no setup');
  const active=JSON.stringify(data());module.render();check(JSON.stringify(data())===active,'render preserves active fight');
  field(controls(),'die1').value=6;field(controls(),'die2').value=6;const stale=button(controls(),'attack');stale.click();
  check(data().fight.status==='win'&&data().history.length===i+1,'source victory saved once');
  const won=JSON.stringify(data());stale.click();module.render();check(JSON.stringify(data())===won,'stale action cannot duplicate outcome');
}
choose(source.OPPONENTS[0]);start();roll(1,1);check(data().fight.phase==='enemy','player miss gives enemy turn');roll(3,5);
check(data().fight.status==='loss'&&data().fight.player.skill===8,'equal enemy roll hits without applying story wound');
const custom=()=>{left.querySelector('[role="combobox"]').value='Training foe';left.querySelector('[data-stat="skill"]').value=12;field(left,'playerSkill').value=10;};
custom();start();check(data().fight.opponent.name==='Training foe'&&data().fight.opponent.skill===12,'custom stats need no preset');
roll(1,1);roll(1,1);check(data().fight.round===2&&data().fight.phase==='player','both misses advance round');roll(6,6);
check(data().fight.status==='win'&&data().fight.events.at(-1).threshold===12,'custom threshold equality wins');
custom();start();const live=JSON.stringify(data());button(left,'cancel').click();app.setCurrentBookId(9999);document.getElementById('confirm-ok').click();
check(JSON.stringify(data())===live,'delayed cancel respects book');app.setCurrentBookId(1622);trigger.click();cancel();
check(data().fight.status==='cancelled'&&data().history.at(-1).outcome==='cancelled','cancel is not a victory');
const old=JSON.stringify(data());app.state.playthroughs=[{startedAt:2,path:[1]}];app.state.activePtIndex=0;start();
check(app.currentPlaythrough().sim1622===undefined,'stale setup respects run');app.state.playthroughs=[run];app.state.activePtIndex=0;trigger.click();
check(JSON.stringify(data())===old,'original run retained');check(JSON.stringify([run.path,run.inventory,run.equipment,run.sim1608])===preserved,'story and unrelated simulator untouched');
check(!JSON.stringify(data()).includes('"hp"'),'no invented HP');
for(const input of overlay.querySelectorAll('input'))check(input.autocomplete==='off','browser autocomplete disabled');
for(const key of overlay.textContent.match(/battlesim1622\.[\w.]+/g)??[])throw Error('Missing translation '+key);
check(overlay.querySelector('.inv-modal').scrollWidth<=overlay.querySelector('.inv-modal').clientWidth+2,'no dialog overflow');
document.body.dataset.test=JSON.stringify({mode:'MODE',language:'LANGUAGE',width:innerWidth,sourceOpponentProfiles:8,allSourceStats:true,
  alternatingFirstHitCombat:true,customCombat:true,runAndBookIsolation:true,historyOnce:true,noInventedHp:true,productionWrites:0});
